#!/usr/bin/env bash
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

if pgrep -x waybar >/dev/null 2>&1; then
  pkill -x waybar >/dev/null 2>&1 || true
  ahr_notify "Waybar" "Waybar hidden"
  exit 0
fi

if ahr_has_cmd waybar; then
  setsid waybar >/dev/null 2>&1 &
  ahr_notify "Waybar" "Waybar shown"
  exit 0
fi

if ! ahr_require waybar waybar; then
  ahr_notify "artix-hypr-remix" "waybar is not installed — install with: sudo pacman -S waybar"
  exit 1
fi
