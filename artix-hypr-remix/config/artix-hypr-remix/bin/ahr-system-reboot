#!/usr/bin/env bash
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

if ahr_has_cmd reboot; then
  exec reboot
fi

if ahr_has_cmd shutdown; then
  exec shutdown -r now
fi

if ahr_has_cmd openrc-shutdown; then
  exec openrc-shutdown -r now
fi

echo "No reboot command found." >&2
echo "Ensure util-linux (reboot) or openrc-shutdown is installed." >&2
ahr_notify "artix-hypr-remix" "No reboot command found — install util-linux"
exit 1
