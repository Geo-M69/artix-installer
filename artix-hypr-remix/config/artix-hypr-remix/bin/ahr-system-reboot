#!/usr/bin/env bash
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

if ahr_has_cmd reboot; then
  exec reboot
fi

if ahr_has_cmd shutdown; then
  exec shutdown -r now
fi

if ahr_has_cmd openrc-shutdown; then
  exec openrc-shutdown -r now
fi

ahr_fail "No reboot command found"
