#!/usr/bin/env bash
# Toggle notification silencing (do-not-disturb mode).
# Uses the shared toggle framework for state management.
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"
source "${AHR_TOGGLE_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-toggle-lib.sh}"

is_silenced=false
if ahr_toggle_enabled "notification-silencing"; then
  is_silenced=true
elif ahr_has_cmd makoctl; then
  if makoctl mode 2>/dev/null | grep -q 'do-not-disturb'; then
    is_silenced=true
  fi
fi

if [[ "$is_silenced" == "true" ]]; then
  ahr_toggle_unset "notification-silencing"
  if ahr_has_cmd makoctl; then
    makoctl mode -r do-not-disturb >/dev/null 2>&1 || true
  fi
  ahr_notify "Notifications" "Notifications enabled"
else
  ahr_toggle_set "notification-silencing"
  if ahr_has_cmd makoctl; then
    makoctl mode -a do-not-disturb >/dev/null 2>&1 || true
    makoctl dismiss --all >/dev/null 2>&1 || true
  fi
  ahr_notify "Notifications" "Notifications silenced"
fi

pkill -RTMIN+10 -x waybar >/dev/null 2>&1 || true
