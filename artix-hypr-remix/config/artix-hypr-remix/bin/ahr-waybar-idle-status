#!/usr/bin/env bash
# Report idle lock state for the Waybar indicator.
# Uses the shared toggle framework.
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"
source "${AHR_TOGGLE_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-toggle-lib.sh}"

idle_off_flag="$AHR_TOGGLE_STATE_DIR/idle-off"

if pgrep -x hypridle >/dev/null 2>&1; then
  printf '{"text":"\uf0f2","class":"active","tooltip":"Idle lock enabled"}\n'
elif [[ -f "$idle_off_flag" ]]; then
  # User explicitly disabled idle — show disabled state
  printf '{"text":"\uf0f3","class":"inactive","tooltip":"Idle lock disabled"}\n'
elif ahr_toggle_enabled "idle"; then
  # Toggle framework says enabled but hypridle is not running — stale state.
  printf '{"text":"󰒳","class":"warning","tooltip":"Idle lock requested but hypridle is not running"}\n'
else
  printf '{"text":"󰒳","class":"inactive","tooltip":"Idle lock disabled"}\n'
fi
