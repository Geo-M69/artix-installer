#!/usr/bin/env bash
set -euo pipefail

# ahr-update-available — Report available updates.
#
# Uses the shared ahr-version.sh library for version comparison.
# No lexicographic fallback. No bash arithmetic on untrusted text.

FRAMEWORK_ROOT="${AHR_FRAMEWORK_ROOT:-$HOME/.config/artix-hypr-remix}"
SCRIPT_DIR="$FRAMEWORK_ROOT/bin"
LIB_PATH="${AHR_LIB_PATH:-$SCRIPT_DIR/ahr-lib.sh}"
source "$LIB_PATH"
# Resolve from the canonical framework root so commands invoked through
# ~/.local/bin symlinks never source libraries from the namespace directory.
# shellcheck source=ahr-version.sh
source "${AHR_VERSION_LIB_PATH:-$(dirname "$LIB_PATH")/ahr-version.sh}"
source "${AHR_CACHE_LIB_PATH:-$(dirname "$LIB_PATH")/ahr-cache.sh}"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/artix-hypr-remix"
CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/artix-hypr-remix"
FRAMEWORK_CACHE="$CACHE_ROOT/framework-remote.cache"
FRAMEWORK_CACHE_TTL=900
MIGRATION_DIR="$FRAMEWORK_ROOT/migrations"
MIGRATION_STATE_DIR="$STATE_ROOT/migrations"
MIGRATION_SKIPPED_DIR="$MIGRATION_STATE_DIR/skipped"

json=false
while (( $# > 0 )); do
  case "$1" in
    --json) json=true ;;
    -h|--help)
      cat <<'EOF'
Usage: ahr-update-available [--json]

Checks system package, AUR, Flatpak, theme, pending migration, skipped
migration, and framework update work.

Categories:
  system            System (pacman) package updates
  aur               AUR helper package updates
  flatpak           Flatpak application updates
  theme             Theme updates (unsupported in Phase 1)
  migrations        Pending framework migrations
  skipped_migrations Migrations skipped on previous run
  framework         Framework version update state

Exit status:
  0  Pending work exists
  1  Nothing pending
  2  Invalid arguments
EOF
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

system_count=0
aur_count=0
flatpak_count=0
flatpak_state="unavailable"
theme_state="unsupported"
migration_pending_count=0
migration_skipped_count=0

# system updates
if ahr_has_cmd checkupdates; then
  system_count=$(checkupdates 2>/dev/null | wc -l || true)
elif ahr_has_cmd pacman; then
  system_count=$(pacman -Qu 2>/dev/null | wc -l || true)
fi

# AUR updates
if ahr_has_cmd paru; then
  aur_count=$(paru -Qua 2>/dev/null | wc -l || true)
elif ahr_has_cmd yay; then
  aur_count=$(yay -Qua 2>/dev/null | wc -l || true)
fi

# flatpak updates
if ahr_has_cmd flatpak; then
  flatpak_state="current"
  flatpak_count=$(flatpak remote-ls --updates 2>/dev/null | wc -l || true)
fi

# pending or skipped migrations
if [[ -d "$MIGRATION_DIR" ]]; then
  shopt -s nullglob
  while IFS= read -r -d '' migration_file; do
    migration_name="$(basename "$migration_file")"
    if [[ -f "$MIGRATION_STATE_DIR/$migration_name" ]]; then
      continue
    fi
    if [[ -f "$MIGRATION_SKIPPED_DIR/$migration_name" ]]; then
      ((migration_skipped_count+=1))
      continue
    fi
    ((migration_pending_count+=1))
  done < <(find "$MIGRATION_DIR" -maxdepth 1 -type f -name '*.sh' -print0 2>/dev/null || true)
  shopt -u nullglob
fi

# framework state
FRAMEWORK_JSON="$FRAMEWORK_ROOT/framework.json"

framework_state="disabled"
framework_local_version=""
framework_remote_version=""

if command -v jq >/dev/null 2>&1; then
  framework_local_version="$(jq -r '.version // ""' "$FRAMEWORK_JSON" 2>/dev/null || true)"
  update_source="$(jq -r '.update_source // ""' "$FRAMEWORK_JSON" 2>/dev/null || true)"
  framework_channel="$(jq -r '.channel // ""' "$FRAMEWORK_JSON" 2>/dev/null || true)"
else
  framework_local_version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FRAMEWORK_JSON" 2>/dev/null | head -n1)"
  update_source="$(sed -n 's/.*"update_source"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FRAMEWORK_JSON" 2>/dev/null | head -n1)"
  framework_channel="$(sed -n 's/.*"channel"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FRAMEWORK_JSON" 2>/dev/null | head -n1)"
fi

check_framework_availability() {
  local update_source="$1"
  local framework_channel="$2"

  if ! ahr_has_cmd git; then
    framework_state="unavailable"
    return 0
  fi

  framework_state="unavailable"

  # Use cache if available and valid
  if validate_cache_consistency "$FRAMEWORK_CACHE" "$update_source" "$framework_channel" "$FRAMEWORK_CACHE_TTL" 2>/dev/null; then
    local cache_record
    cache_record="$(read_cache_record "$FRAMEWORK_CACHE" 2>/dev/null)" || true
    if [[ -n "$cache_record" ]]; then
      local cache_ver
      cache_ver="$(printf '%s' "$cache_record" | cut -f1)"
      framework_remote_version="$cache_ver"
      framework_state="current"
      return 0
    fi
  fi

  # No fresh cache — do a lightweight remote fetch
  export GIT_TERMINAL_PROMPT=0
  local git_timeout=15
  command -v timeout >/dev/null 2>&1 || git_timeout=0

  local tmpdir="" clone_exit=0 remote_commit="" remote_raw=""
  tmpdir="$(mktemp -d "/tmp/ahr-update-check-XXXXXXXX" 2>/dev/null || true)"
  if [[ -n "$tmpdir" ]]; then
    if (( git_timeout > 0 )); then
      timeout "$git_timeout" git clone --depth 1 --filter=blob:none --no-checkout --quiet "$update_source" "$tmpdir" 2>/dev/null || clone_exit=$?
    else
      git clone --depth 1 --filter=blob:none --no-checkout --quiet "$update_source" "$tmpdir" 2>/dev/null || clone_exit=$?
    fi

    if (( clone_exit == 0 )); then
      remote_commit="$(git -C "$tmpdir" rev-parse HEAD 2>/dev/null || true)"
      remote_raw="$(git -C "$tmpdir" cat-file -p HEAD:artix-hypr-remix/config/artix-hypr-remix/framework.json 2>/dev/null || true)"
    elif (( clone_exit != 124 )); then
      rm -rf "$tmpdir"
      tmpdir="$(mktemp -d "/tmp/ahr-update-check-XXXXXXXX" 2>/dev/null || true)"
      clone_exit=0
      if [[ -n "$tmpdir" ]]; then
        if (( git_timeout > 0 )); then
          timeout "$git_timeout" git clone --depth 1 --quiet "$update_source" "$tmpdir" 2>/dev/null || clone_exit=$?
        else
          git clone --depth 1 --quiet "$update_source" "$tmpdir" 2>/dev/null || clone_exit=$?
        fi
        if (( clone_exit == 0 )) && [[ -f "$tmpdir/artix-hypr-remix/config/artix-hypr-remix/framework.json" ]]; then
          remote_commit="$(git -C "$tmpdir" rev-parse HEAD 2>/dev/null || true)"
          remote_raw="$(cat "$tmpdir/artix-hypr-remix/config/artix-hypr-remix/framework.json")"
        fi
      fi
    fi
    rm -rf "$tmpdir"
  fi

  if [[ -n "${remote_raw:-}" ]]; then
    if command -v jq >/dev/null 2>&1; then
      framework_remote_version="$(printf '%s' "$remote_raw" | jq -r '.version // ""' 2>/dev/null || true)"
    else
      framework_remote_version="$(printf '%s' "$remote_raw" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
    fi

    if [[ -n "$framework_remote_version" && "$remote_commit" =~ ^[0-9a-fA-F]{40,64}$ ]]; then
      write_cache_record "$FRAMEWORK_CACHE" "$framework_remote_version" "$update_source" "$framework_channel" "$remote_commit"
      framework_state="current"
    fi
  fi
}

if [[ -n "$update_source" ]]; then
  check_framework_availability "$update_source" "$framework_channel"

  # Compare versions using the shared library (no vercmp fallback, no arithmetic)
  if [[ -n "$framework_local_version" && -n "$framework_remote_version" ]]; then
    vc="$(ahr_version_compare "$framework_remote_version" "$framework_local_version" 2>/dev/null || echo '')"
    case "$vc" in
      1) framework_state="pending" ;;
      0) framework_state="current" ;;
      -1) framework_state="current" ;;
      *) framework_state="unavailable" ;;
    esac
  elif [[ -z "$framework_local_version" && -n "$framework_remote_version" ]]; then
    framework_state="unavailable"
  fi
fi

# Compute totals
total=$((system_count + aur_count + flatpak_count + migration_pending_count + migration_skipped_count))
framework_pending=false
if [[ "$framework_state" == "pending" ]]; then
  framework_pending=true
  ((total+=1))
fi

# Safe JSON escaping without jq
json_escape_string() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  s="$(printf '%s' "$s" | tr -d '\001-\037' 2>/dev/null || printf '%s' "$s")"
  printf '%s' "$s"
}

if [[ "$json" == "true" ]]; then
  pending=false
  (( total > 0 )) && pending=true

  if command -v jq >/dev/null 2>&1; then
    jq -n \
      --argjson system "$system_count" \
      --argjson aur "$aur_count" \
      --argjson flatpak "$flatpak_count" \
      --arg theme "$theme_state" \
      --arg flatpak_state "$flatpak_state" \
      --argjson migrations "$migration_pending_count" \
      --argjson skipped "$migration_skipped_count" \
      --arg framework "$framework_state" \
      --arg framework_remote "$framework_remote_version" \
      --argjson total "$total" \
      --argjson pending "$pending" \
      '{system: $system, aur: $aur, flatpak: $flatpak, flatpak_state: $flatpak_state, theme: $theme, migrations: $migrations, skipped_migrations: $skipped, framework: $framework, framework_remote: $framework_remote, total: $total, pending: $pending}'
  else
    esc_theme="$(json_escape_string "$theme_state")"
    esc_flatpak_state="$(json_escape_string "$flatpak_state")"
    esc_framework="$(json_escape_string "$framework_state")"
    esc_framework_remote="$(json_escape_string "$framework_remote_version")"
    printf '{"system":%s,"aur":%s,"flatpak":%s,"flatpak_state":"%s","theme":"%s","migrations":%s,"skipped_migrations":%s,"framework":"%s","framework_remote":"%s","total":%s,"pending":%s}\n' \
      "$system_count" "$aur_count" "$flatpak_count" "$esc_flatpak_state" "$esc_theme" \
      "$migration_pending_count" "$migration_skipped_count" \
      "$esc_framework" "$esc_framework_remote" \
      "$total" "$pending"
  fi
else
  if (( total > 0 )); then
    echo "Updates pending: $total total"
    [[ "$system_count" -gt 0 ]] && echo "  system packages: $system_count"
    [[ "$aur_count" -gt 0 ]] && echo "  AUR packages: $aur_count"
    [[ "$flatpak_state" == "current" && "$flatpak_count" -gt 0 ]] && echo "  Flatpak apps: $flatpak_count"
    [[ "$migration_pending_count" -gt 0 ]] && echo "  pending migrations: $migration_pending_count"
    [[ "$migration_skipped_count" -gt 0 ]] && echo "  skipped migrations: $migration_skipped_count"
    if [[ "$framework_state" == "pending" ]]; then
      echo "  framework update: $framework_local_version → $framework_remote_version available"
    elif [[ "$framework_state" == "unavailable" ]]; then
      echo "  framework version: check failed"
    fi
  else
    echo "No updates pending."
  fi
fi

if (( total > 0 )); then
  exit 0
else
  exit 1
fi
