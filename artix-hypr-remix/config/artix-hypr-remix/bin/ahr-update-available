#!/usr/bin/env bash
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

FRAMEWORK_ROOT="$HOME/.config/artix-hypr-remix"
MIGRATION_DIR="$FRAMEWORK_ROOT/migrations"
MIGRATION_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/artix-hypr-remix/migrations"
MIGRATION_SKIPPED_DIR="$MIGRATION_STATE_DIR/skipped"

json=false
while (( $# > 0 )); do
  case "$1" in
    --json) json=true ;;
    -h|--help)
      cat <<'EOF'
Usage: ahr-update-available [--json]

Checks repo package, AUR package, pending migration, and skipped migration work.

Exit status:
  0  Pending work exists
  1  Nothing pending
  2  Invalid arguments
EOF
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

system_count=0
aur_count=0
migration_pending_count=0
migration_skipped_count=0

# system updates
if ahr_has_cmd checkupdates; then
  system_count=$(checkupdates 2>/dev/null | wc -l || true)
elif ahr_has_cmd pacman; then
  system_count=$(pacman -Qu 2>/dev/null | wc -l || true)
fi

# AUR updates
if ahr_has_cmd paru; then
  aur_count=$(paru -Qua 2>/dev/null | wc -l || true)
elif ahr_has_cmd yay; then
  aur_count=$(yay -Qua 2>/dev/null | wc -l || true)
fi

# pending or skipped migrations
if [[ -d "$MIGRATION_DIR" ]]; then
  shopt -s nullglob
  for migration_file in "$MIGRATION_DIR"/*.sh; do
    migration_name="$(basename "$migration_file")"
    if [[ -f "$MIGRATION_STATE_DIR/$migration_name" ]]; then
      continue
    fi
    if [[ -f "$MIGRATION_SKIPPED_DIR/$migration_name" ]]; then
      ((migration_skipped_count+=1))
      continue
    fi
    ((migration_pending_count+=1))
  done
  shopt -u nullglob
fi

total=$((system_count + aur_count + migration_pending_count + migration_skipped_count))

if [[ "$json" == "true" ]]; then
  pending=false
  if (( total > 0 )); then
    pending=true
  fi
  printf '{"system": %s, "aur": %s, "migrations": %s, "skipped_migrations": %s, "total": %s, "pending": %s}\n' "$system_count" "$aur_count" "$migration_pending_count" "$migration_skipped_count" "$total" "$pending"
else
  if (( total > 0 )); then
    printf 'Updates pending: %s total\n' "$total"
    printf '  system packages: %s\n' "$system_count"
    printf '  AUR packages: %s\n' "$aur_count"
    printf '  pending migrations: %s\n' "$migration_pending_count"
    printf '  skipped migrations: %s\n' "$migration_skipped_count"
    printf '\nRun `ahr update` for normal updates, or `ahr update --flatpak` to include Flatpak apps.\n'
    if (( migration_skipped_count > 0 )); then
      printf 'Skipped migrations need review. Use `ahr migrate --status` and `ahr migrate --retry-skipped`.\n'
    fi
  else
    printf 'No updates pending.\n'
    printf 'Checked repo packages, AUR packages, pending migrations, and skipped migrations.\n'
  fi
fi

if (( total > 0 )); then
  exit 0
else
  exit 1
fi
