#!/usr/bin/env bash
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

if ahr_has_cmd pavucontrol; then
  exec pavucontrol
fi

if ahr_has_cmd pwvucontrol; then
  exec pwvucontrol
fi

if ahr_has_cmd alsamixer; then
  if ahr_exec_terminal_app alsamixer; then
    exit 0
  fi
fi

echo "No audio control app found." >&2
echo "Install one of: pavucontrol, pwvucontrol, alsamixer (alsa-utils)" >&2
ahr_notify "artix-hypr-remix" "No audio control app found — install pavucontrol, pwvucontrol, or alsa-utils"
exit 1
