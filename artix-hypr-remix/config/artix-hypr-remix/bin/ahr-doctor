#!/usr/bin/env bash
set -euo pipefail

# ahr-doctor — lightweight health checks for the installed framework.
# This is a post-install-safe subset of scripts/doctor.sh.  For the full
# suite (hardware checks, quality-gate integration, etc.) run the repo
# script from a cloned artix-installer checkout:
#   git clone https://github.com/Geo-M69/artix-installer && ./scripts/doctor.sh --no-aur

overall_status=0
FRAMEWORK_ROOT="${AHR_FRAMEWORK_ROOT:-$HOME/.config/artix-hypr-remix}"
AHR_INITD_DIR="${AHR_INITD_DIR:-/etc/init.d}"
AHR_RUNLEVELS_DIR="${AHR_RUNLEVELS_DIR:-/etc/runlevels}"
AHR_RC_SERVICE_CMD="${AHR_RC_SERVICE_CMD:-rc-service}"
AHR_IP_CMD="${AHR_IP_CMD:-ip}"

# Shared default-app/MIME matrix (single source of truth for setup + validation).
MATRIX_LIB="$(dirname "${BASH_SOURCE[0]}")/ahr-default-apps-matrix.sh"
if [[ -f "$MATRIX_LIB" ]]; then
  # shellcheck source=/dev/null
  source "$MATRIX_LIB"
fi

doctor_warn() { printf '  WARN: %s\n' "$*"; }
doctor_fail() { printf '  FAIL: %s\n' "$*"; overall_status=1; }
doctor_pass() { printf '  OK: %s\n' "$*"; }

usage() {
  cat <<'EOF'
Usage: ahr doctor [options]

Options:
  -h, --help Show this help

Checks: required commands, desktop runtime, OpenRC services, capture tools,
menu backends, MIME defaults, theme state, framework command deployment.
EOF
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n\n' "$1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

# Severity levels for command checks:
#   check_required    — hard failure if missing (exit code 1)
#   check_optional    — warning only, never fails
# All three show a package install hint when a package name is provided.

check_required() {
  local label="$1" cmd="$2" pkg="${3:-}"
  if command -v "$cmd" >/dev/null 2>&1; then
    printf '  OK: %s\n' "$label"
  else
    if [[ -n "$pkg" ]]; then
      printf '  MISSING: %s — install with: sudo pacman -S %s\n' "$label" "$pkg"
    else
      printf '  MISSING: %s\n' "$label"
    fi
    overall_status=1
  fi
}

check_optional() {
  local label="$1" cmd="$2" pkg="${3:-}"
  if command -v "$cmd" >/dev/null 2>&1; then
    printf '  OK: %s\n' "$label"
  else
    if [[ -n "$pkg" ]]; then
      printf '  WARN: %s — install with: sudo pacman -S %s\n' "$label" "$pkg"
    else
      printf '  WARN: %s\n' "$label"
    fi
  fi
}

check_desktop_cmd() {
  local label="$1" cmd="$2" fallback_path="${3:-}"
  if command -v "$cmd" >/dev/null 2>&1; then
    printf '  OK: %s\n' "$label"
  elif [[ -n "$fallback_path" && -x "$fallback_path" ]]; then
    printf '  OK: %s (via %s)\n' "$label" "$fallback_path"
  else
    printf '  MISSING: %s\n' "$label"
    overall_status=1
  fi
}

mime_check() {
  local label="$1" mime_type="$2" preference="${3:-false}"
  if ! command -v xdg-mime >/dev/null 2>&1; then
    return
  fi
  local current desktop_file="" app_dir
  current="$(xdg-mime query default "$mime_type" 2>/dev/null || true)"
  if [[ -n "$current" ]]; then
    for app_dir in /usr/share/applications "$HOME/.local/share/applications" \
      "$HOME/.local/share/flatpak/exports/share/applications" \
      /var/lib/flatpak/exports/share/applications; do
      if [[ -f "$app_dir/$current" ]]; then
        desktop_file="$app_dir/$current"
        break
      fi
    done
    if [[ -n "$desktop_file" ]]; then
      doctor_pass "$label → $current"
    elif [[ "$preference" == "true" ]]; then
      doctor_warn "$label → $current (desktop entry not found)"
    else
      doctor_fail "$label → $current (desktop entry not found)"
    fi
  else
    doctor_warn "$label — no default handler set"
  fi
}

service_check() {
  local service="$1" required="${2:-true}"
  if [[ ! -x "$AHR_INITD_DIR/$service" ]]; then
    if [[ "$required" == "true" ]]; then
      doctor_fail "service script $AHR_INITD_DIR/$service missing"
    else
      doctor_warn "optional service not installed: $service"
    fi
    return
  fi

  local enabled=false
  local running=false
  [[ -e "$AHR_RUNLEVELS_DIR/default/$service" ]] && enabled=true
  "$AHR_RC_SERVICE_CMD" "$service" status >/dev/null 2>&1 && running=true

  if [[ "$required" == "true" ]]; then
    if ! $enabled; then
      doctor_fail "$service not in default runlevel"
      return
    fi
    if ! $running; then
      doctor_fail "$service installed but not running"
      return
    fi
    doctor_pass "$service (default runlevel, running)"
  else
    printf '  OK: /etc/init.d/%s' "$service"
    $enabled && printf ' (default runlevel)'
    $running && printf ' (running)' || printf ' (not running)'
    printf '\n'
  fi
}

network_stack_check() {
  if ! command -v "$AHR_RC_SERVICE_CMD" >/dev/null 2>&1; then
    doctor_fail "supported network stack cannot be checked: $AHR_RC_SERVICE_CMD unavailable"
    return
  fi
  if ! command -v "$AHR_IP_CMD" >/dev/null 2>&1; then
    doctor_fail "supported network stack cannot be checked: $AHR_IP_CMD unavailable"
    return
  fi

  local -a supported=(NetworkManager connmand)
  local -a active=() inactive_enabled=()
  local service
  for service in "${supported[@]}"; do
    [[ -x "$AHR_INITD_DIR/$service" ]] || continue
    if "$AHR_RC_SERVICE_CMD" "$service" status >/dev/null 2>&1; then
      active+=("$service")
    elif [[ -e "$AHR_RUNLEVELS_DIR/default/$service" || -e "$AHR_RUNLEVELS_DIR/sysinit/$service" ]]; then
      inactive_enabled+=("$service")
    fi
  done

  if (( ${#active[@]} == 0 )); then
    doctor_fail "no supported network manager is active (NetworkManager or connmand)"
    return
  fi
  if (( ${#active[@]} > 1 )); then
    doctor_warn "multiple supported network managers are active: ${active[*]}"
  else
    doctor_pass "supported network manager active: ${active[0]}"
  fi
  if (( ${#inactive_enabled[@]} > 0 )); then
    doctor_warn "inactive supported manager enabled in an OpenRC runlevel: ${inactive_enabled[*]} (choose one intended manager)"
  fi

  if ! "$AHR_IP_CMD" -o addr show up 2>/dev/null | awk '$2 != "lo" && ($3 == "inet" || $3 == "inet6") { found=1 } END { exit !found }'; then
    doctor_fail "supported network manager is active but no non-loopback address is configured"
    return
  fi
  doctor_pass "non-loopback network address configured"
  if "$AHR_IP_CMD" route show default 2>/dev/null | grep -q .; then
    doctor_pass "default route configured"
  else
    doctor_warn "no default route reported (local networking may still be intentional)"
  fi
}

framework_cmd_check() {
  local name="$1" path
  path="$FRAMEWORK_ROOT/bin/$name"
  if [[ ! -e "$path" || ! -r "$path" || ! -x "$path" ]]; then
    printf '  MISSING: %s (not readable and executable)\n' "$name"
    overall_status=1
  else
    printf '  OK: %s\n' "$name"
  fi
}

framework_library_check() {
  local name="$1" path
  path="$FRAMEWORK_ROOT/bin/$name"
  if [[ ! -e "$path" || ! -r "$path" ]] || ! bash -n "$path" 2>/dev/null; then
    printf '  MISSING: %s (not readable library)\n' "$name"
    overall_status=1
  else
    printf '  OK: %s (library)\n' "$name"
  fi
}

theme_check() {
  local state_dir="$FRAMEWORK_ROOT/current"
  local name_file="$state_dir/theme.name"
  local current_theme="$state_dir/theme"
  local theme_name="" source_theme="" resolved=""

  if [[ ! -f "$name_file" || ! -r "$name_file" ]]; then
    doctor_fail "current theme name missing or unreadable: $name_file"
    return
  fi
  theme_name="$(<"$name_file")"
  if [[ ! "$theme_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    doctor_fail "current theme name is empty or invalid: $name_file"
    return
  fi
  for source_theme in "$FRAMEWORK_ROOT/themes/$theme_name" "$FRAMEWORK_ROOT/default/themes/$theme_name"; do
    [[ -d "$source_theme" ]] && break
  done
  if [[ ! -d "$source_theme" ]]; then
    doctor_fail "named source theme is missing: $theme_name"
    return
  fi

  if [[ -L "$current_theme" ]]; then
    resolved="$(readlink -f "$current_theme" 2>/dev/null || true)"
    case "$resolved" in
      "$FRAMEWORK_ROOT/themes/"*|"$FRAMEWORK_ROOT/default/themes/"*) ;;
      *) doctor_fail "legacy current theme symlink escapes allowed theme roots: $current_theme"; return ;;
    esac
    [[ -d "$resolved" ]] || { doctor_fail "legacy current theme symlink target is missing: $current_theme"; return; }
    if [[ "$resolved" != "$source_theme" ]]; then
      doctor_fail "legacy current theme target does not match theme.name ($theme_name)"
      return
    fi
    doctor_pass "current theme legacy symlink → $resolved"
  elif [[ -d "$current_theme" ]]; then
    local required_asset
    for required_asset in colors.toml icons.theme; do
      if [[ ! -f "$current_theme/$required_asset" || ! -f "$source_theme/$required_asset" ]]; then
        doctor_fail "current theme directory is missing required $required_asset"
        return
      fi
      if ! cmp -s "$current_theme/$required_asset" "$source_theme/$required_asset"; then
        doctor_fail "current theme directory does not match theme.name ($theme_name)"
        return
      fi
    done
    doctor_pass "current theme directory matches $theme_name"
  else
    doctor_fail "current theme path missing or unsupported: $current_theme"
    return
  fi

  local background="$state_dir/background"
  if [[ -L "$background" ]]; then
    resolved="$(readlink -f "$background" 2>/dev/null || true)"
    case "$resolved" in
      "$FRAMEWORK_ROOT/"*) [[ -f "$resolved" ]] || { doctor_fail "current background target is missing: $background"; return; } ;;
      *) doctor_fail "current background symlink escapes framework root: $background"; return ;;
    esac
  elif [[ -f "$background" ]]; then
    doctor_pass "current background file exists"
    return
  else
    doctor_fail "current background state missing: $background"
  fi
  doctor_pass "current background symlink is valid"
}

# ── Environment ────────────────────────────────────────────────
printf '\n=== Required Commands ===\n'
check_required pacman pacman
check_required grim grim grim
check_required hyprctl hyprctl hyprland
check_required rc-update rc-update openrc
check_required rc-service rc-service openrc

printf '\n=== Desktop Runtime ===\n'
check_desktop_cmd polkit-gnome-authentication-agent-1 \
  polkit-gnome-authentication-agent-1 \
  /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
check_desktop_cmd xdg-desktop-portal xdg-desktop-portal \
  /usr/lib/xdg-desktop-portal
check_desktop_cmd xdg-desktop-portal-hyprland xdg-desktop-portal-hyprland \
  /usr/lib/xdg-desktop-portal-hyprland

printf '\n=== Capture Tools ===\n'
check_required grim grim grim
if command -v grim >/dev/null 2>&1; then
  check_optional slurp slurp slurp
  check_optional jq jq jq
fi
check_optional gpu-screen-recorder gpu-screen-recorder gpu-screen-recorder
check_required 'wl-clipboard' wl-paste wl-clipboard
check_required cliphist cliphist cliphist

printf '\n=== Menu Backend ===\n'
if command -v wofi >/dev/null 2>&1; then
  printf '  OK: wofi\n'
elif command -v walker >/dev/null 2>&1; then
  printf '  OK: walker\n'
elif command -v rofi >/dev/null 2>&1; then
  printf '  OK: rofi\n'
else
  printf '  MISSING: no menu backend (wofi/walker/rofi)\n'
  overall_status=1
fi

printf '\n=== Default Application Extras ===\n'
# Calculator is a core native app; report presence without failing the doctor
# if it is momentarily absent during an update.
if command -v gnome-calculator >/dev/null 2>&1 \
   || ahr_matrix_desktop_entry_exists org.gnome.Calculator.desktop \
   || ahr_matrix_desktop_entry_exists gnome-calculator.desktop; then
  printf '  OK: default calculator (gnome-calculator) available\n'
else
  printf '  WARN: default calculator (gnome-calculator) not found\n'
fi

printf '\n=== Advertised Capture Actions ===\n'
# Color Picker is an advertised Capture action. hyprpicker is installed by
# default; if it is missing, report clearly but do not fail the doctor (it is
# a single optional capture utility, not required for session health).
check_optional 'Color Picker (hyprpicker)' hyprpicker hyprpicker
# SwayOSD is intentionally optional; its absence must not affect health.
if command -v swayosd-server >/dev/null 2>&1; then
  printf '  OK: SwayOSD available (optional OSD polish)\n'
else
  printf '  WARN: SwayOSD not installed (optional; volume/brightness/media controls do not depend on it)\n'
fi

printf '\n=== OpenRC Services ===\n'
service_check dbus true
service_check elogind true
network_stack_check
service_check bluetoothd true
check_optional docker docker docker
service_check cupsd false
service_check avahi-daemon false

printf '\n=== MIME Defaults ===\n'
for tool in xdg-settings xdg-mime xdg-open; do
  check_required "$tool" "$tool" xdg-utils
done

mime_check 'Default browser (text/html)'      text/html
mime_check 'Default browser (x-scheme-handler/http)'  x-scheme-handler/http
mime_check 'Default file manager (inode/directory)'   inode/directory
mime_check 'Default PDF viewer (application/pdf)'     application/pdf
mime_check 'Default image viewer (image/png)'         image/png
mime_check 'Default video player (video/mp4)'         video/mp4 true
mime_check 'Default archive (application/zip)'        application/zip

# Extended matrix: validate the remaining AHR-managed MIME types from the same
# shared definition used by setup, so validation cannot drift from setup.
if declare -F ahr_matrix_mimes >/dev/null; then
  printf '\n=== Extended MIME Matrix ===\n'
  declare -A AHR_BASE_MIMES=(
    [text/html]=1 [x-scheme-handler/http]=1 [inode/directory]=1
    [application/pdf]=1 [image/png]=1 [video/mp4]=1 [application/zip]=1
  )
  mime="" label="" category=""
  while IFS= read -r mime; do
    [[ -n "$mime" ]] || continue
    [[ -n "${AHR_BASE_MIMES[$mime]:-}" ]] && continue
    category="$(ahr_matrix_category_for_mime "$mime")"
    label="Default ${category} (${mime})"
    mime_check "$label" "$mime"
  done < <(ahr_matrix_mimes)
fi

printf '\n=== Theme State ===\n'
theme_check

printf '\n=== Toggle State ===\n'
toggle_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/artix-hypr-remix/toggles"
toggle_check() {
  local name="$1"
  local label="$2"
  if [[ -f "$toggle_state_dir/$name" ]]; then
    printf '  OK: %s — enabled\n' "$label"
  else
    printf '  OK: %s — disabled\n' "$label"
  fi
}
toggle_check nightlight "Nightlight"
toggle_check idle "Idle lock"
toggle_check notification-silencing "Notification silencing"
# waybar-position stores a value, not a flag — just report its state
if [[ -f "$toggle_state_dir/waybar-position" ]]; then
  pos="$(cat "$toggle_state_dir/waybar-position" 2>/dev/null || echo "unknown")"
  printf '  OK: Waybar position — %s\n' "$pos"
else
  printf '  OK: Waybar position — default (top)\n'
fi

printf '\n=== Framework Version ===\n'
FRAMEWORK_JSON="$FRAMEWORK_ROOT/framework.json"
if [[ -f "$FRAMEWORK_JSON" ]]; then
  if command -v jq >/dev/null 2>&1; then
    fw_version="$(jq -r '.version // "unknown"' "$FRAMEWORK_JSON" 2>/dev/null || echo "unknown")"
    fw_channel="$(jq -r '.channel // "unknown"' "$FRAMEWORK_JSON" 2>/dev/null || echo "unknown")"
  else
    fw_version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FRAMEWORK_JSON" | head -n1)"
    fw_channel="$(sed -n 's/.*"channel"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FRAMEWORK_JSON" | head -n1)"
  fi
  printf '  OK: version %s (%s)\n' "${fw_version:-unknown}" "${fw_channel:-unknown}"
else
  printf '  WARN: framework metadata not deployed (run installer phase 7)\n'
fi

printf '\n=== Namespace Links ===\n'
ns_bin_dir="${AHR_LOCAL_BIN:-$HOME/.local/bin}"
if [[ -d "$ns_bin_dir" ]]; then
  ns_ok=0
  ns_warn=0
  ns_total=0
  for ns_cmd in ahr ahr-update ahr-update-framework ahr-update-available ahr-restore-component ahr-doctor; do
    ns_total=$((ns_total + 1))
    ns_path="$ns_bin_dir/$ns_cmd"
    if [[ -L "$ns_path" ]]; then
      ns_target_read="$(readlink "$ns_path" 2>/dev/null || true)"
      case "$ns_target_read" in
        "$FRAMEWORK_ROOT/bin/"*)
          if [[ -e "$ns_path" ]]; then
            printf '  OK: %s -> %s\n' "$ns_cmd" "$ns_target_read"
            ns_ok=$((ns_ok + 1))
          else
            printf '  WARN: %s symlink broken -> %s\n' "$ns_cmd" "$ns_target_read"
            ns_warn=$((ns_warn + 1))
          fi
          ;;
        *)
          printf '  WARN: %s -> %s (not AHR-owned)\n' "$ns_cmd" "$ns_target_read"
          ns_warn=$((ns_warn + 1))
          ;;
      esac
    elif [[ -e "$ns_path" ]]; then
      printf '  WARN: %s exists but is not a symlink\n' "$ns_cmd"
      ns_warn=$((ns_warn + 1))
    else
      printf '  MISSING: %s\n' "$ns_cmd"
      overall_status=1
    fi
  done
  if (( ns_warn == 0 && ns_ok > 0 )); then
    printf '  OK: %d/%d namespace links healthy\n' "$ns_ok" "$ns_total"
  fi
else
  printf '  WARN: namespace directory not found: %s\n' "$ns_bin_dir"
fi

printf '\n=== Framework Commands ===\n'
framework_cmd_check ahr-menu
framework_cmd_check ahr-menu-keybindings
framework_cmd_check ahr-launch-terminal
framework_cmd_check ahr-launch-apps
framework_cmd_check ahr-launch-browser
framework_cmd_check ahr-launch-files
framework_cmd_check ahr-default-browser
framework_cmd_check ahr-default-terminal
framework_cmd_check ahr-default-editor
framework_cmd_check ahr-repair
framework_cmd_check ahr-system-lock
framework_cmd_check ahr-toggle
framework_cmd_check ahr-toggle-idle
framework_cmd_check ahr-restore-idle
framework_cmd_check ahr-restore-nightlight
framework_cmd_check ahr-launch-wallpaper-session
framework_cmd_check ahr-capture-screenshot
framework_cmd_check ahr-capture-picker
framework_cmd_check ahr-theme
framework_cmd_check ahr-status
framework_cmd_check ahr-doctor
framework_cmd_check ahr-update
framework_cmd_check ahr-update-available
framework_cmd_check ahr-update-framework
framework_cmd_check ahr-restore-component
framework_cmd_check namespace-install.sh
framework_cmd_check migrate.sh
framework_cmd_check ahr-validate-managed-paths.sh
framework_library_check ahr-lib.sh
framework_library_check ahr-version.sh
framework_library_check ahr-cache.sh
framework_library_check ahr-backup-helper.sh
framework_library_check ahr-managed-paths.sh
framework_library_check ahr-theme-lib.sh
framework_library_check ahr-toggle-lib.sh
framework_library_check ahr-font-lib.sh
framework_cmd_check ahr-migrate

printf '\n'
if (( overall_status == 0 )); then
  printf 'All checks passed.\n'
else
  printf 'Some checks failed. Run ahr repair --dry-run for fixable issues.\n'
fi

exit "$overall_status"
