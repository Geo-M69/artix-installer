#!/usr/bin/env bash
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

# Try OpenRC/pm-utils suspend, then fall back to direct /sys/power/state write.
if ahr_has_cmd pm-suspend; then
  exec pm-suspend
fi

if ahr_has_cmd zzz; then
  exec zzz
fi

if [[ -w /sys/power/state ]]; then
  exec printf '%s' mem > /sys/power/state
fi

ahr_fail "No suspend method found (try installing pm-utils or acpid)"
