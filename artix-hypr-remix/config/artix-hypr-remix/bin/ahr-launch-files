#!/usr/bin/env bash
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

target_path="${1:-$HOME}"

if ahr_has_cmd nautilus; then
  exec nautilus "$target_path"
fi

if ahr_has_cmd thunar; then
  exec thunar "$target_path"
fi

if ahr_has_cmd dolphin; then
  exec dolphin "$target_path"
fi

if ahr_has_cmd xdg-open; then
  exec xdg-open "$target_path"
fi

if ahr_has_cmd yazi; then
  if ahr_exec_terminal_app yazi "$target_path"; then
    exit 0
  fi
fi

ahr_fail "No file manager found"
