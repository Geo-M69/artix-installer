#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec_ahr_command() {
  local command_name="$1"
  shift || true

  if [[ -x "$SCRIPT_DIR/$command_name" ]]; then
    exec "$SCRIPT_DIR/$command_name" "$@"
  fi

  if command -v "$command_name" >/dev/null 2>&1; then
    exec "$command_name" "$@"
  fi

  printf 'Command not found: %s\n' "$command_name" >&2
  exit 127
}

usage() {
  cat <<'EOF'
Usage: ahr <command> [args]

Commands:
  menu                Open command menu (learn/trigger/style/setup/install/remove/update/system)
  menu-keybindings    Show Hyprland keybinding help
  theme               Theme engine command group
  theme-install-omarchy Download an Omarchy theme via sparse checkout
  launch-terminal     Open terminal
  launch-apps         Open application launcher
  launch-browser      Open browser
  launch-files        Open file manager
  launch-audio        Open audio control
  launch-bluetooth    Open Bluetooth control
  launch-wifi         Open network control
  default-browser     Inspect or set default browser
  default-terminal    Inspect or set default terminal
  default-editor      Inspect or set default editor
  status              Print install state, log paths, and framework summary
  list-backups        List config backups created by installer phase 4
  update              System + AUR update helper
  update-available    Check whether updates are available (for status bars)
  repair              Check and apply safe framework repairs
  doctor              Run installed-framework health checks
  voxtype-model       Open voxtype model setup
  voxtype-config      Open voxtype configuration file
  toggle-idle         Toggle hypridle daemon state
  toggle-notifications Toggle notification silencing mode
  toggle-waybar       Toggle Waybar visibility
  toggle-nightlight    Toggle nightlight screen temperature
  toggle-waybar-position Toggle Waybar position (top/bottom)
  notification-dismiss Dismiss a mako notification
  restart-mako        Restart Mako notification daemon
  restart-waybar      Restart Waybar
  restart-walker      Restart Walker launcher service
  migrate             Run or inspect pending framework migrations
  system-lock         Lock session
  system-reboot       Reboot system
  capture-screenrecording Toggle screen recording
  capture-screenshot  Area, fullscreen, or window screenshot
  capture-picker      Interactive screenshot mode picker
  edit-config         Open editor for a config file
  system-suspend      Suspend to RAM
  system-hibernate    Hibernate to disk
  font                Font engine command group
  list                Show command list
  help                Show this help
EOF
}

dispatch() {
  local subcommand="$1"
  shift || true

  case "$subcommand" in
    menu) exec_ahr_command ahr-menu "$@" ;;
    menu-keybindings) exec_ahr_command ahr-menu-keybindings "$@" ;;
    theme) exec_ahr_command ahr-theme "$@" ;;
    theme-install-omarchy) exec_ahr_command ahr-theme-install-omarchy "$@" ;;
    launch-terminal) exec_ahr_command ahr-launch-terminal "$@" ;;
    launch-apps) exec_ahr_command ahr-launch-apps "$@" ;;
    launch-browser) exec_ahr_command ahr-launch-browser "$@" ;;
    launch-files) exec_ahr_command ahr-launch-files "$@" ;;
    launch-audio) exec_ahr_command ahr-launch-audio "$@" ;;
    launch-bluetooth) exec_ahr_command ahr-launch-bluetooth "$@" ;;
    launch-wifi) exec_ahr_command ahr-launch-wifi "$@" ;;
    default-browser) exec_ahr_command ahr-default-browser "$@" ;;
    default-terminal) exec_ahr_command ahr-default-terminal "$@" ;;
    default-editor) exec_ahr_command ahr-default-editor "$@" ;;
    update) exec_ahr_command ahr-update "$@" ;;
    update-available) exec_ahr_command ahr-update-available "$@" ;;
    status) exec_ahr_command ahr-status "$@" ;;
    list-backups) exec_ahr_command ahr-list-backups "$@" ;;
    repair) exec_ahr_command ahr-repair "$@" ;;
    doctor) exec_ahr_command ahr-doctor "$@" ;;
    voxtype-model) exec_ahr_command ahr-voxtype-model "$@" ;;
    voxtype-config) exec_ahr_command ahr-voxtype-config "$@" ;;
    toggle-idle) exec_ahr_command ahr-toggle-idle "$@" ;;
    toggle-notifications) exec_ahr_command ahr-toggle-notification-silencing "$@" ;;
    toggle-waybar) exec_ahr_command ahr-toggle-waybar "$@" ;;
    toggle-waybar-position) exec_ahr_command ahr-toggle-waybar-position "$@" ;;
    toggle-nightlight) exec_ahr_command ahr-toggle-nightlight "$@" ;;
    notification-dismiss) exec_ahr_command ahr-notification-dismiss "$@" ;;
    restart-mako) exec_ahr_command ahr-restart-mako "$@" ;;
    restart-waybar) exec_ahr_command ahr-restart-waybar "$@" ;;
    restart-walker) exec_ahr_command ahr-restart-walker "$@" ;;
    migrate) exec_ahr_command ahr-migrate "$@" ;;
    system-lock) exec_ahr_command ahr-system-lock "$@" ;;
    system-reboot) exec_ahr_command ahr-system-reboot "$@" ;;
    capture-screenrecording) exec_ahr_command ahr-capture-screenrecording "$@" ;;
    capture-screenshot) exec_ahr_command ahr-capture-screenshot "$@" ;;
    capture-picker) exec_ahr_command ahr-capture-picker "$@" ;;
    edit-config) exec_ahr_command ahr-edit-config "$@" ;;    
    system-suspend) exec_ahr_command ahr-system-suspend "$@" ;;
    system-hibernate) exec_ahr_command ahr-system-hibernate "$@" ;;
    font) exec_ahr_command ahr-font "$@" ;;
    list)
      printf '%s\n' \
        "ahr-menu" \
        "ahr-menu-keybindings" \
        "ahr-theme" \
        "ahr-theme-install-omarchy" \
        "ahr-launch-terminal" \
        "ahr-launch-apps" \
        "ahr-launch-browser" \
        "ahr-launch-files" \
        "ahr-launch-audio" \
        "ahr-launch-bluetooth" \
        "ahr-launch-wifi" \
        "ahr-default-browser" \
        "ahr-default-terminal" \
        "ahr-default-editor" \
        "ahr-update" \
        "ahr-update-available" \
        "ahr-status" \
        "ahr-list-backups" \
        "ahr-repair" \
        "ahr-voxtype-model" \
        "ahr-voxtype-config" \
        "ahr-toggle-idle" \
        "ahr-toggle-notification-silencing" \
        "ahr-toggle-waybar" \
        "ahr-toggle-waybar-position" \
        "ahr-toggle-nightlight" \
        "ahr-notification-dismiss" \
        "ahr-restart-mako" \
        "ahr-restart-waybar" \
        "ahr-restart-walker" \
        "ahr-migrate" \
        "ahr-system-lock" \
        "ahr-system-reboot" \
        "ahr-capture-screenrecording" \
        "ahr-capture-screenshot" \
        "ahr-capture-picker" \
        "ahr-edit-config" \
        "ahr-system-suspend" \
        "ahr-system-hibernate" \
        "ahr-doctor" \
        "ahr-font"
      ;;
    help|-h|--help|"")
      usage
      ;;
    *)
      # Try as a generic ahr-<command> before giving up
      if [[ -x "$SCRIPT_DIR/ahr-$subcommand" ]] || command -v "ahr-$subcommand" >/dev/null 2>&1; then
        exec_ahr_command "ahr-$subcommand" "$@"
      fi
      printf 'Unknown command: %s\n\n' "$subcommand" >&2
      usage >&2
      exit 1
      ;;
  esac
}

dispatch "${1:-help}" "${@:2}"
