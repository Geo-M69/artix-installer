#!/usr/bin/env bash
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

if ! ahr_require cliphist cliphist; then
  ahr_notify "artix-hypr-remix" "cliphist is not installed — install with: sudo pacman -S cliphist"
  exit 1
fi

pick_command() {
  # Prefer Walker for Omarchy menu parity; fall back to wofi/rofi.
  if ahr_has_cmd walker; then
    walker --dmenu -p "Clipboard"
    return 0
  fi

  if ahr_has_cmd wofi; then
    wofi --dmenu --prompt "Clipboard"
    return 0
  fi

  if ahr_has_cmd rofi; then
    rofi -dmenu -p "Clipboard"
    return 0
  fi

  return 1
}

pick_tty() {
  local line selection index
  local -a lines=()

  mapfile -t lines < <(cliphist list | head -n 30)
  if [[ "${#lines[@]}" -eq 0 ]]; then
    return 1
  fi

  printf '\nClipboard history (latest 30):\n' >&2
  for index in "${!lines[@]}"; do
    printf '  %d) %s\n' "$((index + 1))" "${lines[$index]}" >&2
  done

  printf '> ' >&2
  read -r selection || true

  if [[ "$selection" =~ ^[0-9]+$ ]] && (( selection >= 1 && selection <= ${#lines[@]} )); then
    printf '%s\n' "${lines[$((selection - 1))]}"
    return 0
  fi

  return 1
}

if selection="$(cliphist list | pick_command)"; then
  :
elif [[ -t 0 && -t 1 ]] && selection="$(pick_tty)"; then
  :
else
  echo "No clipboard picker backend found." >&2
  echo "Install wofi, walker, or rofi for a graphical picker." >&2
  ahr_notify "artix-hypr-remix" "No clipboard picker backend — install wofi, walker, or rofi"
  exit 1
fi

if [[ -z "${selection:-}" ]]; then
  exit 0
fi

cliphist decode <<< "$selection" | wl-copy

