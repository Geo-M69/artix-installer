#!/usr/bin/env bash
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

if [[ "${1:-}" == "-e" ]]; then
  shift
  (($# > 0)) || ahr_fail "Usage: ahr-launch-terminal [-e command [args...]]"
  if ahr_exec_terminal_app "$@"; then
    exit 0
  fi
  ahr_fail "No terminal emulator found"
fi

if ahr_exec_terminal "$@"; then
  exit 0
fi

ahr_fail "No terminal emulator found"
