#!/usr/bin/env bash
# Report nightlight state for the Waybar indicator.
# Prefers live process+temperature when available.
# Falls back to the toggle framework when hyprsunset isn't running.
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"
source "${AHR_TOGGLE_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-toggle-lib.sh}"

nightlight=false

if pgrep -x hyprsunset >/dev/null 2>&1; then
  # Process is running — query actual temperature
  if ahr_has_cmd hyprctl; then
    current_temp="$(hyprctl hyprsunset temperature 2>/dev/null | grep -oE '[0-9]+' || true)"
    if [[ -n "$current_temp" && "$current_temp" -lt 6000 ]]; then
      nightlight=true
    elif [[ -z "$current_temp" ]] && ahr_toggle_enabled "nightlight"; then
      # hyprctl returned no temperature yet (early startup/IPC not ready)
      # but toggle framework says ON — trust desired state
      nightlight=true
    fi
  elif ahr_toggle_enabled "nightlight"; then
    # hyprctl unavailable (e.g. early startup) — trust toggle framework
    nightlight=true
  fi
elif ahr_toggle_enabled "nightlight"; then
  # Process not running but toggle says ON — treat as active.
  # ahr-restore-nightlight will start it shortly, or the next click will restore it.
  nightlight=true
fi

if [[ "$nightlight" == "true" ]]; then
  printf '{"text":"","class":"active","tooltip":"Nightlight enabled (4000K)"}\n'
else
  printf '{"text":"","class":"inactive","tooltip":"Nightlight disabled (6500K)"}\n'
fi
