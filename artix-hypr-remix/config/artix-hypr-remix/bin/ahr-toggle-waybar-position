#!/usr/bin/env bash
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

waybar_config="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/config.jsonc"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/artix-hypr-remix/toggles"
state_file="$state_dir/waybar-position"

mkdir -p "$state_dir"

# Ensure waybar config exists
if [[ ! -f "$waybar_config" ]]; then
  ahr_notify "artix-hypr-remix" "Waybar config not found: $waybar_config"
  exit 1
fi

# Determine current position from live grep of the config file
if grep -q '"position"[[:space:]]*:[[:space:]]*"top"' "$waybar_config" 2>/dev/null; then
  new_position="bottom"
else
  new_position="top"
fi

# Apply the change
sed -i 's/"position"[[:space:]]*:[[:space:]]*"top"/"position": "'"$new_position"'"/' "$waybar_config"
sed -i 's/"position"[[:space:]]*:[[:space:]]*"bottom"/"position": "'"$new_position"'"/' "$waybar_config"

# Write state file for the Waybar indicator
printf '%s\n' "$new_position" > "$state_file"

# Notify before restart so the user sees the position message
if [[ "$new_position" == "bottom" ]]; then
  ahr_notify "Waybar" "Waybar moved to bottom"
else
  ahr_notify "Waybar" "Waybar moved to top"
fi

# Restart Waybar to pick up the new position.  Delegate to ahr-restart-waybar
# which already handles the kill/wait/start cycle reliably.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "$script_dir/ahr-restart-waybar" ]]; then
  bash "$script_dir/ahr-restart-waybar"
else
  # Fallback: direct restart (ahr-restart-waybar should always exist)
  pkill -x waybar >/dev/null 2>&1 || true
  sleep 0.5
  if ahr_has_cmd waybar; then
    setsid waybar >/dev/null 2>&1 &
  fi
fi

# Signal Waybar indicator to refresh the position icon immediately
pkill -RTMIN+13 -x waybar 2>/dev/null || true
