#!/usr/bin/env bash
# Report Waybar position state for the Waybar indicator.
# Uses the shared toggle framework for the state file path.
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"
source "${AHR_TOGGLE_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-toggle-lib.sh}"

waybar_config="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/config.jsonc"
state_file="$AHR_TOGGLE_STATE_DIR/waybar-position"

position="top"

# Prefer live config state — detect both positions
if [[ -f "$waybar_config" ]]; then
  if grep -q '"position"[[:space:]]*:[[:space:]]*"bottom"' "$waybar_config" 2>/dev/null; then
    position="bottom"
  elif grep -q '"position"[[:space:]]*:[[:space:]]*"top"' "$waybar_config" 2>/dev/null; then
    position="top"
  elif [[ -f "$state_file" ]]; then
    content="$(cat "$state_file" 2>/dev/null || true)"
    if [[ "$content" == "bottom" ]]; then
      position="bottom"
    fi
  fi
elif [[ -f "$state_file" ]]; then
  content="$(cat "$state_file" 2>/dev/null || true)"
  if [[ "$content" == "bottom" ]]; then
    position="bottom"
  fi
fi

if [[ "$position" == "bottom" ]]; then
  printf '{"text":"","class":"bottom","tooltip":"Waybar at bottom — click to toggle to top"}\n'
else
  printf '{"text":"","class":"top","tooltip":"Waybar at top — click to toggle to bottom"}\n'
fi
