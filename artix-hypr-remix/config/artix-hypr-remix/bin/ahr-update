#!/usr/bin/env bash
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

FRAMEWORK_ROOT="$HOME/.config/artix-hypr-remix"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/artix-hypr-remix"
LOCK_FILE="$STATE_DIR/update.lock"
LOCK_DIR="$STATE_DIR/.update.lock"
LOG_FILE="$STATE_DIR/update.log"
RUN_FILE="$STATE_DIR/update.run"
STATUS_FILE="$STATE_DIR/update.status"
lock_mode=""
original_args=("$@")

usage() {
  cat <<'EOF'
Usage: ahr-update [options]

Options:
  --migrations-only  Run migrations and post-update hooks only
  --no-aur         Skip AUR updates
  --no-system      Skip system (pacman) updates
  --no-migrate     Skip migration run
  --flatpak        Also update Flatpak applications
  --dry-run        Show what would run without making changes
  -y, --yes        Run non-interactively when supported
  --quiet          Suppress non-error output
  -h, --help       Show this help
EOF
}

quiet=false
do_system=true
do_aur=true
do_flatpak=false
do_migrate=true
dry_run=false
assume_yes=false

while (( $# > 0 )); do
  case "$1" in
    --migrations-only)
      do_system=false
      do_aur=false
      do_flatpak=false
      do_migrate=true
      ;;
    --no-aur) do_aur=false ;;
    --no-system) do_system=false ;;
    --no-migrate) do_migrate=false ;;
    --flatpak) do_flatpak=true ;;
    --dry-run) dry_run=true ;;
    -y|--yes) assume_yes=true ;;
    --quiet) quiet=true ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
  shift
done

if [[ "$do_system" == "false" && "$do_aur" == "false" && "$do_flatpak" == "false" && "$do_migrate" == "false" ]]; then
  ahr_fail "Nothing to do: all update actions are disabled"
fi

mkdir -p "$STATE_DIR"
touch "$LOG_FILE"

log() {
  if [[ "$quiet" == "false" ]]; then
    printf '%s\n' "$1"
  fi
}

log_line() {
  local message="$1"
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$message" >> "$LOG_FILE"
}

log_and_print() {
  local message="$1"
  log_line "$message"
  log "$message"
}

write_status() {
  local status_value="$1"
  local detail="${2:-}"

  {
    printf 'status=%s\n' "$status_value"
    printf 'time=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'log=%s\n' "$LOG_FILE"
    if [[ -n "$detail" ]]; then
      printf 'detail=%s\n' "$detail"
    fi
  } > "$STATUS_FILE"
}

write_run_file() {
  {
    printf 'pid=%s\n' "$$"
    printf 'started=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'log=%s\n' "$LOG_FILE"
    printf 'command=ahr-update %s\n' "$*"
  } > "$RUN_FILE"
}

signal_waybar_update() {
  pkill -RTMIN+7 -x waybar >/dev/null 2>&1 || true
}

cleanup_lock() {
  if [[ "$lock_mode" == "mkdir" ]]; then
    rmdir "$LOCK_DIR" >/dev/null 2>&1 || true
  fi
}

acquire_lock() {
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
      printf '%s\n' "Another update process is already running." >&2
      printf '%s\n' "If this looks stale, check: $RUN_FILE" >&2
      printf '%s\n' "Recent update log: $LOG_FILE" >&2
      printf '%s\n' "Repair guidance: ahr repair --update-state" >&2
      exit 1
    fi
    lock_mode="flock"
    return 0
  fi

  if mkdir "$LOCK_DIR" >/dev/null 2>&1; then
    lock_mode="mkdir"
    return 0
  fi

  printf '%s\n' "Another update process is already running or a stale mkdir lock exists: $LOCK_DIR" >&2
  printf '%s\n' "Do not remove it blindly. Check for a running update process first." >&2
  printf '%s\n' "Recent update log: $LOG_FILE" >&2
  printf '%s\n' "Repair guidance: ahr repair --update-state" >&2
  exit 1
}

run_cmd() {
  local message="$1"
  shift

  log_and_print "$message"

  if [[ "$dry_run" == "true" ]]; then
    log_and_print "Dry-run: $*"
    return 0
  fi

  "$@"
}

finalize() {
  local exit_code=$?
  cleanup_lock
  signal_waybar_update

  if (( exit_code == 0 )); then
    rm -f "$RUN_FILE"
    write_status "success" "Update run completed successfully"
    log_line "Update run completed successfully"
    if [[ "$dry_run" == "false" ]]; then
      ahr_notify "Update" "Update complete"
    fi
    return
  fi

  rm -f "$RUN_FILE"
  write_status "failed" "Update run failed with exit code $exit_code"
  log_line "Update run failed with exit code $exit_code"
  if [[ "$quiet" == "false" ]]; then
    printf '%s\n' "Update failed. Review: $LOG_FILE" >&2
    printf '%s\n' "Recovery guidance: ahr repair --update-state" >&2
  fi
  if [[ "$dry_run" == "false" ]]; then
    ahr_notify "Update" "Update failed"
  fi
}

trap finalize EXIT

acquire_lock
write_run_file "${original_args[@]}"
write_status "running" "Update run is in progress"

log_line "Starting update run: system=$do_system aur=$do_aur flatpak=$do_flatpak migrate=$do_migrate dry_run=$dry_run assume_yes=$assume_yes"

if [[ "$do_system" == "true" ]]; then
  if ! ahr_has_cmd sudo; then
    ahr_fail "sudo is required to run system updates (pacman)"
  fi

  pacman_cmd=(sudo pacman -Syu)
  if [[ "$assume_yes" == "true" ]]; then
    pacman_cmd+=(--noconfirm)
  fi

  run_cmd "Running system update (pacman)" "${pacman_cmd[@]}"
fi

if [[ "$do_aur" == "true" ]]; then
  if ahr_has_cmd paru; then
    if [[ "$do_system" == "true" ]]; then
      aur_cmd=(paru -Sua)
    else
      aur_cmd=(paru -Syu)
    fi

    if [[ "$assume_yes" == "true" ]]; then
      aur_cmd+=(--noconfirm --skipreview)
    fi

    run_cmd "Running AUR update via paru" "${aur_cmd[@]}"
  elif ahr_has_cmd yay; then
    if [[ "$do_system" == "true" ]]; then
      aur_cmd=(yay -Sua)
    else
      aur_cmd=(yay -Syu)
    fi

    if [[ "$assume_yes" == "true" ]]; then
      aur_cmd+=(--noconfirm)
    fi

    run_cmd "Running AUR update via yay" "${aur_cmd[@]}"
  else
    log_and_print "No AUR helper found; skipping AUR updates"
  fi
fi

if [[ "$do_flatpak" == "true" ]]; then
  if ahr_has_cmd flatpak; then
    flatpak_cmd=(flatpak update)
    if [[ "$assume_yes" == "true" ]]; then
      flatpak_cmd+=(-y)
    fi

    run_cmd "Running flatpak update" "${flatpak_cmd[@]}"
  else
    log_and_print "flatpak not available; skipping flatpak updates"
  fi
fi

if [[ "$do_migrate" == "true" ]]; then
  migration_runner="$FRAMEWORK_ROOT/bin/migrate.sh"
  if [[ ! -f "$migration_runner" ]]; then
    ahr_fail "Migration runner not found: $migration_runner"
  fi

  if [[ "$dry_run" == "true" ]]; then
    log_and_print "Inspecting framework migrations (dry-run)"
    migration_cmd=(bash "$migration_runner" --dry-run)
    if [[ "$quiet" == "true" ]]; then
      migration_cmd+=(--quiet)
    fi
    "${migration_cmd[@]}"
  else
    migration_cmd=(bash "$migration_runner" --non-interactive)
    if [[ "$quiet" == "true" ]]; then
      migration_cmd+=(--quiet)
    fi
    run_cmd "Running framework migrations" "${migration_cmd[@]}"
  fi
fi

hook_runner="$FRAMEWORK_ROOT/bin/hook.sh"
if [[ -f "$hook_runner" ]]; then
  run_cmd "Running post-update hooks" bash "$hook_runner" post-update
else
  log_and_print "No hook runner found at $hook_runner; skipping post-update hooks"
fi

exit 0
