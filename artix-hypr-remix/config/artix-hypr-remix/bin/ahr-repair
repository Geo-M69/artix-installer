#!/usr/bin/env bash
set -euo pipefail

FRAMEWORK_ROOT="${AHR_FRAMEWORK_ROOT:-$HOME/.config/artix-hypr-remix}"
SCRIPT_DIR="$FRAMEWORK_ROOT/bin"
source "${AHR_LIB_PATH:-$SCRIPT_DIR/ahr-lib.sh}"

DOCS_DIR="$FRAMEWORK_ROOT/docs"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/artix-hypr-remix"
MIGRATION_STATE_DIR="$STATE_ROOT/migrations"
MIGRATION_SKIPPED_DIR="$MIGRATION_STATE_DIR/skipped"
UPDATE_LOCK_DIR="$STATE_ROOT/.update.lock"
UPDATE_LOG_FILE="$STATE_ROOT/update.log"
UPDATE_RUN_FILE="$STATE_ROOT/update.run"
UPDATE_STATUS_FILE="$STATE_ROOT/update.status"
LOCAL_BIN="$HOME/.local/bin"

apply=false
quiet=false
status=0
scope_requested=false
run_namespace=true
run_theme=true
run_docs=true
run_migrations=true
run_update_state=true
run_startup=true
run_config=true

usage() {
  cat <<'EOF'
Usage: ahr-repair [options]

Checks common Artix Hypr Remix drift and optionally applies safe repairs.

Options:
  --dry-run       Check only; do not apply repairs (default)
  --apply         Apply safe repairs. Without this, ahr-repair is a dry-run.
  --all           Check every repair scope (default)
  --namespace     Check command namespace links
  --theme         Check theme state
  --docs          Check installed docs
  --migrations    Check migration state
  --update-state  Check update lock/log hints
  --startup       Check startup mode state
  --config        Check managed config presence and backup hints (detect-only)
  --quiet         Reduce success output
  -h, --help      Show this help
EOF
}

log() {
  local message="${1:-}"
  if [[ "$quiet" == "false" ]]; then
    printf '%s\n' "$message"
  fi
}

warn() {
  printf 'WARN: %s\n' "$1"
}

fail_check() {
  status=1
  printf 'FIX: %s\n' "$1"
}

repairable_issue() {
  if [[ "$apply" == "true" ]]; then
    warn "$1"
  else
    fail_check "$1"
  fi
}

is_link_to() {
  local link_path="$1"
  local expected_target="$2"
  local actual_target

  [[ -L "$link_path" ]] || return 1
  actual_target="$(readlink "$link_path" 2>/dev/null || true)"
  [[ "$actual_target" == "$expected_target" ]]
}

run_or_preview() {
  local description="$1"
  shift

  if [[ "$apply" == "true" ]]; then
    log "APPLY: $description"
    "$@"
  else
    fail_check "$description (run with --apply)"
  fi
}

enable_only_scope() {
  if [[ "$scope_requested" == "false" ]]; then
    run_namespace=false
    run_theme=false
    run_docs=false
    run_migrations=false
    run_update_state=false
    run_startup=false
    run_config=false
    scope_requested=true
  fi
}

enable_all_scopes() {
  run_namespace=true
  run_theme=true
  run_docs=true
  run_migrations=true
  run_update_state=true
  run_startup=true
  run_config=true
  scope_requested=true
}

check_namespace() {
  local installer="$SCRIPT_DIR/namespace-install.sh"
  local command_name source_path link_path
  local namespace_ok=true
  local -a required_commands=(
    ahr
    ahr-menu
    ahr-menu-keybindings
    ahr-repair
    ahr-status
    ahr-list-backups
    ahr-theme
    ahr-update
    ahr-update-available
    ahr-migrate
  )

  log
  log "Namespace checks"

  if [[ ! -x "$installer" ]]; then
    fail_check "namespace installer missing or not executable: $installer"
    return
  fi

  for command_name in "${required_commands[@]}"; do
    source_path="$SCRIPT_DIR/$command_name"
    link_path="$LOCAL_BIN/$command_name"

    if [[ ! -x "$source_path" ]]; then
      fail_check "framework command missing or not executable: $source_path"
      namespace_ok=false
      continue
    fi

    if is_link_to "$link_path" "$source_path"; then
      log "OK: $link_path -> $source_path"
    else
      repairable_issue "repair command namespace links with $installer"
      namespace_ok=false
      break
    fi
  done

  if [[ "$namespace_ok" == "false" ]]; then
    run_or_preview "rerun command namespace installer" "$installer" --quiet
  else
    log "OK: command namespace links look healthy"
  fi
}

check_config_drift() {
  local label path root backup
  local config_ok=true
  local -a required_paths=(
    "Hyprland config:$HOME/.config/hypr/hyprland.conf"
    "Hypridle config:$HOME/.config/hypr/hypridle.conf"
    "Hyprlock config:$HOME/.config/hypr/hyprlock.conf"
    "Waybar config:$HOME/.config/waybar/config.jsonc"
    "Waybar style:$HOME/.config/waybar/style.css"
    "Mako config:$HOME/.config/mako/config"
  )
  local -a managed_roots=(
    artix-hypr-remix
    fontconfig
    ghostty
    helix
    hypr
    mako
    starship
    walker
    waybar
    yazi
    zsh
  )

  log
  log "Managed config checks"

  for spec in "${required_paths[@]}"; do
    label="${spec%%:*}"
    path="${spec#*:}"

    if [[ -s "$path" ]]; then
      log "OK: $label present: $path"
    else
      fail_check "$label missing: $path; re-run installer phase 4/config deployment"
      config_ok=false
    fi
  done

  shopt -s nullglob
  for root in "${managed_roots[@]}"; do
    for backup in "$HOME/.config/$root".bak.*; do
      warn "found previous phase-4 backup for managed config root: $backup"
    done
  done
  shopt -u nullglob

  if [[ "$config_ok" == "true" ]]; then
    log "OK: core managed config files are present"
  fi

  warn "Config repair is detect-only for now. Future rewrite actions must preserve timestamp backups before replacing files."
}

check_theme_state() {
  local theme_name_file="$FRAMEWORK_ROOT/current/theme.name"
  local theme_link="$FRAMEWORK_ROOT/current/theme"
  local background_link="$FRAMEWORK_ROOT/current/background"
  local theme_cmd="$SCRIPT_DIR/ahr-theme"
  local theme_name=""
  local theme_ok=true

  log
  log "Theme state checks"

  if [[ -s "$theme_name_file" ]]; then
    theme_name="$(<"$theme_name_file")"
    log "OK: current theme name: $theme_name"
  else
    repairable_issue "current theme name missing: $theme_name_file"
    theme_ok=false
  fi

  if [[ -e "$theme_link" ]]; then
    log "OK: current theme path exists: $theme_link"
  else
    repairable_issue "current theme path missing: $theme_link"
    theme_ok=false
  fi

  if [[ -e "$background_link" || -L "$background_link" ]]; then
    log "OK: current background state exists: $background_link"
  else
    warn "current background state missing: $background_link"
  fi

  if [[ "$theme_ok" == "false" ]]; then
    if [[ ! -x "$theme_cmd" ]]; then
      fail_check "theme command missing or not executable: $theme_cmd"
      return
    fi

    if "$theme_cmd" list --raw 2>/dev/null | grep -qx 'artix-dark'; then
      run_or_preview "apply default theme artix-dark" "$theme_cmd" set --quiet artix-dark
    else
      fail_check "default theme artix-dark not available; rerun config deployment"
    fi
  else
    log "OK: theme state looks healthy"
  fi
}

check_docs() {
  local doc
  local docs_ok=true
  local -a required_docs=(
    quick-reference.md
    theme-assets.md
  )

  log
  log "Installed docs checks"

  for doc in "${required_docs[@]}"; do
    if [[ -s "$DOCS_DIR/$doc" ]]; then
      log "OK: installed doc: $DOCS_DIR/$doc"
    else
      fail_check "installed doc missing: $DOCS_DIR/$doc"
      docs_ok=false
    fi
  done

  if [[ "$docs_ok" == "false" ]]; then
    warn "Docs are source-deployed assets. Re-run installer phase 4/config deployment to restore missing docs."
  fi
}

check_migrations() {
  local migrate_cmd="$SCRIPT_DIR/ahr-migrate"
  local skipped_count=0
  local migration_log="$MIGRATION_STATE_DIR/migrate.log"

  log
  log "Migration state checks"

  if [[ ! -x "$migrate_cmd" ]]; then
    fail_check "migration command missing or not executable: $migrate_cmd"
    return
  fi

  if [[ ! -d "$MIGRATION_STATE_DIR" ]]; then
    warn "migration state directory missing: $MIGRATION_STATE_DIR"
    warn "Migrations have not been initialized yet. This is normal for fresh installs."
    warn "Run first-run setup or: ahr migrate --status"
  else
    log "OK: migration state directory exists: $MIGRATION_STATE_DIR"
  fi

  "$migrate_cmd" --status || status=1

  if [[ -d "$MIGRATION_SKIPPED_DIR" ]]; then
    skipped_count="$(find "$MIGRATION_SKIPPED_DIR" -maxdepth 1 -type f 2>/dev/null | wc -l)"
  fi

  if (( skipped_count > 0 )); then
    fail_check "skipped migrations present ($skipped_count)"
    warn "Review migration log: $migration_log"
    warn "View skipped migrations: ls -la $MIGRATION_SKIPPED_DIR/"
    warn "Recovery steps:"
    warn "  1. Review what went wrong: cat $migration_log"
    warn "  2. Fix any underlying issues (missing packages, config drift, etc.)"
    warn "  3. Retry skipped migrations: ahr migrate --retry-skipped"
    warn "  4. If retry fails, inspect individual migration scripts in:"
    warn "     $FRAMEWORK_ROOT/migrations/"
    warn "  5. After fixing, re-run: ahr repair --migrations"
  else
    log "OK: no skipped migrations recorded"
  fi
}

check_update_state() {
  local pid=""
  local status_value=""

  log
  log "Update state checks"

  if [[ -f "$UPDATE_STATUS_FILE" ]]; then
    status_value="$(sed -nE 's/^status=(.*)$/\1/p' "$UPDATE_STATUS_FILE" | head -n1)"
    log "OK: last update status: ${status_value:-unknown} ($UPDATE_STATUS_FILE)"
    if [[ "$status_value" == "failed" ]]; then
      warn "Last update run failed."
      warn "Review the update log: $UPDATE_LOG_FILE"
      warn "Guided recovery:"
      warn "  1. Check what failed: tail -20 $UPDATE_LOG_FILE"
      warn "  2. Fix any underlying issues (network, package conflicts, disk space)"
      warn "  3. Dry-run before retrying: ahr update --dry-run"
      warn "  4. If ready, retry: ahr update"
      warn "  5. If the log shows partial success, run: ahr migrate"
    fi
  else
    warn "Update status file not found: $UPDATE_STATUS_FILE"
    warn "No update run has completed yet. Run: ahr update"
  fi

  if [[ -f "$UPDATE_RUN_FILE" ]]; then
    pid="$(sed -nE 's/^pid=([0-9]+)$/\1/p' "$UPDATE_RUN_FILE" | head -n1)"
    if [[ -n "$pid" && -d "/proc/$pid" ]]; then
      warn "Update run marker found and PID $pid appears active."
      warn "Either wait for it to finish, or if you are sure it is stuck:"
      warn "  kill $pid && ahr repair --update-state --apply"
    else
      repairable_issue "Stale/interrupted update run marker: $UPDATE_RUN_FILE"
      warn "Guided recovery:"
      warn "  1. Verify no update is running: ps aux | grep ahr-update"
      warn "  2. Review log for partial success: cat $UPDATE_LOG_FILE"
      warn "  3. Run migrations if packages were updated: ahr migrate"
      warn "  4. Apply fix (removes stale marker): ahr repair --update-state --apply"
      if [[ "$apply" == "true" ]]; then
        run_or_preview "remove stale update run marker" rm -f "$UPDATE_RUN_FILE"
      fi
    fi
  else
    log "OK: no interrupted update run marker found"
  fi

  if [[ -d "$UPDATE_LOCK_DIR" ]]; then
    if [[ -n "$pid" && -d "/proc/$pid" ]]; then
      warn "mkdir-style update lock exists while PID $pid appears active."
    else
      repairable_issue "Possible stale mkdir-style update lock directory: $UPDATE_LOCK_DIR"
      warn "Guided recovery:"
      warn "  1. Confirm no update is running: ps aux | grep ahr-update"
      warn "  2. If stale, remove lock: ahr repair --update-state --apply"
      warn "  3. Then run: ahr update --dry-run"
      if [[ "$apply" == "true" ]]; then
        run_or_preview "remove stale mkdir-style update lock directory" rmdir "$UPDATE_LOCK_DIR"
      fi
    fi
  else
    log "OK: no mkdir-style update lock directory found"
  fi

  if [[ -f "$UPDATE_LOG_FILE" ]]; then
    log "OK: update log exists: $UPDATE_LOG_FILE"
  else
    warn "update log not found yet: $UPDATE_LOG_FILE"
  fi
}

check_startup_mode() {
  local startup_mode_file="$STATE_ROOT/startup.mode"
  local session_launcher="$HOME/.config/artix-hypr-remix/bin/start-hyprland-session.sh"
  local tty_launcher="$HOME/.bash_profile"
  local greetd_config="/etc/greetd/config.toml"
  local mode_value=""

  log
  log "Startup mode checks"

  if [[ -f "$startup_mode_file" ]]; then
    mode_value="$(<"$startup_mode_file")"
    log "OK: recorded startup mode: $mode_value"
  else
    warn "Startup mode state file missing: $startup_mode_file"
    warn "This may be normal if the installer has not configured startup yet."
    warn "Run installer phase 5: sudo ./install.sh --phase 5 --user <username>"
  fi

  if [[ ! -x "$session_launcher" ]]; then
    fail_check "Session launcher not executable or missing: $session_launcher"
    warn "Re-run installer phase 4: sudo ./install.sh --phase 4 --user <username> -y"
  else
    log "OK: session launcher present: $session_launcher"
  fi

  # Check TTY startup path
  if [[ -f "$tty_launcher" ]] && grep -q 'start-hyprland-session' "$tty_launcher" 2>/dev/null; then
    log "OK: TTY startup configured in $tty_launcher"
  else
    warn "TTY startup not detected in $tty_launcher"
    warn "If using TTY mode, re-run installer phase 5 with --startup-mode tty"
  fi

  # Check greetd config if applicable
  if [[ "$mode_value" == "greetd" ]] || [[ -f "$greetd_config" ]]; then
    if [[ -f "$greetd_config" ]]; then
      if grep -q 'artix-hypr-remix' "$greetd_config" 2>/dev/null || grep -q 'start-hyprland-session' "$greetd_config" 2>/dev/null; then
        log "OK: greetd configured for Artix Hypr Remix: $greetd_config"
      else
        warn "greetd config exists but does not reference AHR session launcher: $greetd_config"
      fi
    else
      warn "greetd config not found (startup mode is greetd): $greetd_config"
      warn "Re-run installer phase 5 with --startup-mode greetd"
    fi
  fi

  log "OK: startup mode checks complete"
}

while (( $# > 0 )); do
  case "$1" in
    --dry-run) apply=false ;;
    --apply) apply=true ;;
    --all) enable_all_scopes ;;
    --namespace) enable_only_scope; run_namespace=true ;;
    --theme) enable_only_scope; run_theme=true ;;
    --docs) enable_only_scope; run_docs=true ;;
    --migrations) enable_only_scope; run_migrations=true ;;
    --update-state) enable_only_scope; run_update_state=true ;;
    --startup) enable_only_scope; run_startup=true ;;
    --config) enable_only_scope; run_config=true ;;
    --quiet) quiet=true ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n\n' "$1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

if [[ "$apply" == "true" ]]; then
  log "AHR repair: apply mode"
else
  log "AHR repair: dry-run mode"
fi

if [[ "$run_namespace" == "true" ]]; then
  check_namespace
fi

if [[ "$run_theme" == "true" ]]; then
  check_theme_state
fi

if [[ "$run_docs" == "true" ]]; then
  check_docs
fi

if [[ "$run_migrations" == "true" ]]; then
  check_migrations
fi

if [[ "$run_update_state" == "true" ]]; then
  check_update_state
fi

if [[ "$run_config" == "true" ]]; then
  check_config_drift
fi

if [[ "$run_startup" == "true" ]]; then
  check_startup_mode
fi

if (( status == 0 )); then
  log
  log "Repair check completed: no required repairs found"
else
  log
  log "Repair check completed: follow the FIX lines above"
fi

exit "$status"
