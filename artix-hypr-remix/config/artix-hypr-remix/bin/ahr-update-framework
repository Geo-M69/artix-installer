#!/usr/bin/env bash
set -euo pipefail

# ahr-update-framework — Phase 1 framework delivery and recovery.
#
# Modes:
#   --status     Print installed framework metadata (default)
#   --check      Compare installed version against remote (read-only)
#   --dry-run    Discover and validate the staged update; stop before backup
#   --apply      Apply a framework update with full transaction safety
#   --rollback   Restore the previous framework from the last backup
#   --recover    Recover from an interrupted apply/rollback transaction
#
# All destructive operations use an exclusive transaction model with:
#   - collision-proof transaction ID (mktemp -d, never PID alone)
#   - durable transaction state under $STATE_ROOT/framework-transactions/
#   - per-target progress tracking
#   - signal-aware restoration (EXIT/INT/TERM/HUP)
#   - exact staged commit pinning
#   - prevalidated rollback before any mutation
#   - exact migration-state restoration
#   - structured state records (no space-separated fields, no sourceable data)
#
# Exit codes:
#   0  Operation succeeded or update available (check/dry-run)
#   1  Up to date, no rollback, or operation failed
#   2  Invalid arguments

FRAMEWORK_ROOT="${AHR_FRAMEWORK_ROOT:-$HOME/.config/artix-hypr-remix}"

# Libraries default to the framework tree containing this updater, not the
# managed framework target. This keeps direct candidate execution internally
# consistent while retaining AHR_FRAMEWORK_ROOT for the installed target. An
# existing explicit library override remains authoritative for fixtures and
# production callers that intentionally provide one.
if [[ -n "${AHR_LIB_PATH:-}" ]]; then
  LIB_PATH="$AHR_LIB_PATH"
else
  updater_source="${BASH_SOURCE[0]}"
  while [[ -L "$updater_source" ]]; do
    updater_dir="$(cd -P "$(dirname "$updater_source")" && pwd)"
    updater_target="$(readlink "$updater_source")"
    [[ "$updater_target" == /* ]] || updater_target="$updater_dir/$updater_target"
    updater_source="$updater_target"
  done
  UPDATER_BIN_DIR="$(cd -P "$(dirname "$updater_source")" && pwd)"
  UPDATER_FRAMEWORK_ROOT="$(cd "$UPDATER_BIN_DIR/.." && pwd)"
  SCRIPT_DIR="$UPDATER_BIN_DIR"
  LIB_PATH="$UPDATER_BIN_DIR/ahr-lib.sh"
fi
source "$LIB_PATH"
LIB_DIR="$(dirname "$LIB_PATH")"
# shellcheck source=ahr-version.sh
source "${AHR_VERSION_LIB_PATH:-$LIB_DIR/ahr-version.sh}"
# shellcheck source=ahr-cache.sh
source "${AHR_CACHE_LIB_PATH:-$LIB_DIR/ahr-cache.sh}"
# shellcheck source=ahr-backup-helper.sh
source "${AHR_BACKUP_HELPER_PATH:-$LIB_DIR/ahr-backup-helper.sh}"
FRAMEWORK_JSON="$FRAMEWORK_ROOT/framework.json"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/artix-hypr-remix"
CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/artix-hypr-remix"

# Paths
FRAMEWORK_BACKUPS_DIR="$STATE_ROOT/framework-backups"
FRAMEWORK_TRANSACTIONS_DIR="$STATE_ROOT/framework-transactions"
FRAMEWORK_LOG="$STATE_ROOT/framework-update.log"
FRAMEWORK_LOCK_FILE="$STATE_ROOT/framework.lock"
FRAMEWORK_LOCK_DIR="$STATE_ROOT/.framework.lock"
MIGRATION_DIR="$FRAMEWORK_ROOT/migrations"
MIGRATION_STATE_DIR="$STATE_ROOT/migrations"
MIGRATION_SKIPPED_DIR="$MIGRATION_STATE_DIR/skipped"

# Cache is invalid; apply and rollback always do a fresh authoritative clone.
# We keep a single file for status/check with a strict atomic record.
FRAMEWORK_CACHE="$CACHE_ROOT/framework-remote.cache"

# Managed framework targets replaced atomically during activation.
FRAMEWORK_TARGETS=(bin migrations docs hooks first-run.d default)
FRAMEWORK_MANAGED_FILES=(framework.json)

# Managed-derived components with backup and restore support.
# Format: component|source|shape|user_editable|safe
# Special sources (__namespace_links__, __migration_state__) are handled
# by explicit helpers, not by fictional paths in the framework root.
#
# Generated paths that AHR theme hooks and migrations write:
#   ~/.config/foot/foot.ini         (theme hook — overwrite on theme change)
#   ~/.config/chromium/             (theme hook — overwrite on theme change)
#   ~/.config/vscode/               (theme hook — overwrite on theme change)
#   ~/.config/walker/walker.css     (migration — overwrite on theme change)
#   ~/.config/waybar/style.css      (theme hook — backup-before-replace)
#   ~/.config/mako/config           (theme hook — backup-before-replace)
#   ~/.config/artix-hypr-remix/current/  (fully managed)
#   ~/.config/artix-hypr-remix/current/font.toml  (fully managed)
#
# User-edited configs (Hyprland, Waybar, Mako, terminal, shell) are NOT
# included.  Migrations that edit user files must perform backup-before-edit.
FRAMEWORK_DERIVED_COMPONENTS=(
  "framework-config|framework.json|file|false|true"
  "namespace-links|__namespace_links__|manifest|false|true"
  "migration-state|__migration_state__|state|true|true"
  "theme-state|current|directory|true|false"
)

# Components considered for the pre-activation component manifest.
# Format: component|source|shape|required|ownership|restore_policy
FRAMEWORK_COMPONENT_SNAPSHOTS=(
  "theme-state|$FRAMEWORK_ROOT/current|directory|true|framework-owned|full-replace"
  "background-state|$FRAMEWORK_ROOT/current/background|symlink|true|framework-owned|full-replace"
  "active-theme|$FRAMEWORK_ROOT/current/theme.name|file|true|framework-owned|full-replace"
  "waybar-theme|$HOME/.config/waybar/style.css|file|false|managed-derived|full-replace"
  "mako-theme|$HOME/.config/mako/config|file|false|managed-derived|full-replace"
  "terminal-theme|$HOME/.config/ghostty/config|file|false|managed-derived|full-replace"
  "foot-theme|$HOME/.config/foot/foot.ini|file|false|managed-derived|full-replace"
  "fontconfig|$HOME/.config/fontconfig/fonts.conf|file|false|managed-derived|full-replace"
  "chromium-theme|$HOME/.config/chromium/Default/Preferences|structured-file|false|managed-derived|unsupported"
  "vscode-theme|$HOME/.config/Code/User/settings.json|structured-file|false|managed-derived|unsupported"
  "cursor-theme|$HOME/.config/Cursor/User/settings.json|structured-file|false|managed-derived|unsupported"
  "opencode-theme|$HOME/.config/opencode/opencode.jsonc|structured-file|false|managed-derived|unsupported"
  "toggle-state|$STATE_ROOT/toggles|directory|false|framework-owned|unsupported"
  "compat-symlink|$HOME/.config/omarchy/current|symlink|false|framework-owned|full-replace"
)

# Required command entrypoints that must exist and be executable in the staged framework.
REQUIRED_STAGED_COMMANDS=(
  bin/ahr
  bin/ahr-update-framework
  bin/ahr-update
  bin/ahr-update-available
  bin/ahr-restore-component
  bin/namespace-install.sh
  bin/ahr-doctor
  bin/migrate.sh
  bin/ahr-validate-managed-paths.sh
)

# Required sourced libraries must be readable, but do not need executable bits.
REQUIRED_STAGED_LIBRARIES=(
  bin/ahr-lib.sh
  bin/ahr-version.sh
  bin/ahr-cache.sh
  bin/ahr-backup-helper.sh
  bin/ahr-managed-paths.sh
  bin/ahr-theme-lib.sh
  bin/ahr-toggle-lib.sh
  bin/ahr-font-lib.sh
)

lock_mode=""
signal_received=""

# ── Usage ───────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: ahr update-framework [options]

Options:
  --status     Print installed framework version and metadata (default)
  --check      Compare installed version against the remote update source
  --dry-run    Discover and validate; stop before backup or activation
  --apply      Fetch, stage, validate, backup, activate, migrate, health-check
  --rollback   Restore the previous framework version from the last backup
  --recover    Recover from an interrupted apply/rollback transaction
  --quiet      Suppress non-error output
  -h, --help   Show this help

Exit status:
  0  Success (check/dry-run found update, apply/rollback/recover succeeded)
  1  Up to date, no rollback, recovery not needed, or operation failed
  2  Invalid arguments
EOF
}

quiet=false
mode="status"
while (( $# > 0 )); do
  case "$1" in
    --check) mode="check" ;;
    --status) mode="status" ;;
    --dry-run) mode="dry-run" ;;
    --apply) mode="apply" ;;
    --rollback) mode="rollback" ;;
    --recover) mode="recover" ;;
    --quiet) quiet=true ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

# ── Output helpers ─────────────────────────────────────────────────

log() {
  if [[ "$quiet" == "false" ]]; then
    echo "$1"
  fi
}

log_line() {
  local message="$1"
  mkdir -p "$(dirname "$FRAMEWORK_LOG")"
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$message" >> "$FRAMEWORK_LOG"
}

die() {
  local message="$1"
  echo "$message" >&2
  log_line "FATAL: $message"
  exit 1
}

# This narrow, process-local hook exists solely for controlled namespace
# recovery validation. It deliberately accepts no command, path, or exit-code input.
test_fail_namespace_install=false
case "${AHR_TEST_FAIL_NAMESPACE_INSTALL:-}" in
  "") ;;
  1) test_fail_namespace_install=true ;;
  *) die "Invalid AHR_TEST_FAIL_NAMESPACE_INSTALL value: expected exactly '1' when set" ;;
esac

# This narrow, process-local hook exists solely for controlled migration
# recovery validation. It deliberately accepts no command, path, or exit-code input.
test_fail_migration=false
case "${AHR_TEST_FAIL_MIGRATION:-}" in
  "") ;;
  1) test_fail_migration=true ;;
  *) die "Invalid AHR_TEST_FAIL_MIGRATION value: expected exactly '1' when set" ;;
esac

# This narrow, process-local hook exists solely for controlled recovery
# validation. It deliberately accepts no command, path, or exit-code input.
test_fail_health_check=false
case "${AHR_TEST_FAIL_HEALTH_CHECK:-}" in
  "") ;;
  1) test_fail_health_check=true ;;
  *) die "Invalid AHR_TEST_FAIL_HEALTH_CHECK value: expected exactly '1' when set" ;;
esac

# This narrow, process-local hook exists solely for controlled pre-activation
# backup/snapshot containment validation. It deliberately accepts no command,
# path, component, or exit-code input.
test_fail_backup=false
case "${AHR_TEST_FAIL_BACKUP:-}" in
  "") ;;
  1) test_fail_backup=true ;;
  *) die "Invalid AHR_TEST_FAIL_BACKUP value: expected exactly '1' when set" ;;
esac

# These narrow, process-local hooks provide deterministic lifecycle boundaries
# for signal-validation fixtures. They do not select a signal, command, path,
# or timeout; an external fixture must deliver a real operating-system signal.
test_pause_after_backup=false
case "${AHR_TEST_PAUSE_AFTER_BACKUP:-}" in
  "") ;;
  1) test_pause_after_backup=true ;;
  *) die "Invalid AHR_TEST_PAUSE_AFTER_BACKUP value: expected exactly '1' when set" ;;
esac

test_pause_after_activation=false
case "${AHR_TEST_PAUSE_AFTER_ACTIVATION:-}" in
  "") ;;
  1) test_pause_after_activation=true ;;
  *) die "Invalid AHR_TEST_PAUSE_AFTER_ACTIVATION value: expected exactly '1' when set" ;;
esac

if [[ "$test_pause_after_backup" == "true" && "$test_pause_after_activation" == "true" ]]; then
  die "AHR_TEST_PAUSE_AFTER_BACKUP and AHR_TEST_PAUSE_AFTER_ACTIVATION cannot both be enabled"
fi

# Verify transaction helpers before allocating backup or transaction state. An
# incompatible explicit library override must fail without anonymous residue.
require_transaction_bootstrap_helpers() {
  local helper
  for helper in ahr_validate_backup_id ahr_validate_transaction_id; do
    declare -F "$helper" >/dev/null || die "Required transaction helper missing from framework library: $helper"
  done
}

# Wait indefinitely for a real external signal without adding a signal trap or
# a timeout. The child has no timeout and is used only to make Bash's existing
# signal trap interruptible; it is immediately reaped after that real signal.
# Existing production INT/TERM/HUP traps remain authoritative.
pause_for_test_signal() {
  local marker="$1" wait_pid
  log "$marker"
  log_line "$marker"
  while [[ -z "$signal_received" ]]; do
    # Do not let the indefinite waiter inherit the flock descriptor. SIGKILL
    # must release the updater lock so a fresh process can inspect persisted
    # transaction state and recover it.
    sleep 2147483647 9>&- &
    wait_pid=$!
    wait "$wait_pid" || true
  done
  kill "$wait_pid" 2>/dev/null || true
  wait "$wait_pid" 2>/dev/null || true
  return 128
}

# ── Structured state records ──────────────────────────────────────
# State is written as key=value with strict validation of values.
# No space-separated lists. No sourcing of state files.

# Required keys must be present in every valid transaction state.
TX_REQUIRED_KEYS=(txid action pid target_version staging_commit backup_dir phase completion)

# Create a new transaction with a unique ID.
# For apply: target_version=NEW version, previous_version=OLD version.
# For rollback: target_version=RESTORED version, previous_version=ROLLED_BACK version.
create_transaction() {
  local action="$1"
  local target_version="$2"
  local previous_version="$3"
  local staging_commit="$4"
  local backup_dir="$5"

  mkdir -p "$FRAMEWORK_TRANSACTIONS_DIR"
  local txid
  txid="$(mktemp -d "$FRAMEWORK_TRANSACTIONS_DIR/tx-XXXXXXXX")" || die "Failed to create transaction directory"
  local txname
  txname="$(basename "$txid")"

  # Apply transactions get their immutable backup association at creation.
  # The backup directory has already been allocated by cmd_apply, so these
  # values do not need to be inferred from timestamps or directory ordering.
  local -a association_fields=()
  if [[ "$action" == "apply" ]]; then
    local backup_id
    backup_id="$(basename "$backup_dir")"
    ahr_validate_backup_id "$backup_id" || die "Invalid apply backup ID"
    ahr_validate_transaction_id "$txname" || die "Invalid apply transaction ID"
    association_fields=(
      "backup_id=$backup_id"
      "backup_path=$backup_dir"
      "transaction_id=$txname"
    )
  fi

  write_transaction_state "$txid" \
    "format_version=1" \
    "txid=$txname" \
    "action=$action" \
    "pid=$$" \
    "target_version=$target_version" \
    "previous_version=$previous_version" \
    "staging_commit=$staging_commit" \
    "backup_dir=$backup_dir" \
    "phase=created" \
    "targets=$(IFS=,; echo "${FRAMEWORK_TARGETS[*]}")" \
    "completion=in_progress" \
    "${association_fields[@]}"

  echo "$txid"
}

# Atomically merge transaction fields into a complete state record.
# State values are one-line records; callers must not pass newlines. The parser
# never evaluates state as shell and rejects duplicate critical keys.
write_transaction_state() {
  local txdir="$1"
  shift
  local state_file="$txdir/state"
  local tmp key value line
  declare -A updates=()
  declare -A existing=()

  for line in "$@"; do
    [[ "$line" == *=* ]] || { echo "Invalid transaction update" >&2; return 1; }
    key="${line%%=*}"
    value="${line#*=}"
    [[ "$key" =~ ^[a-zA-Z0-9_.-]+$ ]] || { echo "Invalid transaction key: $key" >&2; return 1; }
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || { echo "Invalid multiline transaction value: $key" >&2; return 1; }
    updates["$key"]="$value"
  done

  if [[ -f "$state_file" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" == *=* ]] || { echo "Malformed transaction state: $state_file" >&2; return 1; }
      key="${line%%=*}"
      value="${line#*=}"
      [[ "$key" =~ ^[a-zA-Z0-9_.-]+$ ]] || { echo "Invalid transaction key: $key" >&2; return 1; }
      [[ -z "${existing[$key]+x}" ]] || { echo "Duplicate transaction key: $key" >&2; return 1; }
      existing["$key"]="$value"
    done < "$state_file"
    for key in "${TX_REQUIRED_KEYS[@]}"; do
      [[ -n "${existing[$key]+x}" ]] || { echo "Corrupt transaction missing $key" >&2; return 1; }
    done
    [[ "${existing[format_version]:-}" == "1" ]] || { echo "Unsupported transaction format" >&2; return 1; }
  fi

  for key in "${!updates[@]}"; do
    # Once present, identity fields are immutable.  Terminal transitions may
    # update status fields only; they cannot silently redirect a transaction
    # to a different backup or transaction record.
    case "$key" in
      backup_id|backup_path|transaction_id)
        if [[ -n "${existing[$key]+x}" && "${existing[$key]}" != "${updates[$key]}" ]]; then
          echo "Immutable transaction association changed: $key" >&2
          return 1
        fi
        ;;
    esac
    existing["$key"]="${updates[$key]}"
  done

  # A new-format apply state either has its complete immutable association or
  # is an older legacy record.  Do not accept partially written association
  # metadata, and never infer a value from directory ordering.
  if [[ "${existing[action]:-}" == "apply" ]] && \
     { [[ -n "${existing[backup_id]+x}" ]] || [[ -n "${existing[backup_path]+x}" ]] || [[ -n "${existing[transaction_id]+x}" ]]; }; then
    [[ -n "${existing[backup_id]+x}" && -n "${existing[backup_path]+x}" && -n "${existing[transaction_id]+x}" ]] || {
      echo "Incomplete transaction association metadata" >&2
      return 1
    }
    ahr_validate_backup_id "${existing[backup_id]}" || { echo "Invalid transaction backup_id" >&2; return 1; }
    ahr_validate_transaction_id "${existing[transaction_id]}" || { echo "Invalid transaction_id" >&2; return 1; }
    [[ "${existing[transaction_id]}" == "${existing[txid]:-}" ]] || { echo "transaction_id does not match txid" >&2; return 1; }
    [[ "${existing[backup_path]}" == "${existing[backup_dir]:-}" ]] || { echo "backup_path does not match backup_dir" >&2; return 1; }
    [[ "${existing[backup_id]}" == "$(basename "${existing[backup_path]}")" ]] || { echo "backup_id does not match backup_path" >&2; return 1; }
  fi

  tmp="$(mktemp "${state_file}.tmp.XXXXXX")"
  chmod 600 "$tmp"
  # Deterministic order aids diagnostics and tests.
  for key in format_version txid action pid target_version staging_commit backup_dir backup_id backup_path transaction_id phase completion \
    failure_reason current_target migration_exit doctor_exit log_path recovery_command targets; do
    [[ -n "${existing[$key]+x}" ]] && echo "$key=${existing[$key]}" >> "$tmp"
  done
  for key in "${!existing[@]}"; do
    case "$key" in
      format_version|txid|action|pid|target_version|staging_commit|backup_dir|backup_id|backup_path|transaction_id|phase|completion|failure_reason|current_target|migration_exit|doctor_exit|log_path|recovery_command|targets) ;;
      *) echo "$key=${existing[$key]}" >> "$tmp" ;;
    esac
  done
  mv -f "$tmp" "$state_file"
}

# Terminal successful applies must retain the exact association written at
# transaction creation and agree with the primary manifest.  This is called
# before the terminal state write so a corrupt record is never marked committed.
validate_terminal_apply_association() {
  local txdir="$1"
  local action txid backup_id backup_path backup_dir transaction_id manifest
  action="$(read_tx_field_unique "$txdir" "action" 2>/dev/null || true)"
  [[ "$action" == "apply" ]] || return 0
  txid="$(read_tx_field_unique "$txdir" "txid" 2>/dev/null || true)"
  backup_id="$(read_tx_field_unique "$txdir" "backup_id" 2>/dev/null || true)"
  backup_path="$(read_tx_field_unique "$txdir" "backup_path" 2>/dev/null || true)"
  backup_dir="$(read_tx_field_unique "$txdir" "backup_dir" 2>/dev/null || true)"
  transaction_id="$(read_tx_field_unique "$txdir" "transaction_id" 2>/dev/null || true)"
  ahr_validate_backup_id "$backup_id" || { echo "Committed apply lacks a valid backup_id" >&2; return 1; }
  ahr_validate_transaction_id "$transaction_id" || { echo "Committed apply lacks a valid transaction_id" >&2; return 1; }
  [[ "$transaction_id" == "$txid" && "$transaction_id" == "$(basename "$txdir")" ]] || { echo "Committed apply transaction ID mismatch" >&2; return 1; }
  [[ "$backup_path" == "$backup_dir" && "$backup_id" == "$(basename "$backup_path")" ]] || { echo "Committed apply backup association mismatch" >&2; return 1; }
  manifest="$backup_path/manifest.txt"
  ahr_parse_primary_manifest "$manifest" "$backup_id" true || { echo "Committed apply primary manifest association is invalid" >&2; return 1; }
  [[ "$AHR_PRIMARY_MANIFEST_BACKUP_ID" == "$backup_id" && "$AHR_PRIMARY_MANIFEST_TRANSACTION_ID" == "$transaction_id" ]] || {
    echo "Committed apply transaction and primary manifest associations differ" >&2
    return 1
  }
}

# Read a single key from a transaction state file.
read_tx_field() {
  local txdir="$1" key="$2"
  local state_file="$txdir/state"
  [[ -f "$state_file" ]] || return 1
  grep -F "${key}=" "$state_file" 2>/dev/null | head -n1 | sed -e "s/^${key}=//"
}

# Read all values for a key (one per line).
read_tx_field_all() {
  local txdir="$1" key="$2"
  local state_file="$txdir/state"
  [[ -f "$state_file" ]] || return 1
  grep -F "${key}=" "$state_file" 2>/dev/null | sed -e "s/^${key}=//"
}

# Critical association fields must appear exactly once.  This is intentionally
# separate from the permissive diagnostic reader above so transaction recovery
# never selects a value from a duplicate record.
read_tx_field_unique() {
  local txdir="$1" key="$2"
  local state_file="$txdir/state"
  [[ -f "$state_file" ]] || return 1
  awk -v key="$key" '
    index($0, key "=") == 1 { count++; value=substr($0, length(key) + 2) }
    END { if (count == 1) print value; else exit 1 }
  ' "$state_file"
}

# Mark a transaction as completed (or abandoned).
finalize_transaction() {
  local txdir="$1" status="$2" phase="$3"
  local state_file="$txdir/state"
  [[ -f "$state_file" ]] || return 0
  if [[ "$status" == "committed" ]]; then
    validate_terminal_apply_association "$txdir" || return 1
  fi
  write_transaction_state "$txdir" \
    "completion=$status" \
    "phase=$phase" \
    "completed=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
}

# ── JSON helpers (safe, no sourceing) ──────────────────────────────

# Read a string value from a JSON file.
read_json_value() {
  local json="$1" key="$2"
  if command -v jq >/dev/null 2>&1; then
    jq -r --arg k "$key" -- '.[$k] // ""' "$json" 2>/dev/null
    return 0
  fi
  sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$json" 2>/dev/null | head -n1
}

# ── Locking ─────────────────────────────────────────────────────────

cleanup_lock() {
  if [[ "$lock_mode" == "mkdir" ]]; then
    rmdir "$FRAMEWORK_LOCK_DIR" 2>/dev/null || true
  fi
}

acquire_framework_lock() {
  mkdir -p "$STATE_ROOT"
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$FRAMEWORK_LOCK_FILE"
    if ! flock -n 9; then
      echo "Another framework operation is already running." >&2
      echo "Check: $FRAMEWORK_LOCK_FILE" >&2
      exit 1
    fi
    lock_mode="flock"
    trap cleanup_lock EXIT
    return 0
  fi
  if mkdir "$FRAMEWORK_LOCK_DIR" 2>/dev/null; then
    lock_mode="mkdir"
    trap cleanup_lock EXIT
    return 0
  fi
  echo "Another framework operation is already running (stale lock: $FRAMEWORK_LOCK_DIR)." >&2
  echo "If no framework operation is active, remove the directory." >&2
  exit 1
}

# ── Path safety ────────────────────────────────────────────────────

# Validate that a path is contained under an expected root.
# Returns 0 if contained, 1 otherwise.
path_under() {
  local target="$1" root="$2"
  local real_target real_root
  real_target="$(realpath -m "$target" 2>/dev/null)" || return 1
  real_root="$(realpath -m "$root" 2>/dev/null)" || return 1
  case "$real_target" in
    "$real_root"/*|"$real_root") return 0 ;;
    *) return 1 ;;
  esac
}

# ── Migration state snapshot and restore ─────────────────────────

# Create a transaction-safe snapshot of migration state.
# Writes applied and skipped markers to temp directories, then atomically
# renames them into place.
snapshot_migration_state() {
  local snapshot_dir="$1"
  mkdir -p "$snapshot_dir"

  # Snapshot applied markers
  if [[ -d "$MIGRATION_STATE_DIR" ]]; then
    local tmp_applied
    tmp_applied="$(mktemp -d "$snapshot_dir/.applied.XXXXXX")"
    find "$MIGRATION_STATE_DIR" -maxdepth 1 -type f -exec cp -a {} "$tmp_applied/" \; 2>/dev/null || true
    mv -f "$tmp_applied" "$snapshot_dir/applied"
  else
    mkdir -p "$snapshot_dir/applied"
  fi

  # Snapshot skipped markers
  if [[ -d "$MIGRATION_SKIPPED_DIR" ]]; then
    local tmp_skipped
    tmp_skipped="$(mktemp -d "$snapshot_dir/.skipped.XXXXXX")"
    find "$MIGRATION_SKIPPED_DIR" -maxdepth 1 -type f -exec cp -a {} "$tmp_skipped/" \; 2>/dev/null || true
    mv -f "$tmp_skipped" "$snapshot_dir/skipped"
  else
    mkdir -p "$snapshot_dir/skipped"
  fi
}

# Restore migration state exactly from a snapshot.
# Uses a transactional archive-replace-commit pattern:
#   1. Validate the snapshot.
#   2. Prepare a complete replacement directory.
#   3. Archive the current marker directory.
#   4. Rename the prepared directory into place.
#   5. Remove the archive only after successful replacement.
#   6. Restore the archive on any failure.
restore_migration_state() {
  local snapshot_dir="$1"

  # Lock ordering: main update lock -> framework lock -> migration lock.
  # Rollback already owns the framework lock; acquiring the same migration
  # lock used by migrate.sh prevents concurrent marker writes.
  mkdir -p "$MIGRATION_STATE_DIR"
  if command -v flock >/dev/null 2>&1; then
    exec 8>"$MIGRATION_STATE_DIR/migrate.lock"
    flock -n 8 || { echo "Another migration run is in progress." >&2; return 1; }
  else
    mkdir "$MIGRATION_STATE_DIR/.migrate.lock" 2>/dev/null || { echo "Another migration run is in progress." >&2; return 1; }
  fi

  if [[ ! -d "$snapshot_dir" ]]; then
    die "Migration snapshot missing: $snapshot_dir"
  fi

  # Ensure migration state directory exists
  mkdir -p "$MIGRATION_STATE_DIR"

  # ── Step 1 & 2: Prepare replacement directories from snapshot ──
  local prepared_applied="" prepared_skipped=""

  if [[ -d "$snapshot_dir/applied" ]]; then
    prepared_applied="$(mktemp -d "$MIGRATION_STATE_DIR/.prepared-applied.XXXXXX")"
    find "$snapshot_dir/applied" -maxdepth 1 -type f -exec cp -a {} "$prepared_applied/" \; 2>/dev/null || {
      rm -rf "$prepared_applied"
      if ! command -v flock >/dev/null 2>&1; then
        rmdir "$MIGRATION_STATE_DIR/.migrate.lock" 2>/dev/null || true
      fi
      return 1
    }
  fi

  if [[ -d "$snapshot_dir/skipped" ]]; then
    prepared_skipped="$(mktemp -d "$MIGRATION_STATE_DIR/.prepared-skipped.XXXXXX")"
    find "$snapshot_dir/skipped" -maxdepth 1 -type f -exec cp -a {} "$prepared_skipped/" \; 2>/dev/null || {
      rm -rf "$prepared_applied" "$prepared_skipped"
      if ! command -v flock >/dev/null 2>&1; then
        rmdir "$MIGRATION_STATE_DIR/.migrate.lock" 2>/dev/null || true
      fi
      return 1
    }
  fi

  # ── Step 3: Archive current markers ──
  local archived_applied="" archived_skipped=""

  if [[ -d "$MIGRATION_STATE_DIR" ]]; then
    archived_applied="$(mktemp -d "$MIGRATION_STATE_DIR/.archived-applied.XXXXXX")"
    find "$MIGRATION_STATE_DIR" -maxdepth 1 -type f -exec cp -a {} "$archived_applied/" \; 2>/dev/null || {
      rm -rf "$prepared_applied" "$prepared_skipped" "$archived_applied"
      if ! command -v flock >/dev/null 2>&1; then
        rmdir "$MIGRATION_STATE_DIR/.migrate.lock" 2>/dev/null || true
      fi
      return 1
    }
  fi

  if [[ -d "$MIGRATION_SKIPPED_DIR" ]]; then
    archived_skipped="$(mktemp -d "$MIGRATION_STATE_DIR/.archived-skipped.XXXXXX")"
    find "$MIGRATION_SKIPPED_DIR" -maxdepth 1 -type f -exec cp -a {} "$archived_skipped/" \; 2>/dev/null || {
      rm -rf "$prepared_applied" "$prepared_skipped" "$archived_applied" "$archived_skipped"
      if ! command -v flock >/dev/null 2>&1; then
        rmdir "$MIGRATION_STATE_DIR/.migrate.lock" 2>/dev/null || true
      fi
      return 1
    }
  fi

  # ── Step 4: Rename prepared directories into place ──
  local replace_ok=true

  # Replace applied markers: clear current, rename prepared into place
  find "$MIGRATION_STATE_DIR" -maxdepth 1 -type f -delete 2>/dev/null || true
  if [[ -n "$prepared_applied" ]]; then
    local applied_files
    applied_files="$(find "$prepared_applied" -maxdepth 1 -type f 2>/dev/null | wc -l)"
    if (( applied_files > 0 )); then
      if ! cp -a "$prepared_applied"/* "$MIGRATION_STATE_DIR/" 2>/dev/null; then
        replace_ok=false
      fi
    fi
    [[ -d "$prepared_applied" ]] && rm -rf "$prepared_applied" 2>/dev/null || true
  fi

  # Replace skipped markers: clear current, rename prepared into place
  if [[ "$replace_ok" == "true" ]]; then
    mkdir -p "$MIGRATION_SKIPPED_DIR"
    find "$MIGRATION_SKIPPED_DIR" -maxdepth 1 -type f -delete 2>/dev/null || true
    if [[ -n "$prepared_skipped" ]]; then
      local skipped_files
      skipped_files="$(find "$prepared_skipped" -maxdepth 1 -type f 2>/dev/null | wc -l)"
      if (( skipped_files > 0 )); then
        if ! cp -a "$prepared_skipped"/* "$MIGRATION_SKIPPED_DIR/" 2>/dev/null; then
          replace_ok=false
        fi
      fi
      [[ -d "$prepared_skipped" ]] && rm -rf "$prepared_skipped" 2>/dev/null || true
    fi
  fi

  # ── Step 5 or 6: Commit or restore ──
  if [[ "$replace_ok" == "true" ]]; then
    # Success: remove archives
    [[ -n "$archived_applied" ]] && rm -rf "$archived_applied"
    [[ -n "$archived_skipped" ]] && rm -rf "$archived_skipped"
    if ! command -v flock >/dev/null 2>&1; then
      rmdir "$MIGRATION_STATE_DIR/.migrate.lock" 2>/dev/null || true
    fi
    return 0
  fi

  # Failure: restore from archives
  # Restore applied markers from archive
  find "$MIGRATION_STATE_DIR" -maxdepth 1 -type f -delete 2>/dev/null || true
  if [[ -n "$archived_applied" && -d "$archived_applied" ]]; then
    local restore_applied_files
    restore_applied_files="$(find "$archived_applied" -maxdepth 1 -type f 2>/dev/null | wc -l)"
    if (( restore_applied_files > 0 )); then
      cp -a "$archived_applied"/* "$MIGRATION_STATE_DIR/" 2>/dev/null || true
    fi
    rm -rf "$archived_applied" 2>/dev/null || true
  fi

  # Restore skipped markers from archive
  mkdir -p "$MIGRATION_SKIPPED_DIR"
  find "$MIGRATION_SKIPPED_DIR" -maxdepth 1 -type f -delete 2>/dev/null || true
  if [[ -n "$archived_skipped" && -d "$archived_skipped" ]]; then
    local restore_skipped_files
    restore_skipped_files="$(find "$archived_skipped" -maxdepth 1 -type f 2>/dev/null | wc -l)"
    if (( restore_skipped_files > 0 )); then
      cp -a "$archived_skipped"/* "$MIGRATION_SKIPPED_DIR/" 2>/dev/null || true
    fi
    rm -rf "$archived_skipped" 2>/dev/null || true
  fi

  # Clean up any remaining prepared directories
  [[ -n "$prepared_applied" ]] && rm -rf "$prepared_applied" 2>/dev/null || true
  [[ -n "$prepared_skipped" ]] && rm -rf "$prepared_skipped" 2>/dev/null || true

  if ! command -v flock >/dev/null 2>&1; then
    rmdir "$MIGRATION_STATE_DIR/.migrate.lock" 2>/dev/null || true
  fi
  return 1
}

# Snapshot only namespace links owned by AHR. Never copy unrelated user files
# from ~/.local/bin. Each line is link-name<TAB>target.
snapshot_namespace_links() {
  local output="$1"
  local local_bin="${AHR_LOCAL_BIN:-$HOME/.local/bin}"
  : > "$output"
  [[ -d "$local_bin" ]] || return 0
  local link target
  while IFS= read -r -d '' link; do
    target="$(readlink "$link" 2>/dev/null || true)"
    case "$target" in
      "$FRAMEWORK_ROOT/bin/"*|"$local_bin/ahr-"*|"$local_bin/omarchy-"*)
        printf '%s\t%s\n' "$(basename "$link")" "$target" >> "$output"
        ;;
    esac
  done < <(find "$local_bin" -maxdepth 1 -type l -print0 2>/dev/null || true)
}

restore_namespace_links() {
  local manifest="$1"
  local local_bin="${AHR_LOCAL_BIN:-$HOME/.local/bin}"
  [[ -f "$manifest" ]] || return 1
  mkdir -p "$local_bin"
  local name target
  while IFS=$'\t' read -r name target; do
    [[ "$name" =~ ^(ahr|omarchy)-[a-zA-Z0-9_.-]+$|^ahr$|^omarchy$ ]] || return 1
    case "$target" in
      "$FRAMEWORK_ROOT/bin/"*|"$local_bin/ahr-"*|"$local_bin/omarchy-"*) ;;
      *) return 1 ;;
    esac
    rm -f "$local_bin/$name"
    ln -s "$target" "$local_bin/$name"
  done < "$manifest"
}

# ── Authoritative staged checkout ──────────────────────────────────
# One clone per dry-run/apply operation. The commit is resolved from this
# single clone and is the authoritative commit for the entire operation.

# Create a staging directory with an authoritative checkout of the update source.
# Prints: "staging_dir<TAB>commit_sha<TAB>staged_version<TAB>staged_channel"
# Returns: 0 on success, 1 on failure.
create_staging_checkout() {
  local update_source="$1"
  local staging_dir
  staging_dir="$(mktemp -d "/tmp/ahr-staging-XXXXXXXX")"

  export GIT_TERMINAL_PROMPT=0
  local git_timeout=30
  command -v timeout >/dev/null 2>&1 || git_timeout=0

  local clone_exit=0
  if (( git_timeout > 0 )); then
    timeout "$git_timeout" git clone --quiet "$update_source" "$staging_dir" 2>/dev/null || clone_exit=$?
  else
    git clone --quiet "$update_source" "$staging_dir" 2>/dev/null || clone_exit=$?
  fi

  if (( clone_exit != 0 )); then
    rm -rf "$staging_dir"
    return 1
  fi

  local commit_sha
  commit_sha="$(git -C "$staging_dir" rev-parse HEAD 2>/dev/null)" || {
    rm -rf "$staging_dir"
    return 1
  }

  local staged_version staged_channel
  local fw_json="$staging_dir/artix-hypr-remix/config/artix-hypr-remix/framework.json"
  if [[ ! -f "$fw_json" ]]; then
    rm -rf "$staging_dir"
    return 1
  fi

  staged_version="$(read_json_value "$fw_json" "version")" || staged_version=""
  staged_channel="$(read_json_value "$fw_json" "channel")" || staged_channel=""

  if [[ -z "$staged_version" || -z "$staged_channel" ]]; then
    rm -rf "$staging_dir"
    return 1
  fi

  printf '%s\t%s\t%s\t%s\n' "$staging_dir" "$commit_sha" "$staged_version" "$staged_channel"
}

# ── Recursive staged validation ───────────────────────────────────

validate_staged_framework() {
  local staged_dir="$1"
  local expected_version="$2"
  local expected_commit="$3"
  local expected_channel="$4"

  local errors=0
  _vf_err() {
    echo "STAGED VALIDATION: $1" >&2
    errors=$((errors + 1))
  }

  _vf_path_inside_staging() {
    local candidate="$1" label="$2" rel="$3"
    local resolved
    resolved="$(readlink -f "$candidate" 2>/dev/null)" || {
      _vf_err "Broken symlink for required $label: $rel"
      return 1
    }
    case "$resolved" in
      "$staged_dir"/*) ;;
      *)
        _vf_err "Symlink for required $label escapes staging: $rel"
        return 1
        ;;
    esac
    return 0
  }

  _vf_shell_syntax_check() {
    local candidate="$1" label="$2" rel="$3"
    local shebang=""

    if [[ "$rel" == *.sh ]]; then
      if ! bash -n "$candidate" 2>/dev/null; then
        _vf_err "Shell syntax error in required $label: $rel"
      fi
      return 0
    fi

    shebang="$(head -n1 "$candidate" 2>/dev/null || true)"
    case "$shebang" in
      '#!'*'bash'|'#!'*'sh')
        if ! bash -n "$candidate" 2>/dev/null; then
          _vf_err "Shell syntax error in required $label: $rel"
        fi
        ;;
    esac
  }

  # ── Metadata validation ──
  local fw_json="$staged_dir/framework.json"
  [[ -f "$fw_json" ]] || { _vf_err "Missing framework.json"; return 1; }

  local s_version s_channel s_revision s_source
  s_version="$(read_json_value "$fw_json" "version")" || s_version=""
  s_channel="$(read_json_value "$fw_json" "channel")" || s_channel=""
  s_source="$(read_json_value "$fw_json" "update_source")" || s_source=""
  s_revision="$(read_json_value "$fw_json" "revision")" || s_revision=""

  [[ -n "$s_version" ]] || { _vf_err "Missing required field: version"; }
  [[ -n "$s_channel" ]] || { _vf_err "Missing required field: channel"; }

  if [[ -n "$s_version" ]] && ! ahr_version_validate "$s_version"; then
    _vf_err "Invalid version format: $s_version"
  fi
  if [[ -n "$s_channel" ]] && ! ahr_version_channel "$s_channel"; then
    _vf_err "Unsupported channel: $s_channel (supported: $(ahr_version_supported_channels))"
  fi
  if [[ -n "$s_version" ]] && [[ "$s_version" != "$expected_version" ]]; then
    _vf_err "Version mismatch: expected $expected_version, got $s_version"
  fi
  if [[ -n "$s_channel" ]] && [[ "$s_channel" != "$expected_channel" ]]; then
    _vf_err "Channel mismatch: expected $expected_channel, got $s_channel"
  fi
  if [[ -n "$s_revision" ]] && [[ "$s_revision" != "null" ]] && [[ "$s_revision" != "$expected_commit" ]]; then
    _vf_err "Revision mismatch: declared $s_revision, commit $expected_commit"
  fi

  # ── Required target directories ──
  local target
  for target in "${FRAMEWORK_TARGETS[@]}"; do
    if [[ ! -d "$staged_dir/$target" ]]; then
      _vf_err "Missing required directory: $target/"
    fi
  done

  # ── Required executable commands ──
  local command_rel
  for command_rel in "${REQUIRED_STAGED_COMMANDS[@]}"; do
    local command_path="$staged_dir/$command_rel"
    if [[ ! -e "$command_path" ]]; then
      _vf_err "Missing required executable command: $command_rel"
      continue
    fi
    if [[ -L "$command_path" ]]; then
      _vf_path_inside_staging "$command_path" "executable command" "$command_rel" || continue
    fi
    if [[ ! -f "$command_path" ]]; then
      _vf_err "Required executable command is not a regular file: $command_rel"
      continue
    fi
    if [[ ! -x "$command_path" ]]; then
      _vf_err "Required executable command not executable: $command_rel"
    fi
    _vf_shell_syntax_check "$command_path" "executable command" "$command_rel"
  done

  # ── Required readable sourced libraries ──
  local library_rel
  for library_rel in "${REQUIRED_STAGED_LIBRARIES[@]}"; do
    local library_path="$staged_dir/$library_rel"
    if [[ ! -e "$library_path" ]]; then
      _vf_err "Missing required sourced library: $library_rel"
      continue
    fi
    if [[ -L "$library_path" ]]; then
      _vf_path_inside_staging "$library_path" "sourced library" "$library_rel" || continue
    fi
    if [[ ! -f "$library_path" ]]; then
      _vf_err "Required sourced library is not a regular file: $library_rel"
      continue
    fi
    if [[ ! -r "$library_path" ]]; then
      _vf_err "Required sourced library not readable: $library_rel"
      continue
    fi
    _vf_shell_syntax_check "$library_path" "sourced library" "$library_rel"
  done

  # ── Recursive full-tree validation ──
  # Use null-delimited traversal. Reject special files, symlink escapes,
  # and syntax-check all shell scripts recursively.
  local entry
  while IFS= read -r -d '' entry; do
    [[ -e "$entry" ]] || continue
    local rel="${entry#$staged_dir/}"
    local etype
    etype="$(stat -c %F "$entry" 2>/dev/null || echo unknown)"

    case "$etype" in
      "symbolic link")
        local link_target
        link_target="$(readlink -f "$entry" 2>/dev/null)" || {
          _vf_err "Broken symlink: $rel"
          continue
        }
        case "$link_target" in
          "$staged_dir"/*) ;;
          *) _vf_err "Symlink escapes staging: $rel -> $link_target" ;;
        esac
        ;;
      fifo) _vf_err "FIFO in staged tree: $rel" ;;
      socket) _vf_err "Socket in staged tree: $rel" ;;
      "block special") _vf_err "Block device in staged tree: $rel" ;;
      "character special") _vf_err "Character device in staged tree: $rel" ;;
    esac
  done < <(find "$staged_dir" \( -path "*/.git" -prune -o \
    -type l -o -type p -o -type s -o -type b -o -type c \) \
    -not -path "*/.git/*" -print0 2>/dev/null || true)

  # Shell syntax check on all .sh files recursively
  while IFS= read -r -d '' shfile; do
    if ! bash -n "$shfile" 2>/dev/null; then
      _vf_err "Shell syntax error: ${shfile#$staged_dir/}"
    fi
  done < <(find "$staged_dir" \( -path "*/.git" -prune -o -type f -name '*.sh' \) \
    -not -path "*/.git/*" -print0 2>/dev/null || true)

  # Syntax check extensionless executables with shell shebang in bin/
  while IFS= read -r -d '' cmdfile; do
    [[ "$cmdfile" == *.sh ]] && continue
    [[ -L "$cmdfile" ]] && continue
    [[ ! -x "$cmdfile" ]] && continue
    local shebang
    shebang="$(head -n1 "$cmdfile" 2>/dev/null || true)"
    case "$shebang" in
      '#!'*'bash'|'#!'*'sh')
        if ! bash -n "$cmdfile" 2>/dev/null; then
          _vf_err "Shell syntax error in extensionless command: ${cmdfile#$staged_dir/}"
        fi
        ;;
    esac
  done < <(find "$staged_dir/bin" -maxdepth 1 -type f -print0 2>/dev/null || true)

  if (( errors > 0 )); then
    return 1
  fi
  return 0
}

validate_component_manifest() {
  local manifest="$1"
  [[ -f "$manifest" ]] || return 1

  local -A seen=()
  local line component="" source_path="" snapshot_path="" shape="" required="" ownership="" restore_policy="" snapshot_status=""
  local records=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      component=*) component="${line#component=}" ;;
      source_path=*) source_path="${line#source_path=}" ;;
      snapshot_path=*) snapshot_path="${line#snapshot_path=}" ;;
      shape=*) shape="${line#shape=}" ;;
      required=*) required="${line#required=}" ;;
      ownership=*) ownership="${line#ownership=}" ;;
      restore_policy=*) restore_policy="${line#restore_policy=}" ;;
      snapshot_status=*) snapshot_status="${line#snapshot_status=}" ;;
      ---)
        [[ -n "$component" && -n "$source_path" && -n "$shape" && -n "$required" && -n "$ownership" && -n "$restore_policy" && -n "$snapshot_status" ]] || return 1
        [[ -z "${seen[$component]+x}" ]] || return 1
        case "$required" in true|false) ;; *) return 1 ;; esac
        case "$snapshot_status" in present|absent|failed|unsupported) ;; *) return 1 ;; esac
        if [[ "$snapshot_status" == "present" ]]; then
          [[ -n "$snapshot_path" ]] || return 1
          [[ -e "$snapshot_path" || -L "$snapshot_path" ]] || return 1
        else
          [[ -z "$snapshot_path" ]] || return 1
        fi
        seen["$component"]=1
        records=$((records + 1))
        component="" source_path="" snapshot_path="" shape="" required="" ownership="" restore_policy="" snapshot_status=""
        ;;
      *=*) ;;
      *) [[ -z "$line" ]] || return 1 ;;
    esac
  done < "$manifest"
  [[ -z "$component$source_path$snapshot_path$shape$required$ownership$restore_policy$snapshot_status" ]] || return 1
  (( records > 0 )) || return 1
  return 0
}

# ── Transaction-based activation ──────────────────────────────────

# Prepare a target for activation: copy to a transaction-scoped temp path.
# Temp paths live INSIDE the transaction directory, never in the framework root.
prepare_target_tx() {
  local txdir="$1" target="$2" src="$3"
  local prepared_dir="$txdir/prepared/$target"
  mkdir -p "$txdir/prepared"
  cp -a "$src" "$prepared_dir" || return 1
  write_transaction_state "$txdir" "prepared_${target}=$prepared_dir" "current_target=$target"
  echo "$prepared_dir"
}

# Archive the current installed target to the transaction directory.
archive_target_tx() {
  local txdir="$1" target="$2" dst="$3"
  local archived_dir="$txdir/archived/$target"
  mkdir -p "$txdir/archived"
  if [[ -e "$dst" ]]; then
    cp -a "$dst" "$archived_dir" || return 1
  fi
  write_transaction_state "$txdir" "archived_${target}=$archived_dir" "current_target=$target"
  echo "$archived_dir"
}

# Atomically activate a prepared target into the installed location.
activate_prepared_tx() {
  local prepared="$1" dst="$2" txdir="${3:-}" target="${4:-}"
  rm -rf "$dst"
  mv -f "$prepared" "$dst"
  if [[ -n "$txdir" && -n "$target" ]]; then
    write_transaction_state "$txdir" "activated_${target}=true" "current_target=$target"
  fi
}

# Rollback all targets in reverse order using the transaction archives.
rollback_transaction() {
  local txdir="$1"
  [[ -d "$txdir/archived" ]] || return 0
  local target
  for target in "${FRAMEWORK_TARGETS[@]}"; do
    local archived="$txdir/archived/$target"
    local dst="$FRAMEWORK_ROOT/$target"
    if [[ -d "$archived" ]]; then
      rm -rf "$dst"
      mv -f "$archived" "$dst" 2>/dev/null || true
    elif [[ -e "$dst" ]]; then
      rm -rf "$dst"
    fi
  done

  # Restore managed files
  local mf
  for mf in "${FRAMEWORK_MANAGED_FILES[@]}"; do
    local archived_mf="$txdir/archived/$mf"
    local dst_mf="$FRAMEWORK_ROOT/$mf"
    if [[ -f "$archived_mf" ]]; then
      cp -a "$archived_mf" "$dst_mf"
    fi
  done
}

# ── Post-activation runtime smoke test ─────────────────────────────

# Verify that newly activated framework commands can start and load their
# libraries. Runs after activation but before namespace install, migrations,
# and doctor. A failure here stops the update, records a transaction failure,
# prevents migrations, prevents final commit, returns nonzero, and preserves
# rollback material.
smoke_test_activated_framework() {
  local fw_root="$1"
  local errors=0
  local cmd

  local smoke_commands=(
    "$fw_root/bin/ahr-update-framework --help"
    "$fw_root/bin/ahr-update-available --help"
    "$fw_root/bin/ahr-restore-component --help"
    "$fw_root/bin/namespace-install.sh --help"
    "$fw_root/bin/ahr-doctor --help"
  )

  for cmd in "${smoke_commands[@]}"; do
    local cmd_path
    cmd_path="$(echo "$cmd" | awk '{print $1}')"
    if [[ ! -f "$cmd_path" ]]; then
      echo "SMOKE FAIL: missing command: $cmd_path" >&2
      errors=$((errors + 1))
      continue
    fi
    # Skip stub commands (only shebang, no content) — these are test-only
    local line_count
    line_count="$(wc -l < "$cmd_path" 2>/dev/null || echo 0)"
    line_count="${line_count%% *}"
    if (( line_count <= 2 )); then
      continue
    fi
    local output
    output="$(bash $cmd 2>&1)" || true
    if [[ "$output" == *"No such file"* || "$output" == *"ahr-version.sh"* || "$output" == *"ahr-lib.sh"* || "$output" == *"ahr-cache.sh"* || "$output" == *"ahr-backup-helper.sh"* ]]; then
      echo "SMOKE FAIL: $cmd_path cannot load libraries: $output" >&2
      errors=$((errors + 1))
    fi
  done

  return $errors
}

# ── Signal handler for transaction safety ─────────────────────────

current_txdir=""
original_exit=0

# Signal-aware handler: triggered by EXIT, INT, TERM, HUP during apply/rollback.
# Performs reverse-order restoration from transaction archives.
signal_handler() {
  local sig="${1:-EXIT}"
  local exit_code=$?

  if [[ "$sig" == "INT" || "$sig" == "TERM" || "$sig" == "HUP" ]]; then
    signal_received="$sig"
  fi

  if [[ -n "$current_txdir" && -d "$current_txdir" ]]; then
    # Only auto-restore if activation was in progress
    local phase
    phase="$(read_tx_field "$current_txdir" "phase" 2>/dev/null || true)"
    if [[ "$phase" == "activation_in_progress" ]]; then
      echo "Signal $sig received during activation; performing reverse-order restore" >&2
      rollback_transaction "$current_txdir" 2>/dev/null || true
      finalize_transaction "$current_txdir" "interrupted" "interrupted" 2>/dev/null || true
    fi
  fi

  return $exit_code
}

# ── Status Mode ────────────────────────────────────────────────────

cmd_status() {
  if [[ ! -f "$FRAMEWORK_JSON" ]]; then
    [[ "$quiet" == "false" ]] && echo "Framework metadata not found at $FRAMEWORK_JSON"
    return 1
  fi
  local version revision channel update_source updated_at
  version="$(read_json_value "$FRAMEWORK_JSON" "version")" || version="unknown"
  revision="$(read_json_value "$FRAMEWORK_JSON" "revision")" || revision=""
  channel="$(read_json_value "$FRAMEWORK_JSON" "channel")" || channel="unknown"
  update_source="$(read_json_value "$FRAMEWORK_JSON" "update_source")" || update_source=""
  updated_at="$(read_json_value "$FRAMEWORK_JSON" "updated_at")" || updated_at="unknown"

  echo "Framework: $version"
  echo "Channel:   $channel"
  [[ -n "$revision" ]] && echo "Revision:  $revision"
  [[ -n "$update_source" ]] && echo "Source:    $update_source"
  echo "Updated:   $updated_at"
  return 0
}

# ── Check Mode ─────────────────────────────────────────────────────

cmd_check() {
  [[ -f "$FRAMEWORK_JSON" ]] || { echo "Framework metadata not found." >&2; return 1; }
  ahr_has_cmd git || { echo "git is required." >&2; return 1; }
  [[ "$quiet" == "false" ]] && echo "Checking framework update..."

  local local_version update_source
  local_version="$(read_json_value "$FRAMEWORK_JSON" "version")" || local_version=""
  update_source="$(read_json_value "$FRAMEWORK_JSON" "update_source")" || update_source=""
  [[ -z "$local_version" ]] && { echo "Could not read local version." >&2; return 1; }
  [[ -z "$update_source" ]] && { echo "No update source configured." >&2; return 1; }

  # Single authoritative checkout
  local checkout_info
  checkout_info="$(create_staging_checkout "$update_source")" || {
    echo "Failed to fetch update source: $update_source" >&2
    return 1
  }
  local staging_dir remote_commit remote_version remote_channel
  staging_dir="$(echo "$checkout_info" | cut -f1)"
  remote_commit="$(echo "$checkout_info" | cut -f2)"
  remote_version="$(echo "$checkout_info" | cut -f3)"
  remote_channel="$(echo "$checkout_info" | cut -f4)"

  # Verify the commit is still the HEAD (no moving branch)
  local verify_commit
  verify_commit="$(git -C "$staging_dir" rev-parse HEAD 2>/dev/null)"
  if [[ "$verify_commit" != "$remote_commit" ]]; then
    rm -rf "$staging_dir"
    echo "Commit changed during check." >&2
    return 1
  fi

  rm -rf "$staging_dir"

  [[ "$quiet" == "false" ]] && echo "Remote version: $remote_version (commit $remote_commit)"

  local cmp
  cmp="$(ahr_version_compare "$remote_version" "$local_version")" || {
    echo "Version comparison failed (malformed version)." >&2
    return 1
  }

  if (( cmp > 0 )); then
    [[ "$quiet" == "false" ]] && echo "Framework update available: $local_version → $remote_version"
    return 0
  elif (( cmp == 0 )); then
    # Same version: check commit
    local local_commit
    local_commit="$(read_json_value "$FRAMEWORK_JSON" "revision")" || local_commit=""
    if [[ -n "$local_commit" && "$local_commit" != "null" && "$local_commit" != "$remote_commit" ]]; then
      [[ "$quiet" == "false" ]] && echo "Same version $local_version but installed commit differs from remote. Run --apply to update."
      return 0
    fi
    [[ "$quiet" == "false" ]] && echo "Framework is up to date: $local_version"
    return 1
  else
    [[ "$quiet" == "false" ]] && echo "Local framework ($local_version) is newer than remote ($remote_version)."
    return 1
  fi
}

# ── Dry-Run Mode ───────────────────────────────────────────────────

cmd_dry_run() {
  [[ -f "$FRAMEWORK_JSON" ]] || die "Framework metadata not found at $FRAMEWORK_JSON"
  ahr_has_cmd git || die "git is required"

  local local_version update_source
  local_version="$(read_json_value "$FRAMEWORK_JSON" "version")" || local_version=""
  update_source="$(read_json_value "$FRAMEWORK_JSON" "update_source")" || update_source=""
  [[ -z "$local_version" ]] && die "Could not read local framework version"
  [[ -z "$update_source" ]] && die "No update source configured"

  log "Cloning update source and pinning commit..."
  local checkout_info
  checkout_info="$(create_staging_checkout "$update_source")" || die "Failed to clone update source"

  local staging_dir pinned_commit staged_version staged_channel
  staging_dir="$(echo "$checkout_info" | cut -f1)"
  pinned_commit="$(echo "$checkout_info" | cut -f2)"
  staged_version="$(echo "$checkout_info" | cut -f3)"
  staged_channel="$(echo "$checkout_info" | cut -f4)"

  local staged_framework="$staging_dir/artix-hypr-remix/config/artix-hypr-remix"

  # Verify the commit is still HEAD
  local verify_commit
  verify_commit="$(git -C "$staging_dir" rev-parse HEAD 2>/dev/null)"
  if [[ "$verify_commit" != "$pinned_commit" ]]; then
    rm -rf "$staging_dir"
    die "Commit changed during staging. Aborting."
  fi

  log "  Pinned commit: $pinned_commit"
  log "  Staged version: $staged_version"
  log "  Channel: $staged_channel"

  # Compare versions
  local cmp
  cmp="$(ahr_version_compare "$staged_version" "$local_version")" || {
    rm -rf "$staging_dir"
    die "Version comparison failed"
  }

  if (( cmp < 0 )); then
    log "Local framework ($local_version) is newer than remote ($staged_version). No update needed."
    rm -rf "$staging_dir"
    return 1
  fi

  # Validate staged framework
  if ! validate_staged_framework "$staged_framework" "$staged_version" "$pinned_commit" "$staged_channel"; then
    rm -rf "$staging_dir"
    die "Staged framework validation failed"
  fi

  log ""
  log "Actions that --apply would perform:"
  log "  1. Create backup at $FRAMEWORK_BACKUPS_DIR/<timestamp>-<id>/"
  log "  2. Archive installed framework targets to transaction directory"
  log "  3. Activate staged targets transactionally"
  log "  4. Restore framework.json with revision=$pinned_commit"
  log "  5. Run namespace installation (bin/namespace-install.sh)"
  log "  6. Run new migrations"
  log "  7. Run ahr-doctor health check"

  # Show pending migrations only in the new framework
  local new_only_migrations=()
  if [[ -d "$staged_framework/migrations" ]]; then
    while IFS= read -r -d '' f; do
      local mname
      mname="$(basename "$f")"
      if [[ ! -f "$MIGRATION_DIR/$mname" ]] && [[ ! -f "$MIGRATION_STATE_DIR/$mname" ]]; then
        new_only_migrations+=("$mname")
      fi
    done < <(find "$staged_framework/migrations" -maxdepth 1 -type f -name '*.sh' -print0 2>/dev/null || true)
  fi
  if (( ${#new_only_migrations[@]} > 0 )); then
    log ""
    log "  Migrations only in the new framework:"
    for m in "${new_only_migrations[@]}"; do log "    + $m"; done
  fi

  rm -rf "$staging_dir"
  return 0
}

# ── Apply Mode ─────────────────────────────────────────────────────

cmd_apply() {
  mkdir -p "$STATE_ROOT" "$FRAMEWORK_TRANSACTIONS_DIR"
  touch "$FRAMEWORK_LOG"
  acquire_framework_lock

  # Check for incomplete transactions before starting
  check_incomplete_transactions apply || die "Incomplete transaction detected. Use --recover to handle it."

  trap 'signal_handler EXIT' EXIT
  trap 'signal_handler INT' INT
  trap 'signal_handler TERM' TERM
  trap 'signal_handler HUP' HUP

  log_line "apply: starting"

  [[ -f "$FRAMEWORK_JSON" ]] || die "Framework metadata not found at $FRAMEWORK_JSON"
  local local_version local_revision update_source
  local_version="$(read_json_value "$FRAMEWORK_JSON" "version")" || local_version=""
  local_revision="$(read_json_value "$FRAMEWORK_JSON" "revision")" || local_revision=""
  update_source="$(read_json_value "$FRAMEWORK_JSON" "update_source")" || update_source=""

  [[ -z "$local_version" ]] && die "Could not read local framework version"
  [[ -z "$update_source" ]] && die "No update source configured"
  ahr_has_cmd git || die "git is required"

  log "Cloning and pinning update source..."
  local checkout_info
  checkout_info="$(create_staging_checkout "$update_source")" || die "Failed to clone update source"
  local staging_dir pinned_commit staged_version staged_channel
  staging_dir="$(echo "$checkout_info" | cut -f1)"
  pinned_commit="$(echo "$checkout_info" | cut -f2)"
  staged_version="$(echo "$checkout_info" | cut -f3)"
  staged_channel="$(echo "$checkout_info" | cut -f4)"

  # The staged framework root is inside the repo clone
  local staged_framework="$staging_dir/artix-hypr-remix/config/artix-hypr-remix"

  # Verify the commit is still HEAD
  local verify_commit
  verify_commit="$(git -C "$staging_dir" rev-parse HEAD 2>/dev/null)"
  if [[ "$verify_commit" != "$pinned_commit" ]]; then
    rm -rf "$staging_dir"
    die "Commit changed during staging. Aborting."
  fi

  log "  Commit: $pinned_commit"
  log "  Version: $staged_version"

  # Compare versions
  local cmp
  cmp="$(ahr_version_compare "$staged_version" "$local_version")" || {
    rm -rf "$staging_dir"
    die "Version comparison failed"
  }

  if (( cmp < 0 )); then
    log "Local framework is newer. Not downgrading."
    rm -rf "$staging_dir"
    return 1
  fi

  # Validate staged framework
  if ! validate_staged_framework "$staged_framework" "$staged_version" "$pinned_commit" "$staged_channel"; then
    rm -rf "$staging_dir"
    die "Staged framework validation failed"
  fi

  # Create collision-proof backup directory with timestamp prefix

  require_transaction_bootstrap_helpers
  mkdir -p "$FRAMEWORK_BACKUPS_DIR"
  local backup_ts
  backup_ts="$(date +%Y%m%d-%H%M%S)"
  local backup_dir backup_id
  backup_dir="$(mktemp -d "$FRAMEWORK_BACKUPS_DIR/${backup_ts}-XXXXXX")" || \
    die "Failed to create backup directory"
  backup_id="$(basename "$backup_dir")"

  # Create transaction
  local txdir transaction_id
  txdir="$(create_transaction "apply" "$staged_version" "$local_version" "$pinned_commit" "$backup_dir")"
  transaction_id="$(basename "$txdir")"
  current_txdir="$txdir"
  write_transaction_state "$txdir" "phase=backup_in_progress"

  log "Backing up to: $backup_dir"

  # Backup framework targets and managed files
  local target
  for target in "${FRAMEWORK_TARGETS[@]}"; do
    if [[ -e "$FRAMEWORK_ROOT/$target" ]]; then
      cp -a "$FRAMEWORK_ROOT/$target" "$backup_dir/$target"
    fi
  done
  local mf
  for mf in "${FRAMEWORK_MANAGED_FILES[@]}"; do
    if [[ -f "$FRAMEWORK_ROOT/$mf" ]]; then
      cp -a "$FRAMEWORK_ROOT/$mf" "$backup_dir/$mf"
    fi
  done

  # Snapshot migration state
  snapshot_migration_state "$backup_dir/migration-snapshot"

  # Backup managed-derived components
  local comp
  for comp in "${FRAMEWORK_DERIVED_COMPONENTS[@]}"; do
    local comp_name comp_subpath comp_shape
    comp_name="$(echo "$comp" | cut -d'|' -f1)"
    comp_subpath="$(echo "$comp" | cut -d'|' -f2)"
    comp_shape="$(echo "$comp" | cut -d'|' -f3)"
    case "$comp_shape" in
      file)
        [[ -f "$FRAMEWORK_ROOT/$comp_subpath" ]] && cp -a "$FRAMEWORK_ROOT/$comp_subpath" "$backup_dir/derived-$comp_name"
        ;;
      directory)
        [[ -d "$FRAMEWORK_ROOT/$comp_subpath" ]] && cp -a "$FRAMEWORK_ROOT/$comp_subpath" "$backup_dir/derived-$comp_name"
        ;;
      manifest)
        snapshot_namespace_links "$backup_dir/derived-$comp_name"
        ;;
      state)
        # Migration state is already captured in migration-snapshot; record a
        # pointer file rather than duplicating or confusing it with scripts.
        printf '%s\n' "migration-snapshot" > "$backup_dir/derived-$comp_name"
        ;;
    esac
  done

  # Write manifest atomically — initially NOT completed
  local manifest_tmp
  manifest_tmp="$(mktemp "$backup_dir/.manifest.tmp.XXXXXX")"
  {
    echo "manifest_version=1"
    echo "completed=in_progress"
    echo "backup_id=$backup_id"
    echo "transaction_id=$transaction_id"
    echo "previous_version=$local_version"
    echo "previous_revision=$local_revision"
    echo "new_version=$staged_version"
    echo "staging_commit=$pinned_commit"
    echo "channel=$staged_channel"
    echo "update_source=$update_source"
    echo "timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
    echo "backup_dir=$backup_dir"
    echo "targets=$(printf '%s\n' "${FRAMEWORK_TARGETS[@]}")"
    echo "managed_files=$(printf '%s\n' "${FRAMEWORK_MANAGED_FILES[@]}")"
    echo "derived_components=$(printf '%s\n' "${FRAMEWORK_DERIVED_COMPONENTS[@]}")"
    echo "migration_snapshot=$backup_dir/migration-snapshot"
  } > "$manifest_tmp"
  mv -f "$manifest_tmp" "$backup_dir/manifest.txt"

  # Snapshot managed derived components before activation
  log "Snapshotting managed components..."
  local _snap_errors=0
  local _required_snap_errors=0
  local _snap_entry _snap_component _snap_source _snap_shape _snap_required _snap_ownership _snap_restore_policy
  for _snap_entry in "${FRAMEWORK_COMPONENT_SNAPSHOTS[@]}"; do
    IFS='|' read -r _snap_component _snap_source _snap_shape _snap_required _snap_ownership _snap_restore_policy <<< "$_snap_entry"
    if ! ahr_snapshot_component "$_snap_component" "$_snap_source" "$backup_dir" "$_snap_shape" \
      "$_snap_required" "$_snap_ownership" "$_snap_restore_policy"; then
      _snap_errors=$((_snap_errors + 1))
      [[ "$_snap_required" == "true" ]] && _required_snap_errors=$((_required_snap_errors + 1))
    fi
  done

  # Exercise the ordinary required-snapshot failure finalizer only after the
  # production backup machinery has created its in-progress evidence. This is
  # validation-only: it is process-local, never selects a component or path,
  # and runs before the completed primary manifest or activation.
  local injected_backup_failure=false
  if [[ "$test_fail_backup" == "true" ]]; then
    injected_backup_failure=true
    _required_snap_errors=$((_required_snap_errors + 1))
    log "TEST FAULT: forcing backup failure"
    log_line "TEST FAULT: forcing backup failure"
  fi

  # Required snapshot failures must prevent activation
  if (( _required_snap_errors > 0 )); then
    log "Error: $_required_snap_errors required component snapshots failed"
    rollback_transaction "$txdir"
    if [[ "$injected_backup_failure" == "true" ]]; then
      write_transaction_state "$txdir" "failure_reason=test_fault_forced_backup_failure"
    fi
    finalize_transaction "$txdir" "failed" "snapshot_failed"
    rm -rf "$staging_dir"
    die "Required snapshot failed. Backup state preserved at: $backup_dir"
  fi

  if (( _snap_errors > 0 )); then
    log "Warning: $_snap_errors component snapshots failed (non-required)"
  fi

  if ! validate_component_manifest "$backup_dir/component-manifest.txt"; then
    rollback_transaction "$txdir"
    finalize_transaction "$txdir" "failed" "component_manifest_invalid"
    rm -rf "$staging_dir"
    die "Component manifest validation failed. Backup state preserved at: $backup_dir"
  fi

  # Atomically write the final completed manifest AFTER all required snapshots succeed
  local final_manifest_tmp
  final_manifest_tmp="$(mktemp "$backup_dir/.manifest.tmp.XXXXXX")"
  {
    echo "manifest_version=1"
    echo "completed=true"
    echo "backup_id=$backup_id"
    echo "transaction_id=$transaction_id"
    echo "previous_version=$local_version"
    echo "previous_revision=$local_revision"
    echo "new_version=$staged_version"
    echo "staging_commit=$pinned_commit"
    echo "channel=$staged_channel"
    echo "update_source=$update_source"
    echo "timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
    echo "backup_dir=$backup_dir"
    echo "targets=$(printf '%s\n' "${FRAMEWORK_TARGETS[@]}")"
    echo "managed_files=$(printf '%s\n' "${FRAMEWORK_MANAGED_FILES[@]}")"
    echo "derived_components=$(printf '%s\n' "${FRAMEWORK_DERIVED_COMPONENTS[@]}")"
    echo "migration_snapshot=$backup_dir/migration-snapshot"
    echo "snapshot_errors=$_snap_errors"
    echo "required_snapshot_errors=$_required_snap_errors"
  } > "$final_manifest_tmp"
  mv -f "$final_manifest_tmp" "$backup_dir/manifest.txt"

  # The completed manifest and all required snapshots now exist; activation
  # has not begun. This is a deterministic validation-only signal boundary.
  if [[ "$test_pause_after_backup" == "true" ]]; then
    pause_for_test_signal "TEST PAUSE: after backup, before activation"
  fi

  write_transaction_state "$txdir" "phase=activation_in_progress"
  log "Activating framework $staged_version..."

  # Archive installed targets to transaction directory
  for target in "${FRAMEWORK_TARGETS[@]}"; do
    archive_target_tx "$txdir" "$target" "$FRAMEWORK_ROOT/$target" >/dev/null || {
      rollback_transaction "$txdir"
      finalize_transaction "$txdir" "failed" "failed"
      rm -rf "$staging_dir"
      die "Failed to archive $target/"
    }
  done

  # Archive managed files
  for mf in "${FRAMEWORK_MANAGED_FILES[@]}"; do
    archive_target_tx "$txdir" "$mf" "$FRAMEWORK_ROOT/$mf" >/dev/null 2>&1 || true
  done

  # Prepare and activate each target
  local activation_ok=true
  for target in "${FRAMEWORK_TARGETS[@]}"; do
    if [[ -d "$staged_framework/$target" ]]; then
      local prepared
      prepared="$(prepare_target_tx "$txdir" "$target" "$staged_framework/$target")" || {
        activation_ok=false
        break
      }
      activate_prepared_tx "$prepared" "$FRAMEWORK_ROOT/$target" "$txdir" "$target" || {
        activation_ok=false
        break
      }
    fi
  done

  if [[ "$activation_ok" == "false" ]]; then
    rollback_transaction "$txdir"
    finalize_transaction "$txdir" "failed" "activation_failed"
    rm -rf "$staging_dir"
    die "Activation failed. Original framework restored."
  fi

  # Activate managed files
  for mf in "${FRAMEWORK_MANAGED_FILES[@]}"; do
    if [[ -f "$staged_framework/$mf" ]]; then
      cp -a "$staged_framework/$mf" "$FRAMEWORK_ROOT/$mf"
    fi
  done

  # Update framework.json with new revision
  if command -v jq >/dev/null 2>&1; then
    local now_iso
    now_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
    if [[ -n "$now_iso" ]]; then
      local tmp_json
      tmp_json="$(mktemp)"
      if jq --arg ts "$now_iso" --arg rev "$pinned_commit" --arg ver "$staged_version" \
        '.updated_at = $ts | .revision = $rev | .version = $ver' \
        "$FRAMEWORK_JSON" > "$tmp_json" 2>/dev/null; then
        mv -f "$tmp_json" "$FRAMEWORK_JSON"
      else
        rm -f "$tmp_json"
      fi
    fi
  fi

  rm -rf "$staging_dir"

  # All replacement targets and framework metadata are active, but namespace
  # installation and every later successor phase remain untouched.
  if [[ "$test_pause_after_activation" == "true" ]]; then
    pause_for_test_signal "TEST PAUSE: after activation, before namespace installation"
  fi

  # Step 5: Run namespace installation from newly activated framework
  write_transaction_state "$txdir" "phase=namespace_install"
  log "Running namespace installation..."

  local namespace_exit=0
  local injected_namespace_failure=false
  local namespace_installer="$FRAMEWORK_ROOT/bin/namespace-install.sh"
  if [[ -f "$namespace_installer" ]]; then
    local namespace_output
    namespace_output="$(bash "$namespace_installer" --quiet 2>&1)" || namespace_exit=$?
    [[ "$quiet" == "false" && -n "$namespace_output" ]] && echo "$namespace_output" | sed 's/^/  /'
  fi

  # Require the real namespace installer to succeed before this narrow hook
  # exercises the ordinary production namespace-failure finalizer.
  if (( namespace_exit == 0 )) && [[ "$test_fail_namespace_install" == "true" ]]; then
    injected_namespace_failure=true
    log "TEST FAULT: forcing namespace-install failure"
    log_line "TEST FAULT: forcing namespace-install failure"
    namespace_exit=1
  fi

  if (( namespace_exit != 0 )); then
    local _apply_backup _apply_commit
    local failure_reason="namespace_exit_$namespace_exit"
    [[ "$injected_namespace_failure" == "true" ]] && failure_reason="test_fault_forced_namespace_install_failure"
    _apply_backup="$(read_tx_field "$txdir" "backup_dir" 2>/dev/null || true)"
    _apply_commit="$(read_tx_field "$txdir" "staging_commit" 2>/dev/null || true)"
    write_transaction_state "$txdir" \
      "phase=namespace_failed" \
      "completion=namespace_failed" \
      "backup_dir=$_apply_backup" \
      "staging_commit=$_apply_commit" \
      "namespace_exit=$namespace_exit" \
      "failure_reason=$failure_reason" \
      "recovery_command=ahr update-framework --rollback"
    log "Namespace installation failed (exit $namespace_exit). Migrations and doctor were not run."
    log "Use --rollback to restore the previous framework."
    current_txdir=""
    return 1
  fi

  # Step 5.5: Post-namespace runtime smoke test
  write_transaction_state "$txdir" "phase=runtime_smoke"
  log "Running post-activation runtime smoke test..."
  if ! smoke_test_activated_framework "$FRAMEWORK_ROOT"; then
    rollback_transaction "$txdir"
    finalize_transaction "$txdir" "failed" "runtime_smoke_failed"
    log "Runtime smoke test failed. Framework rolled back."
    log "Use --rollback to restore the previous framework."
    current_txdir=""
    return 1
  fi
  log "Runtime smoke test passed."

  # Record applied markers before migration
  local pre_migrate_snapshot
  pre_migrate_snapshot="$(mktemp -d)"
  find "$MIGRATION_STATE_DIR" -maxdepth 1 -type f -name '*.sh' -exec cp {} "$pre_migrate_snapshot/" \; 2>/dev/null || true

  write_transaction_state "$txdir" "phase=migration"
  log "Running migrations..."

  local migration_exit=0
  local injected_migration_failure=false
  local migration_runner="$FRAMEWORK_ROOT/bin/migrate.sh"
  if [[ -f "$migration_runner" ]]; then
    local migration_output
    migration_output="$(bash "$migration_runner" --non-interactive 2>&1)" || migration_exit=$?
    [[ "$quiet" == "false" && -n "$migration_output" ]] && echo "$migration_output" | sed 's/^/  /'
  fi

  # Run the ordinary migration phase first, including its no-op result, then
  # exercise the same production migration-failure finalizer used on error.
  if [[ "$test_fail_migration" == "true" ]]; then
    injected_migration_failure=true
    log "TEST FAULT: forcing migration failure"
    log_line "TEST FAULT: forcing migration failure"
    migration_exit=1
  fi

  if (( migration_exit != 0 )); then
    # Determine which markers were introduced
    local added_markers=""
    while IFS= read -r -d '' f; do
      local mname
      mname="$(basename "$f")"
      if [[ ! -f "$pre_migrate_snapshot/$mname" ]]; then
        added_markers+="${added_markers:+$'\n'}${mname}"
      fi
    done < <(find "$MIGRATION_STATE_DIR" -maxdepth 1 -type f -name '*.sh' -print0 2>/dev/null || true)
    rm -rf "$pre_migrate_snapshot"

    # Record added markers in both transaction state and backup manifest
    local added_markers_record
    added_markers_record="$(printf '%s' "$added_markers" | tr '\n' '|')"
    local _apply_backup _apply_commit
    local failure_reason="migration_exit_$migration_exit"
    [[ "$injected_migration_failure" == "true" ]] && failure_reason="test_fault_forced_migration_failure"
    _apply_backup="$(read_tx_field "$txdir" "backup_dir" 2>/dev/null || true)"
    _apply_commit="$(read_tx_field "$txdir" "staging_commit" 2>/dev/null || true)"
    write_transaction_state "$txdir" \
      "phase=migration_failed" \
      "completion=migration_failed" \
      "backup_dir=$_apply_backup" \
      "staging_commit=$_apply_commit" \
      "added_markers=$added_markers_record" \
      "migration_exit=$migration_exit" \
      "failure_reason=$failure_reason" \
      "recovery_command=ahr update-framework --recover"
    # Add added_markers to manifest (one per line)
    local mf_tmp
    mf_tmp="$(mktemp "$backup_dir/.manifest.tmp.XXXXXX")"
    grep -v -F 'added_markers=' "$backup_dir/manifest.txt" > "$mf_tmp" || true
    echo "added_markers=$added_markers_record" >> "$mf_tmp"
    mv -f "$mf_tmp" "$backup_dir/manifest.txt"

    log "Migration failed (exit $migration_exit). Framework activated but migrations incomplete."
    log "Use --recover or --rollback to handle."
    current_txdir=""
    return 1
  fi

  # Compute added markers
  local added_markers=""
  while IFS= read -r -d '' f; do
    local mname
    mname="$(basename "$f")"
    if [[ ! -f "$pre_migrate_snapshot/$mname" ]]; then
      added_markers+="${added_markers:+$'\n'}${mname}"
    fi
  done < <(find "$MIGRATION_STATE_DIR" -maxdepth 1 -type f -name '*.sh' -print0 2>/dev/null || true)
  rm -rf "$pre_migrate_snapshot"

  local added_markers_record
  added_markers_record="$(printf '%s' "$added_markers" | tr '\n' '|')"
  local _hb _hc
  _hb="$(read_tx_field "$txdir" "backup_dir" 2>/dev/null || true)"
  _hc="$(read_tx_field "$txdir" "staging_commit" 2>/dev/null || true)"
  write_transaction_state "$txdir" "phase=health_check" "backup_dir=$_hb" "staging_commit=$_hc" "added_markers=$added_markers_record"
  # Update manifest with added_markers
  local mf_tmp2
  mf_tmp2="$(mktemp "$backup_dir/.manifest.tmp.XXXXXX")"
  grep -v -F 'added_markers=' "$backup_dir/manifest.txt" > "$mf_tmp2" || true
  echo "added_markers=$added_markers_record" >> "$mf_tmp2"
  mv -f "$mf_tmp2" "$backup_dir/manifest.txt"

  log "Running health checks..."
  local doctor_exit=0
  local doctor_cmd="$FRAMEWORK_ROOT/bin/ahr-doctor"
  if [[ -f "$doctor_cmd" ]]; then
    local doctor_output
    doctor_output="$(bash "$doctor_cmd" 2>&1)" || doctor_exit=$?
    [[ "$quiet" == "false" ]] && echo "$doctor_output"
  else
    doctor_exit=1
  fi

  # Keep the real doctor execution above, then use the normal health-failure
  # finalizer below for a controlled post-activation validation fault.
  local injected_health_failure=false
  if [[ "$test_fail_health_check" == "true" ]]; then
    injected_health_failure=true
    log "TEST FAULT: forcing post-activation health-check failure"
    log_line "TEST FAULT: forcing post-activation health-check failure"
    doctor_exit=1
  fi

  local health_status="pass"
  (( doctor_exit != 0 )) && health_status="activated_but_unhealthy"

  local final_phase="complete"
  (( doctor_exit != 0 )) && final_phase="health_check_failed"

  if (( doctor_exit != 0 )); then
    local _apply_backup _apply_commit
    local failure_reason="doctor_exit_$doctor_exit"
    [[ "$injected_health_failure" == "true" ]] && failure_reason="test_fault_forced_health_check_failure"
    _apply_backup="$(read_tx_field "$txdir" "backup_dir" 2>/dev/null || true)"
    _apply_commit="$(read_tx_field "$txdir" "staging_commit" 2>/dev/null || true)"
    write_transaction_state "$txdir" \
      "phase=health_check_failed" \
      "completion=health_check_failed" \
      "backup_dir=$_apply_backup" \
      "staging_commit=$_apply_commit" \
      "doctor_exit=$doctor_exit" \
      "failure_reason=$failure_reason" \
      "recovery_command=ahr update-framework --recover"
  else
    finalize_transaction "$txdir" "committed" "$final_phase"
  fi

  # Invalidate cache
  invalidate_cache "$FRAMEWORK_CACHE"

  if (( doctor_exit != 0 )); then
    log ""
    log "Framework updated but health checks reported issues."
    log "Phase: $final_phase | Health: $health_status"
    log "Use --recover or --rollback to handle."
    current_txdir=""
    return 1
  fi

  log ""
  log "Framework successfully updated: $local_version → $staged_version"
  current_txdir=""
  return 0
}

# ── Rollback Mode ──────────────────────────────────────────────────

cmd_rollback() {
  mkdir -p "$STATE_ROOT" "$FRAMEWORK_TRANSACTIONS_DIR"
  touch "$FRAMEWORK_LOG"
  acquire_framework_lock

  check_incomplete_transactions rollback || die "Incomplete transaction detected. Use --recover to handle it."

  trap 'signal_handler EXIT' EXIT
  trap 'signal_handler INT' INT
  trap 'signal_handler TERM' TERM
  trap 'signal_handler HUP' HUP

  log_line "rollback: starting"

  # A failed apply has an explicit transaction→backup association.  Resolve
  # that exact backup before considering a standalone completed backup.
  local latest_backup="" explicit_apply_tx=""
  explicit_apply_tx="$(find_unresolved_apply_tx)" || die "Unable to determine a unique failed apply transaction"
  if [[ -n "$explicit_apply_tx" ]]; then
    latest_backup="$(read_tx_field_unique "$explicit_apply_tx" "backup_dir")" || die "Failed apply transaction has ambiguous backup_dir"
  fi

  # Without an unresolved apply transaction, rollback remains a standalone
  # explicit user operation over the completed backup inventory.
  local latest_ts=0
  local bd
  if [[ -z "$latest_backup" ]]; then
    for bd in "$FRAMEWORK_BACKUPS_DIR"/*/; do
      [[ -f "$bd/manifest.txt" ]] || continue
      local mt
      mt="$(grep -F 'completed=' "$bd/manifest.txt" 2>/dev/null | head -n1 | cut -d= -f2-)"
      [[ "$mt" == "true" ]] || continue
      local ts
      ts="$(stat -c %Y "$bd" 2>/dev/null || echo 0)"
      if (( ts > latest_ts )); then
        latest_ts=$ts
        latest_backup="${bd%/}"
      fi
    done
  fi

  [[ -z "$latest_backup" ]] && die "No valid backup found. Cannot rollback."

  # Validate backup path containment
  if ! path_under "$latest_backup" "$FRAMEWORK_BACKUPS_DIR"; then
    die "Backup path is outside expected backup root"
  fi

  log "Validating backup: $latest_backup"

  # Prevalidate EVERYTHING before any mutation
  local manifest="$latest_backup/manifest.txt"
  [[ -f "$manifest" ]] || die "Backup manifest missing"
  ahr_parse_primary_manifest "$manifest" "$(basename "$latest_backup")" true || die "Invalid backup manifest association metadata"

  local mf_version
  mf_version="$(grep -F 'manifest_version=' "$manifest" | head -n1 | cut -d= -f2-)"
  [[ "$mf_version" == "1" ]] || die "Unsupported manifest version: $mf_version"

  local mf_completed
  mf_completed="$(grep -F 'completed=' "$manifest" | head -n1 | cut -d= -f2-)"
  [[ "$mf_completed" == "true" ]] || die "Backup manifest incomplete"

  # Verify all required targets exist in backup
  local target
  for target in "${FRAMEWORK_TARGETS[@]}"; do
    [[ -d "$latest_backup/$target" ]] || die "Backup missing required target: $target/"
  done
  for mf in "${FRAMEWORK_MANAGED_FILES[@]}"; do
    [[ -f "$latest_backup/$mf" ]] || die "Backup missing required file: $mf"
  done

  # Verify migration snapshots
  [[ -d "$latest_backup/migration-snapshot" ]] || die "Backup missing migration snapshot"
  [[ -d "$latest_backup/migration-snapshot/applied" ]] || die "Backup missing applied migration snapshot"
  [[ -d "$latest_backup/migration-snapshot/skipped" ]] || die "Backup missing skipped migration snapshot"

  # Read backup metadata
  local prev_version prev_revision prev_channel prev_source
  prev_version="$(grep -F 'previous_version=' "$manifest" | head -n1 | cut -d= -f2-)"
  prev_revision="$(grep -F 'previous_revision=' "$manifest" | head -n1 | cut -d= -f2-)"
  prev_channel="$(grep -F 'channel=' "$manifest" | head -n1 | cut -d= -f2-)"
  prev_source="$(grep -F 'update_source=' "$manifest" | head -n1 | cut -d= -f2-)"

  local current_version
  current_version="$(read_json_value "$FRAMEWORK_JSON" "version")" || current_version="unknown"

  log "Prevalidation passed. Restoring framework..."

  # Validate managed component snapshots if present
  local _snap_manifest="$latest_backup/component-manifest.txt"
  if [[ -f "$_snap_manifest" ]]; then
    log "Validating component snapshots..."
    local _snap_line _snap_comp _snap_status _snap_required
    while IFS= read -r _snap_line || [[ -n "$_snap_line" ]]; do
      case "$_snap_line" in
        component=*) _snap_comp="${_snap_line#component=}" ;;
        required=*) _snap_required="${_snap_line#required=}" ;;
        snapshot_status=*) _snap_status="${_snap_line#snapshot_status=}" ;;
        ---)
          if [[ -n "$_snap_comp" && "$_snap_status" == "failed" ]]; then
            die "Component snapshot failed: $_snap_comp — cannot rollback"
          fi
          if [[ -n "$_snap_comp" && "$_snap_required" == "true" && "$_snap_status" != "present" ]]; then
            die "Required component snapshot missing: $_snap_comp — cannot rollback"
          fi
          _snap_comp="" _snap_status="" _snap_required="" ;;
      esac
    done < "$_snap_manifest"
  fi

  # Find the failed apply transaction that created this backup
  local failed_apply_tx="$explicit_apply_tx"
  if [[ -z "$failed_apply_tx" ]]; then
    failed_apply_tx="$(find_resolved_apply_tx "$latest_backup" "$AHR_PRIMARY_MANIFEST_TRANSACTION_ID")" || die "Invalid failed-apply transaction association"
  fi

  # If a failed apply exists, validate the tie
  if [[ -n "$failed_apply_tx" ]]; then
    local apply_backup apply_prev apply_commit apply_txid
    apply_backup="$(read_tx_field_unique "$failed_apply_tx" "backup_dir")" || die "Failed-apply transaction has ambiguous backup_dir"
    apply_prev="$(grep -F 'previous_version=' "$failed_apply_tx/state" | head -n1 | cut -d= -f2-)"
    apply_commit="$(grep -F 'staging_commit=' "$failed_apply_tx/state" | head -n1 | cut -d= -f2-)"
    apply_txid="$(basename "$failed_apply_tx")"

    if [[ "$apply_backup" != "$latest_backup" ]]; then
      die "Failed-apply transaction backup ($apply_backup) does not match rollback backup ($latest_backup)"
    fi
    ahr_parse_primary_manifest "$manifest" "$(basename "$latest_backup")" true || die "Invalid transaction backup association"
    [[ "$AHR_PRIMARY_MANIFEST_TRANSACTION_ID" == "$apply_txid" ]] || die "Backup manifest transaction_id does not match failed apply transaction"
    if [[ "$apply_prev" != "$prev_version" ]]; then
      die "Failed-apply previous version ($apply_prev) does not match manifest ($prev_version)"
    fi
    if [[ -n "$prev_revision" && "$prev_revision" != "null" && "$apply_commit" != "$prev_revision" ]]; then
      die "Failed-apply commit ($apply_commit) does not match manifest revision ($prev_revision)"
    fi
    log "Rollback is resolving failed apply transaction: $(basename "$failed_apply_tx")"
  fi

  # Create transaction for the rollback
  local txdir
  txdir="$(create_transaction "rollback" "$prev_version" "$current_version" "$prev_revision" "$latest_backup")"
  current_txdir="$txdir"
  # Link the rollback to the failed apply if found
  if [[ -n "$failed_apply_tx" ]]; then
    write_transaction_state "$txdir" \
      "phase=rollback_in_progress" \
      "resolved_apply_txid=$(basename "$failed_apply_tx")" \
      "resolved_apply_backup=$apply_backup"
  else
    write_transaction_state "$txdir" "phase=rollback_in_progress"
  fi

  # Archive current installed targets
  for target in "${FRAMEWORK_TARGETS[@]}"; do
    archive_target_tx "$txdir" "$target" "$FRAMEWORK_ROOT/$target" >/dev/null 2>&1 || true
  done
  for mf in "${FRAMEWORK_MANAGED_FILES[@]}"; do
    archive_target_tx "$txdir" "$mf" "$FRAMEWORK_ROOT/$mf" >/dev/null 2>&1 || true
  done

  # Restore targets from backup
  local rollback_ok=true
  for target in "${FRAMEWORK_TARGETS[@]}"; do
    if [[ -d "$latest_backup/$target" ]]; then
      log "  Restoring: $target/"
      rm -rf "$FRAMEWORK_ROOT/$target"
      cp -a "$latest_backup/$target" "$FRAMEWORK_ROOT/$target" || {
        log "  Failed to restore: $target/"
        rollback_ok=false
        break
      }
    fi
  done

  if [[ "$rollback_ok" == "false" ]]; then
    rollback_transaction "$txdir"
    finalize_transaction "$txdir" "failed" "rollback_failed"
    die "Rollback failed during target restore. Original backup at: $latest_backup"
  fi

  # Restore managed files
  for mf in "${FRAMEWORK_MANAGED_FILES[@]}"; do
    if [[ -f "$latest_backup/$mf" ]]; then
      log "  Restored: $mf"
      cp -a "$latest_backup/$mf" "$FRAMEWORK_ROOT/$mf"
    fi
  done

  # Restore migration state EXACTLY from snapshot
  restore_migration_state "$latest_backup/migration-snapshot" || {
    rollback_transaction "$txdir"
    finalize_transaction "$txdir" "failed" "rollback_failed"
    die "Failed to restore migration state"
  }

  log "Framework files and migration state restored"

  # Restore managed-derived components
  for comp in "${FRAMEWORK_DERIVED_COMPONENTS[@]}"; do
    local comp_name comp_subpath comp_shape
    comp_name="$(echo "$comp" | cut -d'|' -f1)"
    comp_subpath="$(echo "$comp" | cut -d'|' -f2)"
    comp_shape="$(echo "$comp" | cut -d'|' -f3)"
    case "$comp_shape" in
      file)
        [[ -f "$latest_backup/derived-$comp_name" ]] || die "Backup missing component file: $comp_name"
        cp -a "$latest_backup/derived-$comp_name" "$FRAMEWORK_ROOT/$comp_subpath"
        ;;
      directory)
        [[ -d "$latest_backup/derived-$comp_name" ]] || continue
        rm -rf "$FRAMEWORK_ROOT/$comp_subpath"
        cp -a "$latest_backup/derived-$comp_name" "$FRAMEWORK_ROOT/$comp_subpath"
        ;;
      manifest)
        [[ -f "$latest_backup/derived-$comp_name" ]] || die "Backup missing namespace manifest"
        restore_namespace_links "$latest_backup/derived-$comp_name" || die "Failed to restore namespace links"
        ;;
      state)
        : # Restored by restore_migration_state above.
        ;;
    esac
  done

  # Run post-rollback health check
  write_transaction_state "$txdir" "phase=health_check"
  log "Running health checks..."
  local doctor_exit=0
  local doctor_cmd="$FRAMEWORK_ROOT/bin/ahr-doctor"
  if [[ -f "$doctor_cmd" ]]; then
    local doctor_output
    doctor_output="$(bash "$doctor_cmd" 2>&1)" || doctor_exit=$?
    [[ "$quiet" == "false" ]] && echo "$doctor_output"
  else
    doctor_exit=1
  fi

  local health_status="pass"
  (( doctor_exit != 0 )) && health_status="rollback_unhealthy"

  local final_phase="rollback_complete"
  (( doctor_exit != 0 )) && final_phase="rollback_failed"

  if (( doctor_exit != 0 )); then
    write_transaction_state "$txdir" \
      "phase=health_check_failed" \
      "completion=health_check_failed" \
      "doctor_exit=$doctor_exit" \
      "failure_reason=rollback_doctor_exit_$doctor_exit"
  else
    finalize_transaction "$txdir" "rolled_back" "$final_phase"
  fi
  invalidate_cache "$FRAMEWORK_CACHE"

  if (( doctor_exit != 0 )); then
    log "Rollback completed but health checks reported issues."
    current_txdir=""
    return 1
  fi

  # Mark the resolved apply transaction as terminal
  if [[ -n "$failed_apply_tx" ]]; then
    finalize_transaction "$failed_apply_tx" "resolved_by_rollback" "resolved_by_rollback"
    log "Original failed apply resolved by rollback: $(basename "$failed_apply_tx")"
  fi

  log "Framework rolled back: → $prev_version"
  current_txdir=""
  return 0
}

# ── Recover Mode ───────────────────────────────────────────────────

# Resolve only the transaction explicitly named by a new-format primary
# manifest.  There is deliberately no timestamp or directory-order fallback.
find_resolved_apply_tx() {
  local backup_dir="$1" transaction_id="$2"
  [[ -d "$FRAMEWORK_TRANSACTIONS_DIR" ]] || return 1
  ahr_validate_transaction_id "$transaction_id" || return 1
  local txdir="$FRAMEWORK_TRANSACTIONS_DIR/$transaction_id"
  [[ -d "$txdir" && -f "$txdir/state" ]] || return 0
  local state_file="$txdir/state" action completion tx_backup state_backup_id state_transaction_id
  action="$(read_tx_field_unique "$txdir" "action" 2>/dev/null || true)"
  completion="$(read_tx_field_unique "$txdir" "completion" 2>/dev/null || true)"
  tx_backup="$(read_tx_field_unique "$txdir" "backup_dir" 2>/dev/null || true)"
  state_backup_id="$(read_tx_field_unique "$txdir" "backup_id" 2>/dev/null || true)"
  state_transaction_id="$(read_tx_field_unique "$txdir" "transaction_id" 2>/dev/null || true)"
  [[ "$action" == "apply" ]] || return 0
  case "$completion" in
    in_progress|committed|rolled_back|recovered|abandoned|resolved_by_rollback) return 0 ;;
    *) ;;
  esac
  [[ "$tx_backup" == "$backup_dir" ]] || { echo "Transaction backup path does not match manifest backup" >&2; return 1; }
  [[ "$state_backup_id" == "$(basename "$backup_dir")" ]] || { echo "Transaction backup_id does not match manifest backup" >&2; return 1; }
  [[ "$state_transaction_id" == "$transaction_id" ]] || { echo "Transaction ID does not match manifest transaction" >&2; return 1; }
  echo "$txdir"
}

# Return the one unresolved failed apply transaction, if any.  More than one
# is ambiguous by design: recovery must not choose by timestamp or directory
# order.  New-format transaction fields are validated before their backup is
# opened.
find_unresolved_apply_tx() {
  [[ -d "$FRAMEWORK_TRANSACTIONS_DIR" ]] || return 0
  local txdir action completion tx_backup state_backup_id state_transaction_id
  local found="" count=0
  for txdir in "$FRAMEWORK_TRANSACTIONS_DIR"/*/; do
    [[ -f "$txdir/state" ]] || continue
    action="$(read_tx_field_unique "$txdir" "action" 2>/dev/null || true)"
    [[ "$action" == "apply" ]] || continue
    completion="$(read_tx_field_unique "$txdir" "completion" 2>/dev/null || true)"
    case "$completion" in
      in_progress|committed|rolled_back|recovered|abandoned|resolved_by_rollback) continue ;;
      *) ;;
    esac
    tx_backup="$(read_tx_field_unique "$txdir" "backup_dir" 2>/dev/null || true)"
    state_backup_id="$(read_tx_field_unique "$txdir" "backup_id" 2>/dev/null || true)"
    state_transaction_id="$(read_tx_field_unique "$txdir" "transaction_id" 2>/dev/null || true)"
    [[ "$state_transaction_id" == "$(basename "${txdir%/}")" ]] || {
      echo "Failed apply transaction lacks valid transaction-association metadata" >&2
      return 1
    }
    ahr_validate_backup_id "$state_backup_id" || return 1
    [[ "$tx_backup" == "$FRAMEWORK_BACKUPS_DIR/$state_backup_id" ]] || {
      echo "Failed apply transaction backup_id does not match backup_dir" >&2
      return 1
    }
    found="${txdir%/}"
    count=$((count + 1))
  done
  (( count <= 1 )) || { echo "Multiple unresolved failed apply transactions; refusing ambiguous recovery" >&2; return 1; }
  [[ -z "$found" ]] || printf '%s\n' "$found"
}

check_incomplete_transactions() {
  local requested_action="${1:-apply}"
  [[ -d "$FRAMEWORK_TRANSACTIONS_DIR" ]] || return 0
  local txdir
  for txdir in "$FRAMEWORK_TRANSACTIONS_DIR"/*/; do
    [[ -d "$txdir" ]] || continue
    local state_file="$txdir/state"
    [[ -f "$state_file" ]] || continue

    local completion phase action
    completion="$(grep -F 'completion=' "$state_file" | head -n1 | cut -d= -f2-)"
    phase="$(grep -F 'phase=' "$state_file" | head -n1 | cut -d= -f2-)"
    action="$(grep -F 'action=' "$state_file" | head -n1 | cut -d= -f2-)"

    case "$completion" in
      committed|rolled_back|recovered|abandoned|resolved_by_rollback) continue ;;
      in_progress|migration_failed|health_check_failed|recovery_failed|failed|*) ;;
    esac
    # Explicit rollback is the supported resolution path for a failed apply.
    # It must not bypass an unresolved rollback transaction.
    if [[ "$requested_action" == "rollback" ]] && [[ "$action" == "apply" ]]; then
      continue
    fi
    echo "INCOMPLETE OR CORRUPT TRANSACTION FOUND:" >&2
    echo "  Transaction: $txdir" >&2
    echo "  Phase: $phase" >&2
    echo "  Action: $action" >&2
    echo "  Version: $(grep -F 'target_version=' "$state_file" | head -n1 | cut -d= -f2-)" >&2
    echo "  Commit: $(grep -F 'staging_commit=' "$state_file" | head -n1 | cut -d= -f2-)" >&2
    echo "  Target: $(grep -F 'current_target=' "$state_file" | head -n1 | cut -d= -f2-)" >&2
    echo "  Backup: $(grep -F 'backup_dir=' "$state_file" | head -n1 | cut -d= -f2-)" >&2
    echo "  Recovery: Run \`ahr update-framework --recover\` to complete or restore." >&2
    return 1
  done
  return 0
}

cmd_recover() {
  mkdir -p "$STATE_ROOT" "$FRAMEWORK_TRANSACTIONS_DIR"
  acquire_framework_lock

  log "Scanning for incomplete transactions..."

  local found_tx=""
  local txdir
  for txdir in "$FRAMEWORK_TRANSACTIONS_DIR"/*/; do
    [[ -d "$txdir" ]] || continue
    local state_file="$txdir/state"
    [[ -f "$state_file" ]] || continue
    local completion
    completion="$(grep -F 'completion=' "$state_file" | head -n1 | cut -d= -f2-)"
    case "$completion" in
      committed|rolled_back|recovered|abandoned) continue ;;
      *) found_tx="$txdir"; break ;;
    esac
  done

  if [[ -z "$found_tx" ]]; then
    log "No incomplete transactions found."
    return 0
  fi

  log "Recovering transaction: $found_tx"
  current_txdir="$found_tx"

  # Determine phase
  local phase
  phase="$(read_tx_field "$found_tx" "phase")"

  if [[ "$phase" == "activation_in_progress" ]]; then
    # Reverse-order restore from transaction archives
    log "Restoring from transaction archives..."
    rollback_transaction "$found_tx"
    finalize_transaction "$found_tx" "recovered" "recovered"
    log "Recovery complete. Framework restored to pre-update state."
    current_txdir=""
    return 0
  elif [[ "$phase" == "interrupted" ]]; then
    # The production INT/TERM/HUP handler has already restored the archives
    # before recording this terminal interrupted state. Replaying rollback
    # would see moved archives as absent and could remove restored targets.
    log "Interrupted transaction was already restored by signal handling."
    finalize_transaction "$found_tx" "recovered" "recovered"
    current_txdir=""
    return 0
  elif [[ "$phase" == "backup_in_progress" ]]; then
    # Backup was created but activation never started — just clean up
    log "Incomplete backup detected. No activation to reverse."
    finalize_transaction "$found_tx" "recovered" "recovered"
    current_txdir=""
    return 0
  elif [[ "$phase" == "namespace_failed" || "$phase" == "migration_failed" || "$phase" == "health_check_failed" ]]; then
    log "Transaction reached framework activation but failed in $phase."
    log "Recovery does not erase this failure. Run: ahr update-framework --rollback"
    current_txdir=""
    return 1
  else
    log "Transaction in phase '$phase'. Attempting recovery..."
    rollback_transaction "$found_tx"
    finalize_transaction "$found_tx" "recovered" "recovered"
    current_txdir=""
    return 0
  fi
}

# ── Main ───────────────────────────────────────────────────────────

case "$mode" in
  status)   cmd_status ;;
  check)    cmd_check ;;
  dry-run)  cmd_dry_run ;;
  apply)    cmd_apply ;;
  rollback) cmd_rollback ;;
  recover)  cmd_recover ;;
esac
