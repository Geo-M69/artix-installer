show_font_set_menu() {
  local font_cmd
  local -a fonts=()
  local -a menu_entries=()
  local current_family current_size choice choice_raw

  font_cmd="$(resolve_command_path ahr-font)" || ahr_fail "Command not found: ahr-font"

  # Get current font setting
  current_family="$("$font_cmd" current --raw 2>/dev/null | grep '^font_family' | sed 's/.*"\(.*\)"/\1/' || echo 'JetBrainsMono Nerd Font')"
  current_size="$("$font_cmd" current --raw 2>/dev/null | grep '^font_size' | sed 's/.*"\(.*\)"/\1/' || echo '10')"

  # Collect available fonts (limit to first 30 to keep menu manageable)
  mapfile -t fonts < <("$font_cmd" list --raw 2>/dev/null | head -30 | sed '/^[[:space:]]*$/d')

  if (( ${#fonts[@]} == 0 )); then
    ahr_fail "No fonts found via fc-list"
  fi

  # Build menu entries
  for line in "${fonts[@]}"; do
    if [[ "$line" == "$current_family" ]]; then
      menu_entries+=("✓ $line")
    else
      menu_entries+=("  $line")
    fi
  done

  menu_entries+=("")
  menu_entries+=("Change Font Size (current: $current_size)...")
  menu_entries+=("Back")

  choice="$(menu_select "Style: Font (${current_family})" "${menu_entries[@]}")"

  if [[ -z "$choice" || "$choice" == "Back" ]]; then
    return 0
  fi

  if [[ "$choice" == "Change Font Size (current: $current_size)..." ]]; then
    run_terminal_script "set -e; read -r -p 'Font size in points (current ${current_size}): ' size; [[ -n \"\$size\" ]] || exit 0; $(quote_command "$font_cmd") set --size \"\$size\"; echo; read -r -p 'Press Enter to close...' _"
    return 0
  fi

  # Strip marker prefix to get raw font name
  choice_raw="${choice#✓ }"
  choice_raw="${choice_raw#  }"

  exec "$font_cmd" set --family "$choice_raw"
}

run_command_capture() {
  local command_name="$1"
  shift || true
  local command_path

  if ! command_path="$(resolve_command_path "$command_name")"; then
    printf '%s\n' ""
    return 0
  fi

  "$command_path" "$@" 2>/dev/null || true
}

# Return the screen recording state display string.
screenrecording_state() {
  if pgrep -f '^gpu-screen-recorder' >/dev/null 2>&1; then
    printf '⏺ Screen Recording (active)'
  else
    printf '⏹ Screen Recording (stopped)'
  fi
}

# Return the current theme name for display in the style menu.
theme_current_label() {
  local theme_cmd
  theme_cmd="$(resolve_command_path ahr-theme 2>/dev/null)" || { printf '󰸌 Theme: (not installed)'; return 0; }
  local current
  current="$("$theme_cmd" current --raw 2>/dev/null | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g' || true)"
  if [[ -n "$current" ]]; then
    printf '󰸌 Theme: %s' "$current"
  else
    printf '󰸌 Theme: (none)'
  fi
}

show_capture_menu() {
  local choice

  while true; do
    choice="$(menu_select "Capture" \
      " Screenshot" \
      "󰧑 Area Screenshot" \
      "󰧑 Fullscreen Screenshot" \
      "󰧑 Window Screenshot" \
      "$(screenrecording_state)" \
      "󰘿 Clipboard History" \
      "󰃉 Color Picker" \
      "Back")"

    case "$choice" in
      *"Area"*)
        if menu_require grim grim && menu_require slurp slurp; then
          run_command_background ahr-capture-screenshot --area
        fi
        ;;
      *"Fullscreen"*)
        if menu_require grim grim; then
          run_command_background ahr-capture-screenshot --fullscreen
        fi
        ;;
      *"Window"*)
        if menu_require grim grim && menu_require jq jq && menu_require hyprctl hyprland; then
          run_command_background ahr-capture-screenshot --window
        fi
        ;;
      *" Screenshot"*|*"Screenshot"*)
        if menu_require grim grim; then
          run_command_background ahr-capture-screenshot
        fi
        ;;
      *"Screen Recording"*|*"Screenrecord"*)
        if menu_require gpu-screen-recorder gpu-screen-recorder; then
          run_command_background ahr-capture-screenrecording
        fi
        ;;
      *"Clipboard"*)
        if ahr_has_cmd cliphist; then
          run_command_background ahr-clipboard-picker
        else
          menu_require cliphist cliphist
        fi
        ;;
      *"Color"*)
        if menu_require hyprpicker hyprpicker && menu_require wl-copy wl-clipboard; then
          nohup hyprpicker -az >/dev/null 2>&1 &
          exit 0
        fi
        ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

show_toggle_menu() {
  local choice

  while true; do
    choice="$(menu_select "Toggle" \
      "$(nightlight_state)" \
      "$(idle_lock_state)" \
      "$(notification_state)" \
      "$(waybar_state)" \
      "$(waybar_position_state)" \
      "Back")"

    case "$choice" in
      *"Nightlight"*)
        run_command_now ahr-toggle-nightlight ;;
      *"Idle Lock"*)
        if ahr_has_cmd hypridle; then
          run_command_now ahr-toggle-idle
        else
          menu_require hypridle hypridle
        fi
        ;;
      *"Notifications"*)
        run_command_now ahr-toggle-notification-silencing ;;
      *"Waybar: Visible"*|*"Waybar: Hidden"*)
        run_command_now ahr-toggle-waybar ;;
      *"Waybar: Top"*|*"Waybar: Bottom"*)
        run_command_now ahr-toggle-waybar-position ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

