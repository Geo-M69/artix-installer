#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"
source "${AHR_TOGGLE_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-toggle-lib.sh}"

MENU_BACKEND=""

usage() {
  cat <<'EOF'
Usage: ahr-menu [slice]

Slices:
  main      Main menu (default)
  apps      Open application launcher directly
  learn     Learning and keybinding help
  trigger   Capture and toggle actions
  style     Theme and visual actions
  setup     Setup actions
  install   Install actions
  remove    Remove actions
  update    Update and migration actions
  system    Session and power actions
  about     Version, diagnostics, and documentation info
  help      Show this help
EOF
}

resolve_command_path() {
  local command_name="$1"

  if [[ -x "$SCRIPT_DIR/$command_name" ]]; then
    printf '%s\n' "$SCRIPT_DIR/$command_name"
    return 0
  fi

  if command -v "$command_name" >/dev/null 2>&1; then
    command -v "$command_name"
    return 0
  fi

  return 1
}

run_command_now() {
  local command_name="$1"
  shift || true
  local command_path

  command_path="$(resolve_command_path "$command_name")" || ahr_fail "Command not found: $command_name"
  exec "$command_path" "$@"
}

run_command_background() {
  local command_name="$1"
  shift || true
  local command_path

  command_path="$(resolve_command_path "$command_name")" || ahr_fail "Command not found: $command_name"
  nohup "$command_path" "$@" >/dev/null 2>&1 &
  exit 0
}

# Pre-check that a command is available before presenting or running a menu
# action.  If the command is missing, show a notification and return 1 so the
# caller can skip the action and stay in the menu.
# Usage: menu_require <command> [package_name]
menu_require() {
  local cmd="$1"
  local pkg="${2:-$1}"

  if ahr_has_cmd "$cmd"; then
    return 0
  fi

  cat >&2 <<EOF
ERROR: '$cmd' is required but not installed.
       Install with: sudo pacman -S $pkg
EOF
  ahr_notify "artix-hypr-remix" "'$cmd' is not installed — install with: sudo pacman -S $pkg"
  return 1
}

# ── State-aware toggle helpers ──────────────────────────────────
# These return a display string for toggle menu items showing live state.

# ── State-aware toggle helpers ──────────────────────────────────
# These return a display string for toggle menu items showing live state.

idle_lock_state() {
  if pgrep -x hypridle >/dev/null 2>&1; then
    printf '󱫖 Idle Lock: On'
  else
    printf '󱫗 Idle Lock: Off'
  fi
}

notification_state() {
  local silenced=false
  if ahr_toggle_enabled "notification-silencing"; then
    silenced=true
  elif ahr_has_cmd makoctl; then
    if makoctl mode 2>/dev/null | grep -q 'do-not-disturb'; then
      silenced=true
    fi
  fi
  if [[ "$silenced" == "true" ]]; then
    printf '󰂛 Notifications: Silenced'
  else
    printf '󰂚 Notifications: Enabled'
  fi
}

nightlight_state() {
  local nightlight=false
  if pgrep -x hyprsunset >/dev/null 2>&1; then
    if ahr_has_cmd hyprctl; then
      local temp
      temp="$(hyprctl hyprsunset temperature 2>/dev/null | grep -oE '[0-9]+' || true)"
      if [[ -n "$temp" && "$temp" -lt 6000 ]]; then
        nightlight=true
      fi
    fi
  fi
  if [[ "$nightlight" == "true" ]] || ahr_toggle_enabled "nightlight"; then
    printf ' Nightlight: On'
  else
    printf ' Nightlight: Off'
  fi
}

waybar_state() {
  if pgrep -x waybar >/dev/null 2>&1; then
    printf '󰍜 Waybar: Visible'
  else
    printf '󰍜 Waybar: Hidden'
  fi
}

waybar_position_state() {
  local waybar_config="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/config.jsonc"
  local state_file="$AHR_TOGGLE_STATE_DIR/waybar-position"

  if [[ -f "$waybar_config" ]] && grep -q '"position"[[:space:]]*:[[:space:]]*"bottom"' "$waybar_config" 2>/dev/null; then
    printf '󰁅 Waybar: Bottom'
  else
    printf '󰁝 Waybar: Top'
  fi
}

quote_command() {
  local output=""
  local arg

  for arg in "$@"; do
    output+="$(printf '%q' "$arg") "
  done

  printf '%s' "${output% }"
}

run_terminal_script() {
  local script_text="$1"

  if ahr_exec_terminal_app bash -lc "$script_text"; then
    exit 0
  fi

  ahr_fail "No terminal found for this action"
}

run_terminal_command() {
  local command_line
  command_line="$(quote_command "$@")"
  run_terminal_script "$command_line"
}

# If a Walker dmenu is already open, close it and exit (toggle behavior).
# This matches Omarchy's menu toggle behavior.
# Only toggles when Walker will actually be used as the menu backend —
# respects AHR_MENU_BACKEND overrides to non-Walker backends.
toggle_existing_menu() {
  # If backend is explicitly overridden to a non-Walker value, skip toggle
  if [[ -n "${AHR_MENU_BACKEND:-}" ]] && [[ "$AHR_MENU_BACKEND" != "walker" ]]; then
    return 0
  fi

  if pgrep -f "walker.*--dmenu" >/dev/null 2>&1; then
    if ahr_has_cmd walker; then
      walker --close >/dev/null 2>&1 || true
    fi
    exit 0
  fi
}

menu_backend() {
  if [[ -n "$MENU_BACKEND" ]]; then
    printf '%s\n' "$MENU_BACKEND"
    return 0
  fi

  if [[ -n "${AHR_MENU_BACKEND:-}" ]]; then
    case "$AHR_MENU_BACKEND" in
      walker|wofi|rofi|tty)
        MENU_BACKEND="$AHR_MENU_BACKEND"
        printf '%s\n' "$MENU_BACKEND"
        return 0
        ;;
    esac
  fi

  # Prefer Walker for Omarchy menu parity; fall back to wofi/rofi/tty.
  if ahr_has_cmd walker; then
    MENU_BACKEND="walker"
  elif ahr_has_cmd wofi; then
    MENU_BACKEND="wofi"
  elif ahr_has_cmd rofi; then
    MENU_BACKEND="rofi"
  elif [[ -t 0 && -t 1 ]]; then
    MENU_BACKEND="tty"
  else
    ahr_fail "No menu backend found (walker/wofi/rofi)"
  fi

  printf '%s\n' "$MENU_BACKEND"
}

menu_select_tty() {
  local prompt="$1"
  shift
  local -a options=("$@")
  local selection
  local index

  # Print UI to stderr so callers capturing stdout (choice="$(menu_select …)")
  # get only the selected value, not the menu rendering.
  printf '\n%s\n' "$prompt" >&2
  for index in "${!options[@]}"; do
    printf '  %d) %s\n' "$((index + 1))" "${options[$index]}" >&2
  done

  printf '> ' >&2
  read -r selection || true

  if [[ "$selection" =~ ^[0-9]+$ ]] && (( selection >= 1 && selection <= ${#options[@]} )); then
    printf '%s\n' "${options[$((selection - 1))]}"
    return 0
  fi

  printf '%s\n' ""
}

menu_select() {
  local prompt="$1"
  shift
  local -a options=("$@")

  case "$(menu_backend)" in
    walker)
      printf '%s\n' "${options[@]}" | walker --dmenu --width 295 --minheight 1 --maxheight 520 -p "${prompt}…" 2>/dev/null || true
      ;;
    wofi)
      printf '%s\n' "${options[@]}" | wofi --dmenu --prompt "${prompt}…" 2>/dev/null || true
      ;;
    rofi)
      printf '%s\n' "${options[@]}" | rofi -dmenu -p "${prompt}…" 2>/dev/null || true
      ;;
    tty)
      menu_select_tty "$prompt" "${options[@]}"
      ;;
    *)
      ahr_fail "No menu backend found (walker/wofi/rofi)"
      ;;
  esac
}

confirm_yes() {
  local prompt="$1"
  local answer

  answer="$(menu_select "$prompt" "No" "Yes")"
  [[ "$answer" == "Yes" ]]
}

open_application_launcher() {
  run_command_now ahr-launch-apps
}

open_markdown_doc() {
  local doc_file="$1"
  local description="$2"
  local missing_message

  if [[ -f "$doc_file" ]] && ahr_has_cmd xdg-open; then
    if xdg-open "$doc_file" >/dev/null 2>&1; then
      exit 0
    fi
  fi

  if [[ -f "$doc_file" ]]; then
    run_terminal_script "if command -v less >/dev/null 2>&1; then less $(printf '%q' "$doc_file"); else sed -n '1,260p' $(printf '%q' "$doc_file"); echo; read -r -p 'Press Enter to close...' _; fi"
  fi

  missing_message="$description not found: $doc_file"
  run_terminal_script "printf '%s\n' $(printf '%q' "$missing_message"); read -r -p 'Press Enter to close...' _"
}

show_getting_started() {
  local ahr_cmd
  local status_cmd
  local repair_cmd

  ahr_cmd="$(resolve_command_path ahr)" || ahr_fail "Command not found: ahr"
  status_cmd="$(resolve_command_path ahr-status)" || ahr_fail "Command not found: ahr-status"
  repair_cmd="$(resolve_command_path ahr-repair)" || ahr_fail "Command not found: ahr-repair"

  run_terminal_script "
cat <<'GUIDE'
╔══════════════════════════════════════════════════╗
║     Artix Hypr Remix — Getting Started           ║
╚══════════════════════════════════════════════════╝

ESSENTIAL KEYBINDINGS
  Super + Space          App launcher
  Super + Alt + Space    AHR Menu (command center)
  Super + Escape         System / Power menu
  Super + K              Keybinding reference
  Super + Return         Terminal
  Super + Shift + F      File manager
  Super + P              Clipboard history picker
  Print                  Screenshot picker (area/fullscreen/window)
  Super + Ctrl + Space   Switch wallpaper
  Super + Ctrl + Shift + Space   Style / Theme menu

MENU STRUCTURE
  Applications  App launcher
  Learn         Help, keybindings, docs, theme guides
  Trigger       Screenshots, screen recording, toggles
  Style         Themes, wallpaper, Waybar/Mako controls
  Setup         Audio, network, Bluetooth, defaults
  Install       Packages, Flatpak, Docker, Printing (OpenRC)
  Remove        Package, Flatpak, Docker, Printing (OpenRC)
  Update        System & framework updates, migrations
  About         Version, diagnostics, documentation links
  System        Lock, logout, suspend, reboot, power off

KEY COMMANDS
  ahr status              Show install state, logs, backups
  ahr repair --dry-run    Check for fixable issues (safe)
  ahr update --dry-run    Preview pending updates
  ahr theme list          List available themes
  ahr theme status        Show active theme and asset state

GETTING HELP
  Learn > Quick Reference     Installed quick-reference guide
  Learn > Keybindings         Full Hyprland keybinding list
  Learn > AHR Command Help    All ahr-* commands
  Learn > Theme Help          Theme engine usage
  ahr help                    CLI help for the ahr dispatcher
  ahr doctor                  Full health report
GUIDE
read -r -p 'Press Enter to close...' _
"
}

show_learn_menu() {
  local ahr_cmd
  local choice
  local framework_root
  local quick_reference_file
  local theme_asset_file
  local theme_cmd
  local update_cmd

  framework_root="$(cd "$SCRIPT_DIR/.." && pwd)"
  quick_reference_file="$framework_root/docs/quick-reference.md"
  theme_asset_file="$framework_root/docs/theme-assets.md"
  ahr_cmd="$(resolve_command_path ahr)" || ahr_fail "Command not found: ahr"
  theme_cmd="$(resolve_command_path ahr-theme)" || ahr_fail "Command not found: ahr-theme"
  update_cmd="$(resolve_command_path ahr-update)" || ahr_fail "Command not found: ahr-update"

  while true; do
    choice="$(menu_select "Learn" \
      "󰋖 Getting Started" \
      " Keybindings" \
      "󰈐 Quick Reference" \
      " AHR Command Help" \
      "󰸌 Theme Help" \
      " Update Help" \
      "󰈙 Theme Asset Guide" \
      "󰈙 Open README" \
      " Hyprland Reference" \
      "󰣇 Artix Reference" \
      "Back")"

    case "$choice" in
      *"Getting Started"*) show_getting_started ;;
      *Keybindings*) run_command_now ahr-menu-keybindings ;;
      *"Quick Reference"*) open_markdown_doc "$quick_reference_file" "Quick reference" ;;
      *"AHR Command"*) run_terminal_script "$(quote_command "$ahr_cmd" help); echo; read -r -p 'Press Enter to close...' _" ;;
      *"Theme Help"*) run_terminal_script "$(quote_command "$theme_cmd" help); echo; read -r -p 'Press Enter to close...' _" ;;
      *"Update Help"*) run_terminal_script "$(quote_command "$update_cmd" --help); echo; read -r -p 'Press Enter to close...' _" ;;
      *"Theme Asset"*) open_markdown_doc "$theme_asset_file" "Theme asset guide" ;;
      *README*)
        if ahr_has_cmd xdg-open; then
          xdg-open "https://github.com/Geo-M69/artix-installer" >/dev/null 2>&1 || true
          exit 0
        fi
        run_terminal_script "printf '%s\n' 'README: https://github.com/Geo-M69/artix-installer'; read -r -p 'Press Enter to close...' _"
        ;;
      *"Hyprland"*)
        if ahr_has_cmd xdg-open; then
          xdg-open "https://wiki.hypr.land/" >/dev/null 2>&1 || true
          exit 0
        fi
        run_terminal_script "printf '%s\n' 'Hyprland Wiki: https://wiki.hypr.land/'; read -r -p 'Press Enter to close...' _"
        ;;
      *"Artix"*)
        if ahr_has_cmd xdg-open; then
          xdg-open "https://wiki.artixlinux.org/" >/dev/null 2>&1 || true
          exit 0
        fi
        run_terminal_script "printf '%s\n' 'Artix Wiki: https://wiki.artixlinux.org/'; read -r -p 'Press Enter to close...' _"
        ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

show_default_browser_menu() {
  local current
  local choice

  current="$(run_command_capture ahr-default-browser)"
  choice="$(menu_select "Setup: Default Browser (current: ${current:-unknown})" \
    "Chromium" "Chrome" "Brave" "Brave Origin" "Edge" "Firefox" "Zen" "Back")"

  case "$choice" in
    Chromium) run_command_now ahr-default-browser chromium ;;
    Chrome) run_command_now ahr-default-browser chrome ;;
    Brave) run_command_now ahr-default-browser brave ;;
    "Brave Origin") run_command_now ahr-default-browser brave-origin ;;
    Edge) run_command_now ahr-default-browser edge ;;
    Firefox) run_command_now ahr-default-browser firefox ;;
    Zen) run_command_now ahr-default-browser zen ;;
    *) return 0 ;;
  esac
}

