#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

MENU_BACKEND=""

usage() {
  cat <<'EOF'
Usage: ahr-menu [slice]

Slices:
  main      Main menu (default)
  apps      Open application launcher directly
  learn     Learning and keybinding help
  trigger   Capture and toggle actions
  style     Theme and visual actions
  setup     Setup actions
  install   Install actions
  remove    Remove actions
  update    Update and migration actions
  system    Session and power actions
  help      Show this help
EOF
}

resolve_command_path() {
  local command_name="$1"

  if [[ -x "$SCRIPT_DIR/$command_name" ]]; then
    printf '%s\n' "$SCRIPT_DIR/$command_name"
    return 0
  fi

  if command -v "$command_name" >/dev/null 2>&1; then
    command -v "$command_name"
    return 0
  fi

  return 1
}

run_command_now() {
  local command_name="$1"
  shift || true
  local command_path

  command_path="$(resolve_command_path "$command_name")" || ahr_fail "Command not found: $command_name"
  exec "$command_path" "$@"
}

run_command_background() {
  local command_name="$1"
  shift || true
  local command_path

  command_path="$(resolve_command_path "$command_name")" || ahr_fail "Command not found: $command_name"
  nohup "$command_path" "$@" >/dev/null 2>&1 &
  exit 0
}

# Pre-check that a command is available before presenting or running a menu
# action.  If the command is missing, show a notification and return 1 so the
# caller can skip the action and stay in the menu.
# Usage: menu_require <command> [package_name]
menu_require() {
  local cmd="$1"
  local pkg="${2:-$1}"

  if ahr_has_cmd "$cmd"; then
    return 0
  fi

  cat >&2 <<EOF
ERROR: '$cmd' is required but not installed.
       Install with: sudo pacman -S $pkg
EOF
  ahr_notify "artix-hypr-remix" "'$cmd' is not installed — install with: sudo pacman -S $pkg"
  return 1
}

quote_command() {
  local output=""
  local arg

  for arg in "$@"; do
    output+="$(printf '%q' "$arg") "
  done

  printf '%s' "${output% }"
}

run_terminal_script() {
  local script_text="$1"

  if ahr_exec_terminal_app bash -lc "$script_text"; then
    exit 0
  fi

  ahr_fail "No terminal found for this action"
}

run_terminal_command() {
  local command_line
  command_line="$(quote_command "$@")"
  run_terminal_script "$command_line"
}

menu_backend() {
  if [[ -n "$MENU_BACKEND" ]]; then
    printf '%s\n' "$MENU_BACKEND"
    return 0
  fi

  if [[ -n "${AHR_MENU_BACKEND:-}" ]]; then
    case "$AHR_MENU_BACKEND" in
      walker|wofi|rofi|tty)
        MENU_BACKEND="$AHR_MENU_BACKEND"
        printf '%s\n' "$MENU_BACKEND"
        return 0
        ;;
    esac
  fi

  # Prefer core launcher tooling first; walker is optional in no-AUR installs.
  if ahr_has_cmd wofi; then
    MENU_BACKEND="wofi"
  elif ahr_has_cmd walker; then
    MENU_BACKEND="walker"
  elif ahr_has_cmd rofi; then
    MENU_BACKEND="rofi"
  elif [[ -t 0 && -t 1 ]]; then
    MENU_BACKEND="tty"
  else
    ahr_fail "No menu backend found (walker/wofi/rofi)"
  fi

  printf '%s\n' "$MENU_BACKEND"
}

menu_select_tty() {
  local prompt="$1"
  shift
  local -a options=("$@")
  local selection
  local index

  printf '\n%s\n' "$prompt"
  for index in "${!options[@]}"; do
    printf '  %d) %s\n' "$((index + 1))" "${options[$index]}"
  done

  printf '> '
  read -r selection || true

  if [[ "$selection" =~ ^[0-9]+$ ]] && (( selection >= 1 && selection <= ${#options[@]} )); then
    printf '%s\n' "${options[$((selection - 1))]}"
    return 0
  fi

  printf '%s\n' ""
}

menu_select() {
  local prompt="$1"
  shift
  local -a options=("$@")

  case "$(menu_backend)" in
    walker)
      printf '%s\n' "${options[@]}" | walker --dmenu -p "$prompt" 2>/dev/null || true
      ;;
    wofi)
      printf '%s\n' "${options[@]}" | wofi --dmenu --prompt "$prompt" 2>/dev/null || true
      ;;
    rofi)
      printf '%s\n' "${options[@]}" | rofi -dmenu -p "$prompt" 2>/dev/null || true
      ;;
    tty)
      menu_select_tty "$prompt" "${options[@]}"
      ;;
    *)
      ahr_fail "No menu backend found (walker/wofi/rofi)"
      ;;
  esac
}

confirm_yes() {
  local prompt="$1"
  local answer

  answer="$(menu_select "$prompt" "No" "Yes")"
  [[ "$answer" == "Yes" ]]
}

open_application_launcher() {
  run_command_now ahr-launch-apps
}

open_markdown_doc() {
  local doc_file="$1"
  local description="$2"
  local missing_message

  if [[ -f "$doc_file" ]] && ahr_has_cmd xdg-open; then
    if xdg-open "$doc_file" >/dev/null 2>&1; then
      exit 0
    fi
  fi

  if [[ -f "$doc_file" ]]; then
    run_terminal_script "if command -v less >/dev/null 2>&1; then less $(printf '%q' "$doc_file"); else sed -n '1,260p' $(printf '%q' "$doc_file"); echo; read -r -p 'Press Enter to close...' _; fi"
  fi

  missing_message="$description not found: $doc_file"
  run_terminal_script "printf '%s\n' $(printf '%q' "$missing_message"); read -r -p 'Press Enter to close...' _"
}

show_getting_started() {
  local ahr_cmd
  local status_cmd
  local repair_cmd

  ahr_cmd="$(resolve_command_path ahr)" || ahr_fail "Command not found: ahr"
  status_cmd="$(resolve_command_path ahr-status)" || ahr_fail "Command not found: ahr-status"
  repair_cmd="$(resolve_command_path ahr-repair)" || ahr_fail "Command not found: ahr-repair"

  run_terminal_script "
cat <<'GUIDE'
╔══════════════════════════════════════════════════╗
║     Artix Hypr Remix — Getting Started           ║
╚══════════════════════════════════════════════════╝

ESSENTIAL KEYBINDINGS
  Super + Space      Main menu (this menu system)
  Super + K          Keybinding reference
  Super + Return     Terminal
  Super + Shift + F  File manager
  Super + P          Clipboard history picker
  Print              Screenshot picker (area/fullscreen/window)

MENU STRUCTURE
  Applications  App launcher
  Learn         Help, keybindings, docs, theme guides
  Trigger       Screenshots, screen recording, toggles
  Style         Themes, wallpaper, Waybar/Mako controls
  Setup         Audio, network, Bluetooth, defaults
  Install       Packages, Flatpak, Docker, Printing
  Remove        Package, Flatpak, Docker, Printing
  Update        System & framework updates, migrations
  System        Lock, logout, suspend, reboot, power off

KEY COMMANDS
  ahr status              Show install state, logs, backups
  ahr repair --dry-run    Check for fixable issues (safe)
  ahr update --dry-run    Preview pending updates
  ahr theme list          List available themes
  ahr theme status        Show active theme and asset state

GETTING HELP
  Learn > Quick Reference     Installed quick-reference guide
  Learn > Keybindings         Full Hyprland keybinding list
  Learn > AHR Command Help    All ahr-* commands
  Learn > Theme Help          Theme engine usage
  ahr help                    CLI help for the ahr dispatcher
  ahr doctor                Full health report
GUIDE
read -r -p 'Press Enter to close...' _
"
}

show_learn_menu() {
  local ahr_cmd
  local choice
  local framework_root
  local quick_reference_file
  local theme_asset_file
  local theme_cmd
  local update_cmd

  framework_root="$(cd "$SCRIPT_DIR/.." && pwd)"
  quick_reference_file="$framework_root/docs/quick-reference.md"
  theme_asset_file="$framework_root/docs/theme-assets.md"
  ahr_cmd="$(resolve_command_path ahr)" || ahr_fail "Command not found: ahr"
  theme_cmd="$(resolve_command_path ahr-theme)" || ahr_fail "Command not found: ahr-theme"
  update_cmd="$(resolve_command_path ahr-update)" || ahr_fail "Command not found: ahr-update"

  while true; do
    choice="$(menu_select "Learn" \
      "Getting Started" \
      "Keybindings" \
      "Quick Reference" \
      "Theme Asset Guide" \
      "AHR Command Help" \
      "Theme Help" \
      "Update Help" \
      "Open README" \
      "Back")"

    case "$choice" in
      "Getting Started") show_getting_started ;;
      "Keybindings") run_command_now ahr-menu-keybindings ;;
      "Quick Reference") open_markdown_doc "$quick_reference_file" "Quick reference" ;;
      "Theme Asset Guide") open_markdown_doc "$theme_asset_file" "Theme asset guide" ;;
      "AHR Command Help") run_terminal_script "$(quote_command "$ahr_cmd" help); echo; read -r -p 'Press Enter to close...' _" ;;
      "Theme Help") run_terminal_script "$(quote_command "$theme_cmd" help); echo; read -r -p 'Press Enter to close...' _" ;;
      "Update Help") run_terminal_script "$(quote_command "$update_cmd" --help); echo; read -r -p 'Press Enter to close...' _" ;;
      "Open README")
        if ahr_has_cmd xdg-open; then
          xdg-open "https://github.com/geofedora/artix-installer" >/dev/null 2>&1 || true
          exit 0
        fi
        run_terminal_script "printf '%s\n' 'README: https://github.com/geofedora/artix-installer'; read -r -p 'Press Enter to close...' _"
        ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

show_default_browser_menu() {
  local current
  local choice

  current="$(run_command_capture ahr-default-browser)"
  choice="$(menu_select "Setup: Default Browser (current: ${current:-unknown})" \
    "Chromium" "Chrome" "Brave" "Brave Origin" "Edge" "Firefox" "Zen" "Back")"

  case "$choice" in
    Chromium) run_command_now ahr-default-browser chromium ;;
    Chrome) run_command_now ahr-default-browser chrome ;;
    Brave) run_command_now ahr-default-browser brave ;;
    "Brave Origin") run_command_now ahr-default-browser brave-origin ;;
    Edge) run_command_now ahr-default-browser edge ;;
    Firefox) run_command_now ahr-default-browser firefox ;;
    Zen) run_command_now ahr-default-browser zen ;;
    *) return 0 ;;
  esac
}

show_default_terminal_menu() {
  local current
  local choice

  current="$(run_command_capture ahr-default-terminal)"
  choice="$(menu_select "Setup: Default Terminal (current: ${current:-unknown})" \
    "Alacritty" "Foot" "Ghostty" "Kitty" "Back")"

  case "$choice" in
    Alacritty) run_command_now ahr-default-terminal alacritty ;;
    Foot) run_command_now ahr-default-terminal foot ;;
    Ghostty) run_command_now ahr-default-terminal ghostty ;;
    Kitty) run_command_now ahr-default-terminal kitty ;;
    *) return 0 ;;
  esac
}

show_default_editor_menu() {
  local current
  local choice

  current="$(run_command_capture ahr-default-editor)"
  choice="$(menu_select "Setup: Default Editor (current: ${current:-unknown})" \
    "Helix" "Neovim" "Vim" "Back")"

  case "$choice" in
    Helix) run_command_now ahr-default-editor helix ;;
    Neovim) run_command_now ahr-default-editor neovim ;;
    Vim) run_command_now ahr-default-editor vim ;;
    *) return 0 ;;
  esac
}

show_theme_set_menu() {
  local theme_cmd
  local -a themes=()
  local choice

  theme_cmd="$(resolve_command_path ahr-theme)" || ahr_fail "Command not found: ahr-theme"
  mapfile -t themes < <("$theme_cmd" list --raw 2>/dev/null | sed '/^[[:space:]]*$/d')

  if (( ${#themes[@]} == 0 )); then
    ahr_fail "No themes found"
  fi

  themes+=("Back")
  choice="$(menu_select "Style: Theme" "${themes[@]}")"

  if [[ -z "$choice" || "$choice" == "Back" ]]; then
    return 0
  fi

  exec "$theme_cmd" set "$choice"
}

show_theme_status() {
  local theme_cmd

  theme_cmd="$(resolve_command_path ahr-theme)" || ahr_fail "Command not found: ahr-theme"
  run_terminal_script "set +e; $(quote_command "$theme_cmd" status); status=\$?; echo; if [[ \$status -ne 0 ]]; then echo 'Theme state has issues. Try Style > Theme Set or run ahr theme refresh.'; echo; fi; echo; printf '%s\n' 'Available themes:'; $(quote_command "$theme_cmd" list); echo; read -r -p 'Press Enter to close...' _"
}

show_theme_background_set() {
  local theme_cmd

  theme_cmd="$(resolve_command_path ahr-theme)" || ahr_fail "Command not found: ahr-theme"
  run_terminal_script "set -e; read -r -p 'Background image path: ' image_path; [[ -n \"\$image_path\" ]] || exit 0; $(quote_command "$theme_cmd") bg-set \"\$image_path\"; echo; read -r -p 'Press Enter to close...' _"
}

run_command_capture() {
  local command_name="$1"
  shift || true
  local command_path

  if ! command_path="$(resolve_command_path "$command_name")"; then
    printf '%s\n' ""
    return 0
  fi

  "$command_path" "$@" 2>/dev/null || true
}

show_capture_menu() {
  local choice

  while true; do
    choice="$(menu_select "Capture" \
      "Area Screenshot" \
      "Fullscreen Screenshot" \
      "Window Screenshot" \
      "Toggle Screen Recording" \
      "Clipboard History" \
      "Color Picker" \
      "Back")"

    case "$choice" in
      "Area Screenshot")
        if menu_require grim grim && menu_require slurp slurp; then
          run_command_background ahr-capture-screenshot --area
        fi
        ;;
      "Fullscreen Screenshot")
        if menu_require grim grim; then
          run_command_background ahr-capture-screenshot --fullscreen
        fi
        ;;
      "Window Screenshot")
        if menu_require grim grim && menu_require jq jq && menu_require hyprctl hyprland; then
          run_command_background ahr-capture-screenshot --window
        fi
        ;;
      "Toggle Screen Recording")
        if menu_require gpu-screen-recorder gpu-screen-recorder; then
          run_command_background ahr-capture-screenrecording
        fi
        ;;
      "Clipboard History")
        if ahr_has_cmd cliphist; then
          run_command_background ahr-clipboard-picker
        else
          menu_require cliphist cliphist
        fi
        ;;
      "Color Picker")
        if menu_require hyprpicker hyprpicker && menu_require wl-copy wl-clipboard; then
          nohup hyprpicker -az >/dev/null 2>&1 &
          exit 0
        fi
        ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

show_toggle_menu() {
  local choice

  while true; do
    choice="$(menu_select "Toggle" \
      "Idle Lock" \
      "Notifications" \
      "Waybar" \
      "Nightlight" \
      "Back")"

    case "$choice" in
      "Idle Lock")
        if ahr_has_cmd hypridle; then
          run_command_now ahr-toggle-idle
        else
          menu_require hypridle hypridle
        fi
        ;;
      "Notifications") run_command_now ahr-toggle-notification-silencing ;;
      "Waybar") run_command_now ahr-toggle-waybar ;;
      "Nightlight") run_command_now ahr-toggle-nightlight ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

show_trigger_menu() {
  local choice

  while true; do
    choice="$(menu_select "Trigger" \
      "Capture" \
      "Toggle" \
      "Back")"

    case "$choice" in
      "Capture") show_capture_menu ;;
      "Toggle") show_toggle_menu ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

show_style_menu() {
  local choice

  while true; do
    choice="$(menu_select "Style" \
      "Theme Status" \
      "Theme Set" \
      "Theme Next Background" \
      "Theme Set Background Path" \
      "Theme Refresh" \
      "Toggle Waybar" \
      "Restart Waybar" \
      "Restart Mako" \
      "Back")"

    case "$choice" in
      "Theme Status") show_theme_status ;;
      "Theme Set") show_theme_set_menu ;;
      "Theme Next Background") run_command_now ahr-theme bg-next ;;
      "Theme Set Background Path") show_theme_background_set ;;
      "Theme Refresh") run_command_now ahr-theme refresh ;;
      "Toggle Waybar") run_command_now ahr-toggle-waybar ;;
      "Restart Waybar") run_command_now ahr-restart-waybar ;;
      "Restart Mako") run_command_now ahr-restart-mako ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

show_setup_menu() {
  local choice

  while true; do
    choice="$(menu_select "Setup" \
      "Audio Control" \
      "Network Control" \
      "Bluetooth Control" \
      "Default Browser" \
      "Default Terminal" \
      "Default Editor" \
      "Edit Hyprland Config" \
      "Edit Hypridle Config" \
      "Edit Hyprlock Config" \
      "Edit Waybar Config" \
      "Edit Mako Config" \
      "Edit Walker Config" \
      "Edit AHR Config" \
      "Restart Walker" \
      "Back")"

    case "$choice" in
      "Audio Control")
        if ahr_has_cmd pavucontrol || ahr_has_cmd pwvucontrol || ahr_has_cmd alsamixer; then
          run_command_background ahr-launch-audio
        else
          menu_require pavucontrol pavucontrol
        fi
        ;;
      "Network Control")
        if ahr_has_cmd nm-connection-editor || ahr_has_cmd nmtui || ahr_has_cmd nmcli; then
          run_command_background ahr-launch-wifi
        else
          menu_require nm-connection-editor network-manager-applet
        fi
        ;;
      "Bluetooth Control")
        if ahr_has_cmd blueman-manager || ahr_has_cmd bluetui || ahr_has_cmd bluetoothctl; then
          run_command_background ahr-launch-bluetooth
        else
          menu_require blueman-manager blueman
        fi
        ;;
      "Default Browser") show_default_browser_menu ;;
      "Default Terminal") show_default_terminal_menu ;;
      "Default Editor") show_default_editor_menu ;;
      "Edit Hyprland Config")
        run_command_background ahr-edit-config "$HOME/.config/hypr/hyprland.conf"
        ;;
      "Edit Hypridle Config")
        run_command_background ahr-edit-config "$HOME/.config/hypr/hypridle.conf"
        ;;
      "Edit Hyprlock Config")
        run_command_background ahr-edit-config "$HOME/.config/hypr/hyprlock.conf"
        ;;
      "Edit Waybar Config")
        run_command_background ahr-edit-config "$HOME/.config/waybar/config.jsonc"
        ;;
      "Edit Mako Config")
        run_command_background ahr-edit-config "$HOME/.config/mako/config"
        ;;
      "Edit Walker Config")
        run_command_background ahr-edit-config "$HOME/.config/walker/config.toml"
        ;;
      "Edit AHR Config")
        run_command_background ahr-edit-config "$HOME/.config/artix-hypr-remix/config"
        ;;
      "Restart Walker") run_command_now ahr-restart-walker ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

show_install_menu() {
  local choice

  while true; do
    choice="$(menu_select "Install" \
      "Pacman Package(s)" \
      "AUR Package(s)" \
      "Flatpak App" \
      "Docker Stack (OpenRC)" \
      "Printing Stack (OpenRC)" \
      "Back")"

    case "$choice" in
      "Pacman Package(s)")
        run_terminal_script "set -e; echo 'This installs repo packages with sudo pacman -S --needed.'; echo 'Only enter package names you trust.'; echo; read -r -p 'Packages to install via pacman (space-separated): ' packages; [[ -n \"\$packages\" ]] || exit 0; sudo pacman -S --needed \$packages"
        ;;
      "AUR Package(s)")
        run_terminal_script "set -e; echo 'This installs AUR packages with paru or yay.'; echo 'Review PKGBUILDs when prompted by your helper.'; echo; read -r -p 'Packages to install via AUR helper (space-separated): ' packages; [[ -n \"\$packages\" ]] || exit 0; if command -v paru >/dev/null 2>&1; then paru -S --needed \$packages; elif command -v yay >/dev/null 2>&1; then yay -S --needed \$packages; else echo 'No AUR helper found (paru/yay).'; exit 1; fi"
        ;;
      "Flatpak App")
        run_terminal_script "set -e; echo 'This installs a Flatpak app from Flathub.'; echo; if ! command -v flatpak >/dev/null 2>&1; then echo 'flatpak is not installed.'; exit 1; fi; read -r -p 'Flatpak application id (for flathub): ' app_id; [[ -n \"\$app_id\" ]] || exit 0; flatpak install flathub \"\$app_id\""
        ;;
      "Docker Stack (OpenRC)")
        if ! confirm_yes "Install Docker packages and enable/start OpenRC docker?"; then
          continue
        fi
        run_terminal_script "set -e; echo 'This installs docker + docker-openrc, adds docker to the default OpenRC runlevel, and starts it now.'; echo; sudo pacman -S --needed docker docker-openrc; sudo rc-update add docker default; sudo rc-service docker start"
        ;;
      "Printing Stack (OpenRC)")
        if ! confirm_yes "Install CUPS/Avahi packages and enable/start printing services?"; then
          continue
        fi
        run_terminal_script "set -e; echo 'This installs CUPS/Avahi OpenRC packages, enables cupsd and avahi-daemon, and starts them now.'; echo; sudo pacman -S --needed cups avahi cups-openrc avahi-openrc; sudo rc-update add cupsd default; sudo rc-update add avahi-daemon default; sudo rc-service cupsd start; sudo rc-service avahi-daemon start"
        ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

show_remove_menu() {
  local choice

  while true; do
    choice="$(menu_select "Remove" \
      "Pacman Package(s)" \
      "Flatpak App" \
      "Docker Stack (OpenRC)" \
      "Printing Stack (OpenRC)" \
      "Back")"

    case "$choice" in
      "Pacman Package(s)")
        run_terminal_script "set -e; echo 'This removes repo packages with sudo pacman -Rns, including unneeded dependencies.'; echo 'Review the pacman transaction carefully before confirming.'; echo; read -r -p 'Packages to remove via pacman (space-separated): ' packages; [[ -n \"\$packages\" ]] || exit 0; sudo pacman -Rns \$packages"
        ;;
      "Flatpak App")
        run_terminal_script "set -e; echo 'This removes one installed Flatpak app.'; echo; if ! command -v flatpak >/dev/null 2>&1; then echo 'flatpak is not installed.'; exit 1; fi; read -r -p 'Flatpak application id to remove: ' app_id; [[ -n \"\$app_id\" ]] || exit 0; flatpak uninstall \"\$app_id\""
        ;;
      "Docker Stack (OpenRC)")
        if ! confirm_yes "Stop/disable Docker OpenRC service and remove Docker packages?"; then
          continue
        fi
        run_terminal_script "set -e; echo 'This stops Docker if running, removes it from the default OpenRC runlevel, and removes docker packages if installed.'; echo; sudo rc-service docker stop >/dev/null 2>&1 || true; sudo rc-update del docker default >/dev/null 2>&1 || true; remove_pkgs=(); for pkg in docker docker-openrc; do pacman -Q \"\$pkg\" >/dev/null 2>&1 && remove_pkgs+=(\"\$pkg\"); done; if (( \${#remove_pkgs[@]} > 0 )); then sudo pacman -Rns \"\${remove_pkgs[@]}\"; else echo 'Docker packages are not installed.'; fi"
        ;;
      "Printing Stack (OpenRC)")
        if ! confirm_yes "Stop/disable printing services and remove CUPS/Avahi packages?"; then
          continue
        fi
        run_terminal_script "set -e; echo 'This stops cupsd/avahi-daemon if running, removes them from the default OpenRC runlevel, and removes printing packages if installed.'; echo; sudo rc-service cupsd stop >/dev/null 2>&1 || true; sudo rc-service avahi-daemon stop >/dev/null 2>&1 || true; sudo rc-update del cupsd default >/dev/null 2>&1 || true; sudo rc-update del avahi-daemon default >/dev/null 2>&1 || true; remove_pkgs=(); for pkg in cups avahi cups-openrc avahi-openrc; do pacman -Q \"\$pkg\" >/dev/null 2>&1 && remove_pkgs+=(\"\$pkg\"); done; if (( \${#remove_pkgs[@]} > 0 )); then sudo pacman -Rns \"\${remove_pkgs[@]}\"; else echo 'Printing stack packages are not installed.'; fi"
        ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

show_update_menu() {
  local choice
  local update_cmd
  local available_cmd
  local migrate_cmd

  update_cmd="$(resolve_command_path ahr-update)" || ahr_fail "Command not found: ahr-update"
  available_cmd="$(resolve_command_path ahr-update-available)" || ahr_fail "Command not found: ahr-update-available"
  migrate_cmd="$(resolve_command_path ahr-migrate)" || ahr_fail "Command not found: ahr-migrate"

  while true; do
    choice="$(menu_select "Update" \
      "Run Full Update" \
      "Run Update + Flatpak" \
      "Run Migrations Only" \
      "Check Update Availability" \
      "Migration Status" \
      "Retry Skipped Migrations" \
      "Back")"

    case "$choice" in
      "Run Full Update")
        if confirm_yes "Run system/AUR update plus framework migrations?"; then
          run_terminal_script "printf '%s\n\n' 'This runs ahr-update: system package update, AUR update when configured, migrations, and post-update hooks.'; $(quote_command "$update_cmd")"
        fi
        ;;
      "Run Update + Flatpak")
        if confirm_yes "Run system/AUR update, Flatpak update, and migrations?"; then
          run_terminal_script "printf '%s\n\n' 'This runs ahr-update --flatpak: system/AUR updates, Flatpak updates, migrations, and post-update hooks.'; $(quote_command "$update_cmd" --flatpak)"
        fi
        ;;
      "Run Migrations Only")
        if confirm_yes "Run pending AHR framework migrations only?"; then
          run_terminal_script "printf '%s\n\n' 'This runs ahr-update --migrations-only. It does not update packages.'; $(quote_command "$update_cmd" --migrations-only)"
        fi
        ;;
      "Check Update Availability")
        run_terminal_script "set +e; $(quote_command "$available_cmd"); status=\$?; echo; if [[ \$status -eq 0 ]]; then echo 'Use Update > Run Full Update for package + migration work, or Update > Run Update + Flatpak to include Flatpak apps.'; elif [[ \$status -eq 1 ]]; then echo 'Nothing to do right now.'; else echo \"Update availability check failed with exit code: \$status\"; fi; read -r -p 'Press Enter to close...' _"
        ;;
      "Migration Status")
        run_terminal_script "set -e; $(quote_command "$migrate_cmd" --status); read -r -p 'Press Enter to close...' _"
        ;;
      "Retry Skipped Migrations") run_terminal_command "$migrate_cmd" --retry-skipped ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

show_system_menu() {
  local choice

  while true; do
    choice="$(menu_select "System" \
      "Lock Screen" \
      "Logout Hyprland" \
      "Suspend" \
      "Hibernate" \
      "Reboot" \
      "Power Off" \
      "Open Terminal" \
      "Open App Launcher" \
      "Capture Screenshot" \
      "Toggle Screen Recording" \
      "Back")"

    case "$choice" in
      "Lock Screen")
        if ahr_has_cmd hyprlock || ahr_has_cmd swaylock; then
          run_command_background ahr-system-lock
        else
          menu_require hyprlock hyprlock
        fi
        ;;
      "Logout Hyprland")
        if ahr_has_cmd hyprctl; then
          nohup hyprctl dispatch exit >/dev/null 2>&1 &
          exit 0
        fi
        cat >&2 <<EOF
ERROR: hyprctl is not available.
       Is Hyprland running?
EOF
        ahr_notify "artix-hypr-remix" "hyprctl is not available — is Hyprland running?"
        # Fall through — let the menu loop continue.
        ;;
      "Suspend")
        if confirm_yes "Suspend to RAM now?"; then
          run_command_now ahr-system-suspend
        fi
        ;;
      "Hibernate")
        if confirm_yes "Hibernate to disk now? This suspends the system and powers off."; then
          run_command_now ahr-system-hibernate
        fi
        ;;
      "Reboot")
        if confirm_yes "Reboot now? This ends all current sessions."; then
          run_command_now ahr-system-reboot
        fi
        ;;
      "Power Off")
        if confirm_yes "Power off now? This ends all current sessions."; then
          run_terminal_script "printf '%s\n\n' 'Powering off through sudo poweroff.'; sudo poweroff"
        fi
        ;;
      "Open Terminal") run_command_background ahr-launch-terminal ;;
      "Open App Launcher") open_application_launcher ;;
      "Capture Screenshot")
        if menu_require grim grim && menu_require slurp slurp; then
          run_command_background ahr-capture-screenshot
        fi
        ;;
      "Toggle Screen Recording")
        if menu_require gpu-screen-recorder gpu-screen-recorder; then
          run_command_background ahr-capture-screenrecording
        fi
        ;;
      "Back"|"") return 0 ;;
      *) return 0 ;;
    esac
  done
}

show_main_menu() {
  local choice

  while true; do
    choice="$(menu_select "AHR Menu" \
      "Applications" \
      "Learn" \
      "Trigger" \
      "Style" \
      "Setup" \
      "Install" \
      "Remove" \
      "Update" \
      "System" \
      "About" \
      "Cancel")"

    case "$choice" in
      "Applications") open_application_launcher ;;
      "Learn") show_learn_menu ;;
      "Trigger") show_trigger_menu ;;
      "Style") show_style_menu ;;
      "Setup") show_setup_menu ;;
      "Install") show_install_menu ;;
      "Remove") show_remove_menu ;;
      "Update") show_update_menu ;;
      "System") show_system_menu ;;
      "About") show_about_menu ;;
      "Cancel"|"") exit 0 ;;
      *) exit 0 ;;
    esac
  done
}

show_about_menu() {
  local version_file="${AHR_CONFIG_DIR:-$HOME/.config/artix-hypr-remix}/VERSION"
  local version=""

  if [[ -f "$version_file" ]]; then
    version="$(head -1 "$version_file")"
  fi

  local title="Artix Hypr Remix"
  if [[ -n "$version" ]]; then
    title="$title ($version)"
  fi

  # Use printf %q to shell-quote the dynamic title, preventing injection
  # when the version string contains apostrophes or other shell metacharacters.
  local quoted_title
  quoted_title="$(printf '%q' "$title")"

  run_terminal_script "printf '%s\n\n%s\n\n%s\n%s\n%s\n\n%s\n%s\n%s\n%s\n\n%s\n%s\n\n%s\n' \
    $quoted_title \
    'An opinionated Artix Linux installer focused on Hyprland and OpenRC.' \
    'Project target:' \
    '  OpenRC-native Omarchy-equivalent Hyprland desktop' \
    '  with a safe, repeatable installer and polished first-login experience.' \
    'Base system: Artix Linux with OpenRC' \
    'Shell: bash (zsh optional)' \
    'Startup: tty (greetd optional)' \
    'Command: ahr <command> or ahr-menu' \
    'Log: /var/log/artix-hypr-remix-install.log' \
    'Docs: ~/.config/artix-hypr-remix/docs/' \
    'Licensed under MIT'; read -r -p 'Press Enter to close...' _"
}

dispatch() {
  local slice="${1:-main}"

  case "$slice" in
    main) show_main_menu ;;
    apps) open_application_launcher ;;
    learn) show_learn_menu ;;
    trigger) show_trigger_menu ;;
    style) show_style_menu ;;
    setup) show_setup_menu ;;
    install) show_install_menu ;;
    remove) show_remove_menu ;;
    update) show_update_menu ;;
    system) show_system_menu ;;
    help|-h|--help) usage ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

dispatch "${1:-main}"
