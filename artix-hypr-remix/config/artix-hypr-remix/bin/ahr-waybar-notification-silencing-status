#!/usr/bin/env bash
# Report notification silencing state for the Waybar indicator.
# Uses the shared toggle framework.
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"
source "${AHR_TOGGLE_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-toggle-lib.sh}"

silenced=false
if ahr_toggle_enabled "notification-silencing"; then
  silenced=true
elif ahr_has_cmd makoctl; then
  if makoctl mode 2>/dev/null | grep -q 'do-not-disturb'; then
    silenced=true
  fi
fi

if [[ "$silenced" == "true" ]]; then
  printf '{"text":"󰂛","class":"active","tooltip":"Notifications silenced"}\n'
else
  printf '{"text":"󰂚","class":"inactive","tooltip":"Notifications enabled"}\n'
fi
