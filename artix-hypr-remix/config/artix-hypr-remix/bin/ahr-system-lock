#!/usr/bin/env bash
set -euo pipefail

source "${AHR_LIB_PATH:-$HOME/.config/artix-hypr-remix/bin/ahr-lib.sh}"

if ahr_has_cmd hyprlock; then
  exec hyprlock
fi

if ahr_has_cmd swaylock; then
  exec swaylock
fi

echo "No screen locker found." >&2
echo "Install hyprlock (sudo pacman -S hyprlock) or swaylock." >&2
ahr_notify "artix-hypr-remix" "No screen locker found — install hyprlock"
exit 1
